    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "GPU temperatures: Intel Arc xe (Plex transcoding on pve-nas-01), nouveau (legacy NVIDIA), amdgpu/radeon if added.",
      "fieldConfig": {
