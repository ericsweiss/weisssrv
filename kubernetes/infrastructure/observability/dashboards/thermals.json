      "type": "timeseries",
      "targets": [
        {
          "expr": "node_hwmon_temp_celsius{job=\"node-exporter-host\", instance=~\"$host\"} * on (instance, chip) group_left(chip_name) node_hwmon_chip_names{chip_name=~\"xe|nouveau|nvidia|amdgpu|radeon\"}",
          "legendFormat": "{{ instance }} {{ chip_name }} {{ sensor }}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "NIC temperature where the driver exposes it. Currently only pve-nas-01 (AQC113) reports a nic chip.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
