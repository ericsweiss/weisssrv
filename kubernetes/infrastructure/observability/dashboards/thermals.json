  "schemaVersion": 39,
  "tags": ["infrastructure", "thermals", "hardware"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(node_hwmon_temp_celsius{job=\"node-exporter-host\"}, instance)",
        "includeAll": true,
        "multi": false,
        "name": "host",
        "query": { "qryType": 1, "query": "label_values(node_hwmon_temp_celsius{job=\"node-exporter-host\"}, instance)" },
        "refresh": 2,
        "regex": "",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Thermals",
