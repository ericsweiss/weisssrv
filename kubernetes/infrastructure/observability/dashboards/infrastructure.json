        {
          "expr": "max by (id) (pve_memory_usage_bytes{id=~\"node/.*\"}) / max by (id) (pve_memory_size_bytes{id=~\"node/.*\"})",
          "format": "table",
          "instant": true,
          "refId": "mem"
        },
        {
          "expr": "max by (id) (pve_uptime_seconds{id=~\"node/.*\"})",
          "format": "table",
          "instant": true,
          "refId": "uptime"
        }
