      "title": "Stale Sensors (>6h)",
      "description": "Sensors whose last_updated is older than 6h \u2014 a stuck/dead integration signal.",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((time() - homeassistant_last_updated_time_seconds{domain=\"sensor\"}) > 21600) OR vector(0)",
          "legendFormat": "stale",
          "refId": "A"
        }
      ]
