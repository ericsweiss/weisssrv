---
# yamllint configuration for weisssrv homelab
# Aligned with ansible-lint production profile (160 char line limit)
# See: https://docs.ansible.com/projects/lint/rules/yaml/

extends: default

rules:
  line-length:
    max: 160
    level: error
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']
  comments:
    min-spaces-from-content: 1
  # Required by ansible-lint for compatibility
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
