# {{ ansible_managed }}
[Unit]
Description=Periodic off-node copy of the newest k3s etcd snapshot

[Timer]
OnCalendar={{ k3s_etcd_snapshot_copy_oncalendar }}
# Run a missed copy after downtime (e.g. the server was off at the scheduled
# time), so a rebooted node backfills the off-node copy promptly.
Persistent=true
# Stagger the three servers so they don't all hit the NAS export at once.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
