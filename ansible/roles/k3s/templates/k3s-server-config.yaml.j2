# {{ ansible_managed }}
# K3s server configuration

cluster-cidr: "{{ k3s_cluster_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"
# The apiserver listens on ALL interfaces (incl. any mgmt/Tailscale iface).
# Access to 6443 is gated solely by the Proxmox firewall, which restricts it to
# the k3s_nodes/admin IP sets (see docs/11-firewall.md). A firewall relaxation
# or an unexpected new interface silently widens API exposure.
bind-address: "0.0.0.0"

{% if k3s_disable | length > 0 %}
disable:
{% for component in k3s_disable %}
  - {{ component }}
{% endfor %}
{% endif %}

tls-san:
  - "{{ k3s_api_vip }}"
  - "k3s.{{ internal_domain }}"
  - "{{ inventory_hostname }}"
  - "{{ ansible_host }}"

# Node labels/taints applied declaratively at registration (k3s passes these to
# the kubelet's register-with-taints). The control-plane NoSchedule taint is
# therefore enforced the moment the server joins, closing the window where a
# workload could land on an etcd node before the post-join kubectl step. server.yml
# still re-asserts these via kubectl for already-registered nodes (agent path).
{% if k3s_labels | length > 0 %}
node-label:
{% for key, value in k3s_labels.items() %}
  - "{{ key }}={{ value }}"
{% endfor %}
{% endif %}

{% if k3s_taints | length > 0 %}
node-taint:
{% for taint in k3s_taints %}
  - "{{ taint.key }}={{ taint.value }}:{{ taint.effect }}"
{% endfor %}
{% endif %}

# CNI backend. wireguard-native enables WireGuard encryption on every
# cross-node pod packet (UDP/51820); set to vxlan to roll back. See
# group_vars/k3s.yml for the full rationale and rollout caveats.
flannel-backend: "{{ k3s_flannel_backend }}"

{# k3s_join_existing is set by server.yml when a wiped/rebuilt first server   #}
{# finds the API VIP already serving a cluster: it must REJOIN the surviving #}
{# quorum, not bootstrap a new one.                                          #}
{% if (k3s_is_first_server | default(false)) and not (k3s_join_existing | default(false)) %}
# Enable embedded etcd for HA (first server initializes the cluster)
cluster-init: true
{% else %}
# Join existing cluster via VIP
server: "https://{{ k3s_api_vip }}:{{ k3s_api_port }}"
{% endif %}

write-kubeconfig-mode: "0600"

# Lower-privilege token for agent (worker) joins. Agents authenticate with this
# instead of the server token, so a compromised agent can't register a
# control-plane node or pull the cluster CA. Defaults to the server token until a
# dedicated K3S_AGENT_TOKEN is provisioned (see group_vars/k3s.yml).
agent-token: "{{ k3s_agent_token }}"

# Encrypt secrets at rest in etcd
# For existing clusters: after enabling, run on a server node:
#   k3s secrets-encrypt reencrypt
secrets-encryption: true

# Serve etcd's Prometheus metrics on :2381 (0.0.0.0, unauthenticated HTTP) so
# kube-prometheus-stack's kubeEtcd target can scrape the 3 server nodes. Exposure
# is gated solely by the Proxmox firewall, which restricts :2381 to the
# monitoring/k3s_nodes IP sets (see docs/11-firewall.md) — same trust model as the
# apiserver bind above. Without this the kube-etcd targets stay down and
# etcdMembersDown/TargetDown fire.
etcd-expose-metrics: true

{% if k3s_kubelet_args | default([]) | length > 0 %}
kubelet-arg:
{% for arg in k3s_kubelet_args %}
  - "{{ arg }}"
{% endfor %}
{% endif %}
