#!/usr/bin/env bash
# {{ ansible_managed }}
# Copies the newest local k3s etcd snapshot to the off-node NFS export on
# pve-nas-01 and emits a node_exporter textfile metric
# (etcd_snapshot_last_copy_timestamp_seconds) consumed by the EtcdSnapshotStale
# alert. Invoked by k3s-etcd-snapshot-copy.timer on the server nodes.
#
# NOT `set -e`: the copy's outcome must be captured and the metric written
# regardless, so the staleness alert can fire on a failed/absent off-node copy.
# The prior success timestamp is preserved on failure so staleness measures
# time-since-last-successful-copy, not time-since-last-attempt.
set -uo pipefail

SNAP_DIR="{{ k3s_etcd_snapshot_dir }}"
DEST_ROOT="{{ k3s_etcd_snapshot_mountpoint }}"
PROM_DIR="{{ k3s_etcd_snapshot_textfile_dir }}"
RETENTION={{ k3s_etcd_snapshot_retention | int }}
{% raw %}
NODE="$(hostname -s)"
DEST="${DEST_ROOT}/${NODE}"
PROM_FILE="${PROM_DIR}/etcd_snapshot_copy.prom"

write_prom_metrics() {
  local success="$1" ts="$2" size="$3"
  local tmp prev
  tmp="${PROM_FILE}.$$"
  {
    echo "# HELP etcd_snapshot_last_copy_success Whether the last off-node etcd snapshot copy succeeded (1=success, 0=failure)"
    echo "# TYPE etcd_snapshot_last_copy_success gauge"
    echo "etcd_snapshot_last_copy_success ${success}"
    echo "# HELP etcd_snapshot_last_copy_size_bytes Size of the most recently copied etcd snapshot in bytes (0 = unknown)"
    echo "# TYPE etcd_snapshot_last_copy_size_bytes gauge"
    echo "etcd_snapshot_last_copy_size_bytes ${size}"
    echo "# HELP etcd_snapshot_last_copy_timestamp_seconds Modification time of the newest etcd snapshot copied off-node"
    echo "# TYPE etcd_snapshot_last_copy_timestamp_seconds gauge"
    if [ "$success" -eq 1 ]; then
      echo "etcd_snapshot_last_copy_timestamp_seconds ${ts}"
    else
      # Preserve the last-known-good timestamp so the staleness alert measures
      # time-since-last-successful-copy. If the mount stays down the timestamp
      # ages past the threshold and the alert fires — the desired signal. A node
      # whose copy has never succeeded has no prior value; emit epoch 0 so the
      # per-instance staleness arm fires immediately instead of waiting on the
      # cluster-wide absent() arm.
      prev="$(awk '/^etcd_snapshot_last_copy_timestamp_seconds/ {print $2}' "$PROM_FILE" 2>/dev/null || true)"
      echo "etcd_snapshot_last_copy_timestamp_seconds ${prev:-0}"
    fi
  } > "$tmp" 2>/dev/null || { rm -f "$tmp"; echo "cannot write metrics to ${tmp}" >&2; return 1; }
  mv "$tmp" "$PROM_FILE" || rm -f "$tmp"
}

fail() { echo "$1" >&2; write_prom_metrics 0 0 0; exit 1; }

mkdir -p "$PROM_DIR" || echo "cannot create ${PROM_DIR}" >&2

# The NFS export must be mounted; a bare cp onto an unmounted mountpoint would
# silently fill the server's local disk instead of the NAS.
mountpoint -q "$DEST_ROOT" || fail "off-node export ${DEST_ROOT} is not mounted"

# Newest regular file directly under the snapshot dir (k3s keeps snapshot
# metadata in a .metadata subdir, excluded by -maxdepth 1 -type f). Exclude
# *.part: etcd's SaveWithVersion writes `<name>.part` in this dir and renames
# it into place, so a raw newest-file pick could grab a truncated in-progress
# snapshot (mirrors the `.tmp.*` exclusion in the retention find below).
newest="$(find "$SNAP_DIR" -maxdepth 1 -type f ! -name '*.part' -printf '%T@ %p\n' 2>/dev/null \
  | sort -rn | head -1 | cut -d' ' -f2-)"
[ -n "$newest" ] && [ -f "$newest" ] || fail "no etcd snapshot found under ${SNAP_DIR}"

mkdir -p "$DEST" || fail "cannot create ${DEST}"

# Prune orphaned partial-copy temp files (an interrupted cp/mv leaves .tmp.*).
# The retention pass below excludes .tmp.*, so nothing else reaps them. Age-gate
# at 60min so a live copy's temp file is never removed (belt-and-braces: the
# oneshot service serializes same-node runs and each node writes its own $DEST).
find "$DEST" -maxdepth 1 -type f -name '.tmp.*' -mmin +60 -delete 2>/dev/null

base="$(basename "$newest")"
if [ ! -f "${DEST}/${base}" ]; then
  # Copy to a temp name in the destination dir, then atomically rename so a
  # partially-written file is never mistaken for a complete snapshot.
  tmp="${DEST}/.tmp.${base}.$$"
  cp -p "$newest" "$tmp" || { rm -f "$tmp"; fail "copy of ${base} to ${DEST} failed"; }
  mv -f "$tmp" "${DEST}/${base}" || { rm -f "$tmp"; fail "rename of ${base} in ${DEST} failed"; }
fi

# Retain only the newest RETENTION copies for this node on the export.
if [ "$RETENTION" -gt 0 ]; then
  find "$DEST" -maxdepth 1 -type f ! -name '.tmp.*' -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn | tail -n +$((RETENTION + 1)) | cut -d' ' -f2- \
    | while IFS= read -r old; do rm -f "$old"; done
fi

# Timestamp = the snapshot's own mtime, so if k3s stops producing snapshots the
# metric ages and the alert fires even while the copy keeps "succeeding".
mtime="$(stat -c %Y "$newest" 2>/dev/null || date +%s)"
size="$(stat -c %s "$newest" 2>/dev/null || echo 0)"
write_prom_metrics 1 "$mtime" "$size"
{% endraw %}
