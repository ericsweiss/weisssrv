# {{ ansible_managed }}
[Unit]
Description=Weekly rotating deep verify of the offsite restic repository
# restic check needs the repo env only (no local snapshot mounts), but network
# must be up; ordered after the mount passes anyway so a boot-time catch-up
# never races the pools. The control script's shared flock makes it impossible
# to interleave with a mid-run nightly backup (it fails fast and the timer
# retries next week; ResticOffsiteVerifyStale allows 8d).
After=zfs-mount.service zfs-mount-encrypted.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ restic_offsite_config_dir }}/env
# --auto-subset: read-verify a rotating 1/12 of pack data (ISO week % 12), so
# the full repo is re-read against bit-rot every ~12 weeks at bounded egress.
ExecStart=/usr/local/sbin/restic-offsitectl verify --auto-subset
Nice={{ restic_offsite_nice }}
IOSchedulingClass={{ restic_offsite_io_class }}
IOSchedulingPriority={{ restic_offsite_io_priority }}
CPUWeight={{ restic_offsite_cpu_weight }}
IOWeight={{ restic_offsite_io_weight }}
