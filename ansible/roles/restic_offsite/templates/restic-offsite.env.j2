# {{ ansible_managed }}
# EnvironmentFile for restic-offsite.service + the restic-offsitectl CLI.
# Rendered 0600 root:root with no_log — carries the restic repo password.
# Values are single-quoted: both consumers (systemd EnvironmentFile parsing and
# shell `source` for manual runs) treat single-quoted content literally, so
# whitespace/#/$ in a value cannot break parsing or expand. Single quotes and
# backslashes — the two characters the parsers disagree on — are rejected
# before render by the guard task in tasks/main.yml.
RESTIC_REPOSITORY='{{ restic_offsite_repo }}'
RESTIC_PASSWORD='{{ restic_repo_password }}'
RCLONE_CONFIG='{{ restic_offsite_config_dir }}/rclone.conf'
RESTIC_CACHE_DIR='{{ restic_offsite_cache_dir }}'
RCLONE_BWLIMIT='{{ restic_offsite_bwlimit }}'
RCLONE_TRANSFERS='{{ restic_offsite_rclone_transfers }}'
GOGC='{{ restic_offsite_gogc }}'
