#!/bin/bash
# {{ ansible_managed }}
#
# zfs-start-encrypted-guests.sh
#
# Starts the Proxmox guests whose disks live on the encrypted ssd pool, but
# ONLY after zfs-mount-encrypted.service has unlocked + mounted that storage.
#
# Gate: zfs-mount-encrypted.service must be ACTIVE. It goes active only once
# every encryption root reports keystatus=available AND `zfs mount -a`
# succeeded — which also means the encrypted zvol device nodes backing the VM
# disks have been created. If it's not active yet, exit 1 so the unit
# (Restart=on-failure, StartLimitIntervalSec=0) retries; we never start a
# guest against missing/locked storage.
#
# VM 222 (etcd) is intentionally NOT in this cohort: it has no encrypted disk
# and starts early on its normal onboot path, so cluster quorum never waits
# on this NAS's unlock.
#
# Idempotent: a guest already running is skipped.
#
# Exit codes:
#   0 — storage ready; every configured guest is running (or was already)
#   1 — storage not ready yet, OR a guest start failed (RETRY). Exiting non-zero
#       lets Restart=on-failure re-attempt, so a transient qm/pct race self-heals
#       rather than silently leaving a guest down. The grep-running guard makes
#       retries idempotent for guests that did come up.

set -uo pipefail

log() { logger -t "zfs-start-encrypted-guests" -s -- "$*"; }

VMIDS=({{ zfs_encryption_guest_vmids | default([]) | map('string') | join(' ') }})
CTIDS=({{ zfs_encryption_guest_ctids | default([]) | map('string') | join(' ') }})

# NOTE: bash array-LENGTH syntax is deliberately avoided here — its brace+hash
# sequence is read as a Jinja comment opener during templating. "${arr[*]}"
# expands to "" for an empty array, so -z is an equivalent emptiness test.
if [ -z "${VMIDS[*]}" ] && [ -z "${CTIDS[*]}" ]; then
    log "no encrypted-storage guests configured; nothing to do"
    exit 0
fi

# Gate on the mount anchor: active <=> all keys loaded + datasets mounted
# (so the VM-disk zvol device nodes exist too).
if ! systemctl is-active --quiet zfs-mount-encrypted.service; then
    log "zfs-mount-encrypted.service not active yet; encrypted storage not ready, will retry"
    exit 1
fi

# Let udev finish creating the encrypted zvol device nodes before qm start
# touches them (key-load triggers async /dev/zvol symlink creation).
udevadm settle --timeout=30 || true

start_failed=0

for vm in "${VMIDS[@]}"; do
    if qm status "$vm" 2>/dev/null | grep -q running; then
        log "VM $vm already running"
        continue
    fi
    if qm start "$vm"; then
        log "started VM $vm"
    else
        log "qm start $vm failed; will retry the unit"
        start_failed=1
    fi
done

for ct in "${CTIDS[@]}"; do
    if pct status "$ct" 2>/dev/null | grep -q running; then
        log "CT $ct already running"
        continue
    fi
    if pct start "$ct"; then
        log "started CT $ct"
    else
        log "pct start $ct failed; will retry the unit"
        start_failed=1
    fi
done

# Exit non-zero on any start failure so Restart=on-failure re-attempts the
# laggards (idempotent via the grep-running guard above).
if [ "$start_failed" -ne 0 ]; then
    exit 1
fi

exit 0
