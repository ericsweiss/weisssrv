# {{ ansible_managed }}
#
# Starts the Proxmox guests whose disks live on the encrypted ssd pool AFTER
# zfs-mount-encrypted.service has unlocked + mounted it. This gates ONLY the
# encrypted-storage cohort (the VMs/CTs in zfs_encryption_guest_vmids /
# _ctids); it does NOT touch pve-guests.service, so VM 222 (etcd) starts
# early on its normal onboot path and cluster quorum never waits on this
# NAS's unlock.
#
# WantedBy=multi-user.target, never Before any boot target -> it can delay
# these guests but can never hang boot. The script self-gates on the mount
# anchor being active and the unit retries (Restart=on-failure,
# StartLimitIntervalSec=0), so a slow cold-cluster unlock just means the
# guests start a little later, once storage is up.
#
# NOTE: deliberately UN-sandboxed (no NoNewPrivileges / ProtectSystem / etc.),
# matching the stock pve-guests.service. qm/pct fork qemu/lxc which rely on
# setuid helpers (e.g. qemu-bridge-helper) and broad access to /etc/pve;
# NoNewPrivileges would propagate to the guest and break its networking.

[Unit]
Description=Start Proxmox guests on encrypted ZFS storage after unlock
Wants=zfs-mount-encrypted.service
After=zfs-mount-encrypted.service pve-guests.service
ConditionPathExists=/usr/local/sbin/zfs-start-encrypted-guests.sh
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/zfs-start-encrypted-guests.sh
# Type=oneshot defaults to TimeoutStartSec=infinity, so a hung `qm start` /
# `pct start` (e.g. a storage stall) would leave this unit "activating" forever
# and Restart=on-failure would never fire. Bound it so a wedged guest start
# fails and is retried.
TimeoutStartSec=5min
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
