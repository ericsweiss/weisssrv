# {{ ansible_managed }}
#
# Loads the ZFS pool encryption key for a single pool from 1Password
# Connect at boot. Instance name is the pool name; the corresponding
# 1Password item title is looked up from
# /etc/zfs/encryption/pools/<pool>.conf.
#
# Ordering (reworked 2026-06 — key-load is now OFF the early-boot critical
# path; full narrative in docs/32-zfs-encryption.md "Boot sequence"):
#   DefaultDependencies=no   : kept, but now harmless — the unit is no longer
#                              Before=zfs-mount/local-fs, so it just means
#                              systemd adds no implicit After=basic.target; the
#                              explicit After= lines below cover all this needs.
#   After=zfs-import.target  : pool must be imported first
#   After=network-online.target (+ Wants=) : Connect (connect.esweiss.com) lives
#                              in k8s and is only reachable once the network is
#                              up. This edge is now LEGAL because the unit no
#                              longer sits Before=zfs-mount (which is
#                              Before=local-fs, itself After=network-online — the
#                              old combination closed an ordering cycle). The
#                              script still retries internally for the
#                              cold-cluster case where Connect comes up later.
#   NO Before=zfs-mount.service / NO RequiredBy=zfs-mount.service :
#                              deleting these two edges is what dissolves the
#                              cycle and takes a slow/failing unlock OUT of the
#                              boot-blocking path. Stock zfs-mount.service still
#                              runs early; `zfs mount -a` simply SKIPS the
#                              still-locked datasets (mounts plaintext only) and
#                              returns — boot reaches multi-user (ssh + Tailscale)
#                              with zero dependency on this unlock.
#   WantedBy=zfs-mount-encrypted.service :
#                              encrypted datasets are mounted by the late,
#                              retrying zfs-mount-encrypted.service AFTER keys
#                              load. A failed pool unlock is contained to itself
#                              (Wants, not Requires): it never fails the anchor
#                              for the other pool, nor any boot target.
#
# Restart policy: the script loops internally for fetch_timeout (default
# 120s) per phase with jitter — waiting for the pool import first, then
# (with the C1 vault UUID resolution) THREE sequential Connect lookups
# (vault + item-id + item-field, each now on the same deadline/retry loop)
# — so every Connect-phase and pool-wait failure path consumes up to a
# full fetch_timeout before exiting. Worst-case per-ExecStart wall time is
# ~480s + RestartSec 30s; even the fastest of those retryable cycles fits
# well under StartLimitBurst=60 in the 3600s StartLimitIntervalSec window,
# so the unit retries forever rather than parking failed.
#
# The ONE residual fast-fail exit is exit 5 (encryptionroot enumeration
# failure, zfs-load-key.sh:288-292) — it fires immediately AFTER a
# successful Connect fetch, so a persistent failure of that shape cycles
# at ~RestartSec (30s) and WILL trip StartLimitBurst=60 in roughly half an
# hour, surfacing as failed. That's the intended "misconfiguration
# eventually trips the limit" behavior below, not a boot-blocking hang.
#
# That's fine for our actual recovery path: when an operator manually
# unlocks via `sudo zfs load-key <pool>` the script's keystatus
# short-circuit makes the next ExecStart exit 0, and the unit
# transitions to active. The StartLimit* values are kept conservative
# so a misconfiguration (e.g. broken token) doesn't sit retrying for
# weeks — it'll eventually trip the limit and surface as failed.

[Unit]
Description=Load ZFS encryption key for %i from 1Password Connect
DefaultDependencies=no
Conflicts=shutdown.target
Wants=network-online.target
After=zfs-import.target network-online.target
Before=shutdown.target
ConditionPathExists=/etc/zfs/encryption/pools/%i.conf
# StartLimit* belong in [Unit] (not [Service]) since systemd 230 — placing
# them in [Service] silently drops them. With the values below the unit
# does NOT trip the burst limit on a normal cold-cluster boot (see the
# header comment above for the math); see also the README "Cold-cluster
# boot" section which describes the retry-forever-until-success
# behavior these settings produce.
StartLimitIntervalSec=3600s
StartLimitBurst=60

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/zfs/encryption/pools/%i.conf
ExecStart=/usr/local/sbin/zfs-load-key.sh %i
Restart=on-failure
RestartSec=30s
# Operator-config errors that won't fix by retrying:
#   1 — config/arg/token error
#   3 — vault/item/field not found
#   4 — `zfs load-key` failed (wrong passphrase, kernel rejected key) —
#       rotated 1P passphrase that no longer matches the on-pool wrapping
#       key falls here; retrying 60×/hour scrolls journald without ever
#       surfacing the real problem.
#   7 — Connect rejected token (401/403)
# rc=2 (Connect unreachable beyond fetch_timeout) is intentionally absent
# from this list — that's the cold-cluster boot case where Connect just
# isn't up yet, and we DO want the unit to keep retrying.
# rc=5 (pool not imported) is also intentionally absent — pool import
# may genuinely arrive later in the boot sequence.
RestartPreventExitStatus=1 3 4 7

# Hardening
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run /var/log
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
# AF_NETLINK is needed by glibc's getaddrinfo() for AI_ADDRCONFIG (it
# opens a NETLINK_ROUTE socket to inspect routable address families).
# Restricting it on some glibc versions causes curl's DNS resolution of
# connect.esweiss.com to fail at cold boot.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
# WantedBy (not RequiredBy): a failed key-load must NOT fail its consumer.
# zfs-mount-encrypted.service is the late, retrying unit that mounts the
# encrypted datasets once keys are loaded; it gates on keystatus itself and
# retries, so pulling each per-pool key-load in as a Wants (best-effort) is
# correct — one pool failing to unlock must not block the other pool's mount
# or any boot target.
#
# `systemctl enable` on this unit creates a symlink at
# /etc/systemd/system/zfs-mount-encrypted.service.wants/<unit>.service. That
# directory is operator-managed (under /etc, not /lib), so a zfsutils-linux
# package upgrade leaves it intact. NOTE: the role unconditionally sweeps the
# OLD /etc/systemd/system/zfs-mount.service.requires/zfs-load-key@*.service
# symlinks left by the previous RequiredBy= form — `systemctl disable` after
# this [Install] change only removes the NEW link, not the stale fatal one.
WantedBy=zfs-mount-encrypted.service
