# Home Assistant Secrets
# This file is managed via Ansible and deployed from Git
# Generated from: ansible/roles/home_assistant/templates/secrets.yaml.j2
# DO NOT manually edit on Home Assistant - changes will be overwritten

# SMTP relay credentials
smtp_username: {{ home_assistant_smtp_username | to_json }}
smtp_password: {{ home_assistant_smtp_password | to_json }}

# Admin email
admin_email: {{ home_assistant_admin_email | to_json }}

# SSO/OIDC credentials
oidc_client_id: {{ home_assistant_oidc_client_id | to_json }}
oidc_client_secret: {{ home_assistant_oidc_client_secret | to_json }}
