# {{ ansible_managed }}
# Managed by the vfio_passthrough Ansible role (host-side GPU passthrough).
#
# Bind the listed PCI functions to vfio-pci and keep the host driver(s) off them
# so the device is free to pass through to a guest. The primary bind is the
# `vfio-pci.ids=` kernel cmdline (GRUB drop-in); this `options vfio-pci ids=` is
# the redundant modprobe.d twin, and vfio-pci is also force-loaded at boot by
# /etc/modules-load.d/vfio-pci.conf. The entries here are baked into the initramfs
# by the role's Rebuild-initramfs handler. The role never reboots — the operator
# does, in a maintenance window (docs/43).
options vfio-pci ids={{ vfio_passthrough_pci_ids | join(',') }}
{% for mod in vfio_passthrough_blacklist_modules %}
# {{ mod }}: hard-blacklisted (never loads) — vfio-pci claims its function via ids=.
blacklist {{ mod }}
{% endfor %}
{% for mod in vfio_passthrough_softdep_modules %}
# {{ mod }} loads at boot for other host devices; make vfio-pci win the race for
# the passed-through function by loading it first.
softdep {{ mod }} pre: vfio-pci
{% endfor %}
