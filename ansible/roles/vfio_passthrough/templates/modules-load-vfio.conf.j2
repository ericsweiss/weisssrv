# {{ ansible_managed }}
# Managed by the vfio_passthrough Ansible role.
#
# Force vfio-pci to load early at boot as a belt-and-suspenders fallback to the
# `vfio-pci.ids=` kernel cmdline (the primary, earliest bind — vfio-pci grabs the
# functions the instant it loads in the initramfs). systemd-modules-load reads
# this at real-root boot and loads vfio-pci even if nothing else pulls it in
# (nouveau is blacklisted, so a softdep on it would never fire); it then claims
# the functions via the cmdline ids= and the redundant `options vfio-pci ids=` in
# /etc/modprobe.d/vfio.conf. The modprobe.d options/blacklist/softdep are also
# baked into the initramfs.
vfio-pci
