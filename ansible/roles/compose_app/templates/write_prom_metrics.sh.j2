# {{ ansible_managed }}
# shellcheck shell=bash
# Sourceable helper: atomically write node_exporter textfile backup-freshness
# metrics for the compose-app VM backup wrappers (immich + nextcloud). Sourced
# by each <app>-backup-run.sh, which passes the metric-name prefix and the .prom
# path so this logic stays identical across apps. On failure it preserves the
# prior success timestamp so the *BackupStale alerts measure time-since-last-
# success, not time-since-last-attempt.
#
# Usage: write_prom_metrics <prefix> <success> <duration> <size> <prom_file>
write_prom_metrics() {
  local prefix="$1" success="$2" duration="$3" size="$4" prom_file="$5"
  local ts tmp prev
  ts="$(date +%s)"
  tmp="${prom_file}.$$"
  {
    echo "# HELP ${prefix}_last_run_duration_seconds Duration of last backup run"
    echo "# TYPE ${prefix}_last_run_duration_seconds gauge"
    echo "${prefix}_last_run_duration_seconds ${duration}"
    echo "# HELP ${prefix}_last_run_success Whether the last run succeeded (1=success, 0=failure)"
    echo "# TYPE ${prefix}_last_run_success gauge"
    echo "${prefix}_last_run_success ${success}"
    echo "# HELP ${prefix}_last_size_bytes Size of the most recent {{ compose_app_backup_size_help_object }} in bytes (0 = unknown)"
    echo "# TYPE ${prefix}_last_size_bytes gauge"
    echo "${prefix}_last_size_bytes ${size}"
    if [ "$success" -eq 1 ]; then
      echo "# HELP ${prefix}_last_success_timestamp_seconds Unix timestamp of last successful backup"
      echo "# TYPE ${prefix}_last_success_timestamp_seconds gauge"
      echo "${prefix}_last_success_timestamp_seconds ${ts}"
    else
      # Preserve the last-known success timestamp so the staleness alert
      # measures time-since-last-success, not time-since-last-attempt.
      prev="$(awk -v k="${prefix}_last_success_timestamp_seconds" '$1 == k {print $2}' "$prom_file" 2>/dev/null || true)"
      if [ -n "$prev" ]; then
        echo "# HELP ${prefix}_last_success_timestamp_seconds Unix timestamp of last successful backup"
        echo "# TYPE ${prefix}_last_success_timestamp_seconds gauge"
        echo "${prefix}_last_success_timestamp_seconds ${prev}"
      fi
    fi
  } > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  mv "$tmp" "$prom_file" 2>/dev/null || rm -f "$tmp"
}
