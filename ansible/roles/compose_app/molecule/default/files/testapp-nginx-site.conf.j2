# {{ ansible_managed }}
# Molecule fixture for the shared host-nginx task flow (compose_app/tasks/nginx.yml).
# A caller's real site template stays in its own role; this stand-in just proves
# the flow deploys + enables a site and removes the packaged default vhost.
server {
    listen 80;
    server_name testapp.local;
    ssl_certificate {{ compose_app_nginx_ssl_cert }};
    ssl_certificate_key {{ compose_app_nginx_ssl_key }};
}
