// {{ ansible_managed }}

// Read system journal
loki.source.journal "system" {
  forward_to    = [loki.relabel.journal.receiver]
  relabel_rules = loki.relabel.journal.rules
  labels = {
    job  = "journal",
    host = "{{ inventory_hostname }}",
  }
}

// Add useful labels from journal metadata
loki.relabel "journal" {
  forward_to = [loki.write.default.receiver]

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "priority"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "hostname"
  }
}

// Ship to Loki
loki.write "default" {
  endpoint {
    url = "{{ alloy_host_loki_url }}"
{% if alloy_host_loki_user | length > 0 %}
    basic_auth {
      username = {{ alloy_host_loki_user | to_json }}
      password = {{ alloy_host_loki_password | to_json }}
    }
{% endif %}
  }
{% if alloy_host_wal_enabled %}

  // On-disk WAL — resilience against the host->Loki circular dependency.
  // Loki lives in the k3s cluster this host helps observe; during a Loki /
  // Traefik / cluster outage the WAL buffers journald entries to disk and
  // replays them when Loki recovers, instead of dropping them once the
  // in-memory queue fills. max_segment_age bounds replay lag and disk use.
  wal {
    enabled         = true
    max_segment_age = {{ alloy_host_wal_max_segment_age | to_json }}
  }
{% endif %}
}
