# {{ ansible_managed }}
# Oneshot that samples zpool status (health, vdev error counters, scrub
# age) once per pool. Invoked every minute by zpool-status-collector.timer.
[Unit]
Description=Sample zpool status to node_exporter textfile collector
# After=zfs-import gives boot-time ordering so the loop sees imported
# pools on first run. No PartOf: pools being exported mid-run is handled
# by the script's per-pool error tolerance.
After=zfs-import.target

[Service]
Type=oneshot
# Passes the textfile dir so the role variable (node_exporter_host_textfile_dir)
# is honored both here and inside the script — same contract as the
# corosync collector.
ExecStart=/usr/local/sbin/zpool-status-collector.sh {{ node_exporter_host_textfile_dir }}
User=root
# zpool status is sub-second per pool; bound the unit anyway so a hung
# pool (suspended I/O) can't accumulate stuck oneshots.
TimeoutStartSec=30s
Nice=10
# Sandbox: the collector runs `zpool list/status` (which needs the /dev/zfs
# ioctl) and writes one .prom atomically to the textfile dir. PrivateDevices
# is deliberately NOT set — it would hide /dev/zfs and break zpool, the same
# carve-out the zfs_exporter unit documents. ProtectSystem=strict keeps the
# rest of the fs read-only except the textfile dir.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
ReadWritePaths={{ node_exporter_host_textfile_dir }}
