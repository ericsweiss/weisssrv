#!/usr/bin/env bash
# {{ ansible_managed }}
# Nightly Nextcloud PostgreSQL logical backup + node_exporter textfile metrics.
# Invoked by nextcloud-backup.service (nextcloud-backup.timer).
#
# The dump lands on the offsite NFS landing zone (tank/backups/apps/nextcloud)
# so the compact logical dump rides the archsync file walk into B2 (the bulk
# file data on tank/nextcloud-data/disk is protected locally by archive
# replication + vzdump). The metric-writing logic is the shared
# write_prom_metrics helper (compose_app), sourced below.
#
# NOT `set -e`: the dump's exit code must be captured and the metric written
# regardless, so NextcloudBackupFailed/Stale can fire. The prior success
# timestamp is preserved on failure so staleness measures time-since-success.
set -uo pipefail

COMPOSE_DIR="{{ nextcloud_compose_dir }}"
BACKUP_DIR="{{ nextcloud_backup_dir }}"
KEEP_DAYS="{{ nextcloud_backup_keep_days }}"
DB_NAME="{{ nextcloud_db_name }}"
DB_USER="{{ nextcloud_db_user }}"
PROM_DIR="{{ node_exporter_host_textfile_dir | default('/var/lib/node_exporter') }}"
# 1 when the backup lands on the offsite NFS export (nextcloud_backup_nfs_enabled).
NFS_ENABLED="{{ '1' if (nextcloud_backup_nfs_enabled | default(false)) else '0' }}"

# Hard gate (no set -e here): without the lib, write_prom_metrics is
# undefined and the run would proceed metric-less — refuse instead.
# shellcheck source=/dev/null
if ! source {{ nextcloud_backup_lib_path }}; then
  echo "nextcloud-backup: missing backup metrics library {{ nextcloud_backup_lib_path }}" >&2
  exit 1
fi
{% raw %}
PROM_FILE="${PROM_DIR}/nextcloud_backup.prom"
START_TS="$(date +%s)"
# Passed to write_prom_metrics so a run that produced nothing still reports the
# newest EXISTING dump's size: 0 is BackupArtifactEmpty's (critical) "no artefact
# at all", not "tonight's dump failed" — that is NextcloudBackupFailed's job.
ARTIFACT_GLOB="${BACKUP_DIR}/nextcloud-db-*.sql.gz"

mkdir -p "$PROM_DIR"

# Fail closed on an unmounted offsite landing zone (mirrors
# gitlab-backup-run.sh.j2): when NFS-backed, BACKUP_DIR is the mountpoint of
# the per-app export; a missing mount would land the dump on the OS-disk
# mountpoint dir — silently un-offsited. Refuse + record success=0.
if [ "$NFS_ENABLED" = "1" ] && ! mountpoint -q "$BACKUP_DIR"; then
  echo "nextcloud-backup: BACKUP_DIR ${BACKUP_DIR} is NFS-backed but not mounted — aborting" >&2
  write_prom_metrics nextcloud_backup 0 0 0 "$PROM_FILE" "$ARTIFACT_GLOB"
  exit 1
fi
mkdir -p "$BACKUP_DIR"
cd "$COMPOSE_DIR" || exit 1

OUT="${BACKUP_DIR}/nextcloud-db-$(date +%Y%m%d-%H%M%S).sql.gz"
TMP="${OUT}.partial"

# pg_dump inside the db container -> gzip on the host. --clean --if-exists makes
# the dump idempotently restorable over an existing schema. Capture BOTH stages'
# exit codes immediately: a gzip / disk-full failure can still leave a non-empty
# partial file, so promoting on `[ -s ]` alone would ship a truncated dump as a
# "success". Require pg_dump AND gzip to have exited 0.
docker compose exec -T nextcloud-db \
  pg_dump -U "$DB_USER" -d "$DB_NAME" --clean --if-exists 2>/dev/null | gzip -c > "$TMP"
pipe_status=("${PIPESTATUS[@]}")

size=0
if [ "${pipe_status[0]}" -eq 0 ] && [ "${pipe_status[1]}" -eq 0 ] && [ -s "$TMP" ]; then
  mv "$TMP" "$OUT"
  rc=0
  size="$(stat -c %s "$OUT" 2>/dev/null || echo 0)"
  # Prune old dumps only after a successful new one.
  find "$BACKUP_DIR" -maxdepth 1 -name 'nextcloud-db-*.sql.gz' -mtime "+${KEEP_DAYS}" -delete 2>/dev/null || true
else
  rc=1
  rm -f "$TMP"
fi

end_ts="$(date +%s)"
duration=$(( end_ts - START_TS ))
if [ "$rc" -eq 0 ]; then
  write_prom_metrics nextcloud_backup 1 "$duration" "$size" "$PROM_FILE" "$ARTIFACT_GLOB"
else
  write_prom_metrics nextcloud_backup 0 "$duration" "$size" "$PROM_FILE" "$ARTIFACT_GLOB"
fi

exit "$rc"
{% endraw %}
