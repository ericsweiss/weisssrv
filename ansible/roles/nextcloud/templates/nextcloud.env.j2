# {{ ansible_managed }}
# Secret values interpolated into docker-compose.yml (${NEXTCLOUD_*}).
# Mode 0600, root-only. Do NOT commit real values — sourced from 1Password.
#
# Values are double-quoted with backslash, double-quote, and dollar-sign escaped
# so the compose-go dotenv parser treats them as literals. Unquoted values are
# subject to `$`-interpolation (a generated password containing `$name` would be
# silently truncated/rewritten); single quotes cannot hold an embedded `'`.
# Double-quote + escape round-trips every character (verified against docker
# compose config/up), so a 1Password-generated token with any special character
# reaches the container intact.
NEXTCLOUD_POSTGRES_PASSWORD="{{ nextcloud_db_password | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') }}"
NEXTCLOUD_ADMIN_PASSWORD="{{ nextcloud_admin_password | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') }}"
NEXTCLOUD_SERVERINFO_TOKEN="{{ nextcloud_serverinfo_token | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') }}"
