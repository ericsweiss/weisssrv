# {{ ansible_managed }}
# Host nginx: terminates 443 with the distributed *.esweiss.com wildcard cert
# and reverse-proxies to the loopback-bound Nextcloud web container. The
# Nextcloud-specific rewrite/security rules live in the container's own apache;
# this front end only needs TLS, large bodies, websockets, and forwarded
# headers. HSTS is added at the edge by Traefik's hsts-header middleware.

map $http_upgrade $nextcloud_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ nextcloud_nginx_server_names }};

    ssl_certificate     {{ nextcloud_nginx_ssl_certificate }};
    ssl_certificate_key {{ nextcloud_nginx_ssl_certificate_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # --- Real client IP resolution -----------------------------------------
    # Trust chain: client -> Traefik pod -> (k3s/flannel SNATs the pod source to
    # the k3s NODE IP, since .156 is a VM outside the pod network) -> this nginx
    # -> nextcloud container. Only the k3s node IPs are legitimate proxy sources,
    # so nginx trusts ONLY those as real_ip sources and walks Traefik's
    # X-Forwarded-For back to the true client. A directly connected LAN/admin
    # client (the firewall permits :443 for debugging) is NOT a trusted source,
    # so its inbound X-Forwarded-For is ignored and $remote_addr stays its real
    # address — a forged header cannot move the recorded client IP.
{% for addr in nextcloud_nginx_real_ip_trusted_addresses %}
    set_real_ip_from {{ addr }};
{% endfor %}
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Unlimited upload size (Nextcloud enforces its own quota); disable request
    # buffering so large chunked uploads stream straight through.
    client_max_body_size 0;
    client_body_timeout 300s;
    proxy_request_buffering off;
    proxy_buffering off;

    location / {
        proxy_pass http://{{ nextcloud_http_bind_address }}:{{ nextcloud_http_bind_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # REPLACE (not append) X-Forwarded-For with the real_ip-resolved client.
        # The container trusts only its immediate hop (this nginx, via the docker
        # gateway) and reads this single authoritative value, so a spoofed
        # upstream header can never be walked back past nginx's resolved address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $nextcloud_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_max_temp_file_size 0;
    }
}
