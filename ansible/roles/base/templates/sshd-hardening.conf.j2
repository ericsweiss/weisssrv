# {{ ansible_managed }}
# SSH hardening drop-in. Lives in /etc/ssh/sshd_config.d/ with a low sort
# prefix (00-) so that under sshd's FIRST-match-wins precedence it is applied
# before any cloud-init-generated drop-in (50-cloud-init.conf), which on the
# Proxmox cloud-init VM image can otherwise set PasswordAuthentication and win.
Port {{ ssh_port }}
PermitRootLogin {{ ssh_permit_root_login }}
PasswordAuthentication {{ ssh_password_authentication | ternary('yes', 'no') }}
PubkeyAuthentication {{ ssh_pubkey_authentication | ternary('yes', 'no') }}
# KbdInteractiveAuthentication replaces the deprecated
# ChallengeResponseAuthentication alias on OpenSSH 9.x (Debian trixie).
KbdInteractiveAuthentication no
UsePAM yes
X11Forwarding no
MaxAuthTries 3
ClientAliveInterval 300
ClientAliveCountMax 2
