# {{ ansible_managed }}
#
# tlshd (kernel TLS handshake daemon) configuration.
# tlshd accepts handshake-upcalls from the kernel and answers them with
# a userspace TLS handshake against a remote peer. Used by NFSv4
# `xprtsec=tls` (server-only auth) or `xprtsec=mtls` (mutual auth).

[main]
libdebug=0
nlevel=0

# Server-side TLS: tlshd loads our cert/key when the kernel asks for a
# server identity. Required when this host runs nfs-server with
# xprtsec=tls/mtls in /etc/exports.
[authenticate.server]
x509.certificate={{ nfs_tls_cert_path }}
x509.private_key={{ nfs_tls_key_path }}
x509.truststore={{ nfs_tls_truststore }}

# Client-side TLS: same files used when the kernel mounts an NFS share
# with xprtsec=tls/mtls. For mtls the client must present a cert; with
# xprtsec=tls the truststore is consulted for server cert validation.
[authenticate.client]
x509.certificate={{ nfs_tls_cert_path }}
x509.private_key={{ nfs_tls_key_path }}
x509.truststore={{ nfs_tls_truststore }}
