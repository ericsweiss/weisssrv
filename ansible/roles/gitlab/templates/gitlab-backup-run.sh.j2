#!/usr/bin/env bash
# {{ ansible_managed }}
# Runs the daily GitLab backup and emits node_exporter textfile metrics.
# Invoked by gitlab-backup.service (gitlab-backup.timer) installed by the role.
#
# NOT `set -e`: the backup's exit code must be captured and the metric
# written regardless, so GitLabBackupFailed/Stale alerts can fire on a
# failed run. The wrapper preserves the prior success timestamp on
# failure so staleness measures time-since-last-success.
set -uo pipefail

BACKUP_PATH="{{ gitlab_backup_path }}"
PROM_DIR="{{ node_exporter_host_textfile_dir | default('/var/lib/node_exporter') }}"
# 1 when the backup lands on the offsite NFS export (gitlab_backup_nfs_enabled).
NFS_ENABLED="{{ '1' if (gitlab_backup_nfs_enabled | default(false)) else '0' }}"
# Components excluded from the tarball (gitlab-backup SKIP=). Rendered here in the
# non-raw preamble and quote-filtered, so an overridden gitlab_backup_skip with
# whitespace/metacharacters can't be word-split or interpreted when used below.
BACKUP_SKIP={{ (gitlab_backup_skip | default('', true) | regex_replace('\\s+', '')) | quote }}
{% raw %}
PROM_FILE="${PROM_DIR}/gitlab_backup.prom"
START_TS="$(date +%s)"

write_prom_metrics() {
  local success="$1" duration="$2" size="$3"
  local ts tmp prev
  ts="$(date +%s)"
  tmp="${PROM_FILE}.$$"
  {
    echo "# HELP gitlab_backup_last_run_duration_seconds Duration of last backup run"
    echo "# TYPE gitlab_backup_last_run_duration_seconds gauge"
    echo "gitlab_backup_last_run_duration_seconds ${duration}"
    echo "# HELP gitlab_backup_last_run_success Whether the last run succeeded (1=success, 0=failure)"
    echo "# TYPE gitlab_backup_last_run_success gauge"
    echo "gitlab_backup_last_run_success ${success}"
    echo "# HELP gitlab_backup_last_size_bytes Size of the most recent backup tarball in bytes (0 = unknown)"
    echo "# TYPE gitlab_backup_last_size_bytes gauge"
    echo "gitlab_backup_last_size_bytes ${size}"
    if [ "$success" -eq 1 ]; then
      echo "# HELP gitlab_backup_last_success_timestamp_seconds Unix timestamp of last successful backup"
      echo "# TYPE gitlab_backup_last_success_timestamp_seconds gauge"
      echo "gitlab_backup_last_success_timestamp_seconds ${ts}"
    else
      # Preserve the last-known success timestamp so the staleness alert
      # measures time-since-last-success, not time-since-last-attempt.
      prev="$(awk '/^gitlab_backup_last_success_timestamp_seconds/ {print $2}' "$PROM_FILE" 2>/dev/null || true)"
      if [ -n "$prev" ]; then
        echo "# HELP gitlab_backup_last_success_timestamp_seconds Unix timestamp of last successful backup"
        echo "# TYPE gitlab_backup_last_success_timestamp_seconds gauge"
        echo "gitlab_backup_last_success_timestamp_seconds ${prev}"
      fi
    fi
  } > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  mv "$tmp" "$PROM_FILE" 2>/dev/null || rm -f "$tmp"
}

mkdir -p "$PROM_DIR"

# Fail closed on an unmounted offsite landing zone. When NFS-backed, BACKUP_PATH
# is the mountpoint of the tank/backups/apps export; if the mount is missing
# (NAS down, unmount, boot race), writing there would land the tarball on the
# underlying OS-disk mountpoint dir — silently un-offsited AND filling the OS disk
# (the DiskUsageCritical spiral the slimming fixed). Refuse, record success=0
# (GitLabBackupFailed), and exit non-zero BEFORE running gitlab-backup.
if [ "$NFS_ENABLED" = "1" ] && ! mountpoint -q "$BACKUP_PATH"; then
  echo "gitlab-backup: BACKUP_PATH ${BACKUP_PATH} is NFS-backed but not mounted — aborting" >&2
  write_prom_metrics 0 0 0
  exit 1
fi

# SKIP excludes the container registry (rebuildable CI images — by far the
# largest component, ~7.5G vs a 16K repo) and CI artifacts (ephemeral job
# output) from the tarball, so a backup is DB + repos + config, not multi-GB.
# The registry data lives at the Omnibus default path on the OS disk (covered
# by the nightly vzdump of the VM) and is re-pushable from CI. Configurable via
# gitlab_backup_skip.
if [ -n "$BACKUP_SKIP" ]; then
  /opt/gitlab/bin/gitlab-backup create CRON=1 "SKIP=$BACKUP_SKIP"
else
  /opt/gitlab/bin/gitlab-backup create CRON=1
fi

rc=$?

# gitlab-backup excludes gitlab-secrets.json and gitlab.rb; without them a
# restore cannot decrypt CI variables, 2FA, or runner tokens. Copy them
# alongside the data backup, but only when create succeeded. A copy failure
# (disk full, perms, missing source) demotes rc to 1 so the run records
# success=0 and GitLabBackupFailed fires — an un-restorable backup must NOT
# report healthy. This is stricter than a bare `|| true`, which would hide a
# missing-secrets backup behind a green metric.
# --preserve=mode,timestamps (NOT -p): when BACKUP_PATH is the all_squash NFS
# export (prod relocates it onto tank/backups/apps/gitlab), the write is squashed
# to 1000:2000 and a chown back to root:root is EPERM — plain `cp -p` would fail
# to preserve ownership and demote rc to a FALSE failure. Ownership is irrelevant
# to the backup (restore recreates these via reconfigure); mode 0600 is preserved.
if [ "$rc" -eq 0 ]; then
  cp --preserve=mode,timestamps /etc/gitlab/gitlab-secrets.json /etc/gitlab/gitlab.rb "${BACKUP_PATH}/" || rc=1
fi

# Newest tarball size (best-effort). gitlab-backup names archives
# <epoch>_<date>_<version>_gitlab_backup.tar. Measured after create returns,
# so the newest match is a complete archive. 0 on any glob/stat failure.
size=0
newest="$(ls -1t "${BACKUP_PATH}"/*_gitlab_backup.tar 2>/dev/null | head -1 || true)"
if [ -n "$newest" ] && [ -f "$newest" ]; then
  size="$(stat -c %s "$newest" 2>/dev/null || echo 0)"
fi

end_ts="$(date +%s)"
duration=$(( end_ts - START_TS ))
if [ "$rc" -eq 0 ]; then
  write_prom_metrics 1 "$duration" "$size"
else
  write_prom_metrics 0 "$duration" "$size"
fi

exit "$rc"
{% endraw %}
