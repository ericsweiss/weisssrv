# {{ ansible_managed }}
# GitLab EE Configuration
# See https://docs.gitlab.com/omnibus/settings/configuration.html
{#
  rb() renders a value as a Ruby literal, safe against BOTH injection classes
  gitlab.rb (which is evaluated as Ruby) is exposed to:

    1. Quote/backslash break-out — `to_json` handles it: JSON string escaping
       is valid Ruby double-quoted-string escaping, so a rotated SMTP password
       containing " or \ can no longer render a syntactically invalid file and
       break the next `gitlab-ctl reconfigure` on a live GitLab.
    2. Ruby #{...} interpolation — `to_json` does NOT escape `#`, and Ruby
       interpolates inside double quotes, so a credential containing `#{` would
       be EVALUATED at reconfigure time (NameError aborting the chef run at
       best). The `ruby -c` validate on the template task cannot catch it:
       "#{foo}" is syntactically valid. Escaping every `#` as `\#` closes it —
       in a Ruby double-quoted string `\#` is a plain `#`, verified with
       `ruby -e 'p "a\#{1+1}b"'` -> "a\#{1+1}b" (literal, not evaluated).
       to_json never emits `#` itself (its escapes are \" \\ \n \uXXXX), so the
       replace only ever touches payload characters, and it is applied AFTER
       to_json so an escaped backslash still pairs correctly (`\#{` -> "\\\#{").

  Used for every credential-bearing or operator-supplied value below, and for
  the JSON arrays too — a Ruby array literal of double-quoted strings
  interpolates exactly the same way. (adguard_sync/immich/home_assistant already
  do the equivalent for their own config formats.)
#}
{%- macro rb(value) -%}
{{ value | to_json | replace('#', '\\#') }}
{%- endmacro %}

# =============================================================================
# Core Configuration
# =============================================================================

external_url '{{ gitlab_external_url }}'

# GitLab Rails configuration
gitlab_rails['gitlab_email_from'] = '{{ gitlab_email_from }}'
gitlab_rails['gitlab_email_display_name'] = '{{ gitlab_email_display_name }}'
gitlab_rails['gitlab_email_reply_to'] = '{{ gitlab_email_reply_to }}'

# Time zone
gitlab_rails['time_zone'] = 'America/Los_Angeles'

# =============================================================================
# SSH Configuration
# =============================================================================

# SSH host for clone URLs - use DNS-only hostname since Cloudflare won't proxy SSH
# This allows git.ericsweiss.com to remain proxied for web UI while SSH uses direct access
gitlab_rails['gitlab_ssh_host'] = '{{ gitlab_ssh_host }}'
gitlab_rails['gitlab_shell_ssh_port'] = {{ gitlab_ssh_port }}

# =============================================================================
# NGINX Configuration (for Traefik reverse proxy)
# =============================================================================

nginx['listen_https'] = {{ gitlab_nginx_listen_https | lower }}
nginx['listen_port'] = {{ gitlab_nginx_listen_port }}

{% if gitlab_nginx_listen_https %}
# TLS cert + key. Distributed and rotated by acme_certs on dns-01:
# /etc/gitlab/ssl/{fullchain,privkey}.pem are written every renewal,
# followed by `gitlab-ctl hup nginx` to reload.
nginx['ssl_certificate'] = '{{ gitlab_nginx_ssl_certificate }}'
nginx['ssl_certificate_key'] = '{{ gitlab_nginx_ssl_certificate_key }}'
# TLS 1.3-only floor (every consumer is Traefik, which speaks 1.3).
nginx['ssl_protocols'] = "{{ gitlab_nginx_ssl_protocols }}"
{% endif %}

# Trust Traefik proxy headers
nginx['real_ip_trusted_addresses'] = {{ rb(gitlab_nginx_real_ip_trusted_addresses) }}
nginx['real_ip_header'] = 'X-Forwarded-For'
nginx['real_ip_recursive'] = 'on'

# Tell GitLab that external traffic is HTTPS (via Traefik reverse proxy)
nginx['proxy_set_headers'] = {
  "X-Forwarded-Proto" => "https",
  "X-Forwarded-Ssl" => "on"
}

# =============================================================================
# Let's Encrypt (Disabled - Traefik handles TLS)
# =============================================================================

letsencrypt['enable'] = false
letsencrypt['auto_renew'] = false

# =============================================================================
# SMTP Configuration
# =============================================================================

{# Credential-bearing values go through rb() (see the macro at the top), never
   bare Ruby quotes — same for the SAML fingerprint below. #}
{% if gitlab_smtp_enabled %}
gitlab_rails['smtp_enable'] = true
gitlab_rails['smtp_address'] = '{{ gitlab_smtp_address }}'
gitlab_rails['smtp_port'] = {{ gitlab_smtp_port }}
gitlab_rails['smtp_user_name'] = {{ rb(gitlab_smtp_user) }}
gitlab_rails['smtp_password'] = {{ rb(gitlab_smtp_password) }}
gitlab_rails['smtp_domain'] = '{{ gitlab_smtp_domain }}'
gitlab_rails['smtp_authentication'] = '{{ gitlab_smtp_authentication }}'
gitlab_rails['smtp_enable_starttls_auto'] = {{ gitlab_smtp_enable_starttls_auto | lower }}
gitlab_rails['smtp_openssl_verify_mode'] = 'peer'
{% endif %}

# =============================================================================
# Container Registry
# =============================================================================

{% if gitlab_registry_enabled %}
registry_external_url '{{ gitlab_registry_external_url }}'
registry['enable'] = true
# TLS with the distributed wildcard cert so the Traefik->registry hop is
# encrypted (same posture as the web UI on 443).
registry_nginx['listen_https'] = true
registry_nginx['listen_port'] = 5050
registry_nginx['ssl_certificate'] = '{{ gitlab_nginx_ssl_certificate }}'
registry_nginx['ssl_certificate_key'] = '{{ gitlab_nginx_ssl_certificate_key }}'
registry_nginx['ssl_protocols'] = "{{ gitlab_nginx_ssl_protocols }}"
{% if gitlab_registry_data_dir != '/var/opt/gitlab/gitlab-rails/shared/registry' %}
# Registry blob store relocated off the OS disk onto the /mnt/gitlab-repos zvol
# (~7.5G, the largest component). Mirrors the Gitaly repo relocation above; the
# role moves the existing store once, then reconfigure repoints it here.
gitlab_rails['registry_path'] = '{{ gitlab_registry_data_dir }}'
{% endif %}
{% endif %}

# =============================================================================
# GitLab Pages
# =============================================================================

{% if gitlab_pages_enabled %}
pages_external_url '{{ gitlab_pages_external_url }}'
gitlab_pages['enable'] = true
# pages_nginx terminates TLS on 8443 with the distributed wildcard cert
# (encrypting the Traefik->pages hop) and proxies to the pages daemon,
# which binds localhost only.
gitlab_pages['listen_proxy'] = "localhost:8090"
pages_nginx['enable'] = true
pages_nginx['listen_port'] = 8443
pages_nginx['listen_https'] = true
pages_nginx['redirect_http_to_https'] = false
pages_nginx['ssl_certificate'] = '{{ gitlab_nginx_ssl_certificate }}'
pages_nginx['ssl_certificate_key'] = '{{ gitlab_nginx_ssl_certificate_key }}'
pages_nginx['ssl_protocols'] = "{{ gitlab_nginx_ssl_protocols }}"
{% endif %}

# =============================================================================
# SAML SSO (Authentik)
# =============================================================================

{% if gitlab_saml_enabled %}
gitlab_rails['omniauth_enabled'] = true
gitlab_rails['omniauth_allow_single_sign_on'] = ['saml']
gitlab_rails['omniauth_sync_email_from_provider'] = 'saml'
gitlab_rails['omniauth_sync_profile_from_provider'] = ['saml']
gitlab_rails['omniauth_sync_profile_attributes'] = ['email']
gitlab_rails['omniauth_block_auto_created_users'] = false
gitlab_rails['omniauth_auto_link_saml_user'] = true
gitlab_rails['omniauth_auto_sign_in_with_provider'] = 'saml'

gitlab_rails['omniauth_providers'] = [
  {
    name: "saml",
    label: "{{ gitlab_saml_label }}",
    icon: "https://auth.ericsweiss.com/static/dist/assets/icons/icon.svg",
    groups_attribute: "{{ gitlab_saml_groups_attribute }}",
{% if gitlab_saml_required_groups is defined and gitlab_saml_required_groups | length > 0 %}
    required_groups: {{ rb(gitlab_saml_required_groups) }},
{% endif %}
{% if gitlab_saml_admin_groups is defined and gitlab_saml_admin_groups | length > 0 %}
    admin_groups: {{ rb(gitlab_saml_admin_groups) }},
{% endif %}
{% if gitlab_saml_external_groups is defined and gitlab_saml_external_groups | length > 0 %}
    external_groups: {{ rb(gitlab_saml_external_groups) }},
{% endif %}
    args: {
      assertion_consumer_service_url: "{{ gitlab_external_url }}/users/auth/saml/callback",
      idp_cert_fingerprint: {{ rb(gitlab_saml_idp_cert_fingerprint) }},
      idp_sso_target_url: "{{ gitlab_saml_idp_sso_url }}",
      issuer: "{{ gitlab_external_url }}",
      name_identifier_format: "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
      attribute_statements: {
        email: ["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"],
        first_name: ["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname"],
        last_name: ["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname"],
        nickname: ["http://schemas.goauthentik.io/2021/02/saml/username"]
      }
    }
  }
]
{% endif %}

# =============================================================================
# Repository Storage Configuration (GitLab 18+)
# =============================================================================

{% if gitlab_git_data_dir != '/var/opt/gitlab/git-data' %}
# Custom repository storage on separate disk
# Provides better I/O isolation and independent sizing
# Note: GitLab 18+ requires gitaly['configuration'] instead of git_data_dirs
# The /repositories suffix is required (previously added internally)
gitaly['configuration'] = {
  storage: [
    {
      name: 'default',
      path: '{{ gitlab_git_data_dir }}/repositories',
    },
  ],
}
{% endif %}

# =============================================================================
# Backup Configuration
# =============================================================================

# backup_path is a root-squashed NFS mount, so chef's storage_directory resource
# cannot chown it as root and aborts the ENTIRE reconfigure with Errno::EPERM —
# every `gitlab-ctl reconfigure` on this host failed until this was set, which
# also meant a re-templated gitlab.rb was written but never applied. The export
# already creates the directory with the right ownership, so omnibus has nothing
# to manage. Deliberately not re-exporting no_root_squash, which would hand
# every NFS client root on the backup share.
gitlab_rails['manage_backup_path'] = false
gitlab_rails['backup_path'] = '{{ gitlab_backup_path }}'
gitlab_rails['backup_keep_time'] = {{ gitlab_backup_keep_time }}

# =============================================================================
# Performance Tuning
# =============================================================================

puma['worker_processes'] = {{ gitlab_puma_workers }}
sidekiq['concurrency'] = {{ gitlab_sidekiq_concurrency }}

# Reduce memory usage - disable unused services
prometheus_monitoring['enable'] = true
# Note: grafana was removed from GitLab omnibus in 16.0+

# =============================================================================
# Monitoring Endpoint (for health checks)
# =============================================================================

# Sourced from gitlab_monitoring_whitelist (defaults/main.yml) — the LAN /24
# (firewall-gated) plus the k3s pod CIDR. See that var for the real_ip
# mechanics: in-cluster verify probes reach here with a pod source IP when
# their runner pod shares a node with a Traefik replica.
gitlab_rails['monitoring_whitelist'] = {{ rb(gitlab_monitoring_whitelist) }}
