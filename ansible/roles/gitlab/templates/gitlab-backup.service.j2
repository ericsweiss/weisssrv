# {{ ansible_managed }}
[Unit]
Description=GitLab backup (tarball + gitlab-secrets.json + gitlab.rb, emits textfile metrics)
# Order after the omnibus supervisor so the backup runs against a live GitLab.
# Not a hard Requires: if GitLab is momentarily down the run just records
# success=0 (GitLabBackupFailed) rather than being cancelled.
After=gitlab-runsvdir.service network-online.target
Wants=network-online.target
{% if gitlab_backup_nfs_enabled | default(false) %}
# Offsite NFS landing zone: pull the mount on demand and order after it, so the
# backup never runs against an unmounted export (the in-script guard also fails
# closed if the mount is missing).
RequiresMountsFor={{ gitlab_backup_path }}
{% endif %}

[Service]
Type=oneshot
# Generous ceiling — a full DB+repos backup plus the offsite copy can run long.
TimeoutStartSec={{ gitlab_backup_service_timeout | default('3h') }}
ExecStart=/usr/local/sbin/gitlab-backup-run.sh
