# {{ ansible_managed }}
# Postfix master process configuration file

# ==========================================================================
# service type  private unpriv  chroot  wakeup  maxproc command + args
#               (yes)   (yes)   (no)    (never) (100)
# ==========================================================================
smtp      inet  n       -       y       -       -       smtpd
{% if smtp_submission_enabled | default(true) %}
submission inet n       -       n       -       -       smtpd
  -o syslog_name={{ smtp_submission_config.syslog_name | default('postfix/submission') }}
  -o smtpd_tls_security_level={{ smtp_submission_config.smtpd_tls_security_level | default('encrypt') }}
  -o smtpd_sasl_auth_enable={{ smtp_submission_config.smtpd_sasl_auth_enable | default('yes') }}
  -o smtpd_recipient_restrictions={{ smtp_submission_config.smtpd_recipient_restrictions | default('permit_sasl_authenticated,reject') }}
  -o milter_macro_daemon_name={{ smtp_submission_config.milter_macro_daemon_name | default('ORIGINATING') }}
{% endif %}
pickup    unix  n       -       y       60      1       pickup
cleanup   unix  n       -       y       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       y       1000?   1       tlsmgr
rewrite   unix  -       -       y       -       -       trivial-rewrite
bounce    unix  -       -       y       -       0       bounce
defer     unix  -       -       y       -       0       bounce
trace     unix  -       -       y       -       0       bounce
verify    unix  -       -       y       -       1       verify
flush     unix  n       -       y       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       y       -       -       smtp
relay     unix  -       -       y       -       -       smtp
        -o syslog_name=${multi_instance_name?{$multi_instance_name}:{postfix}}/$service_name
showq     unix  n       -       y       -       -       showq
error     unix  -       -       y       -       -       error
retry     unix  -       -       y       -       -       error
discard   unix  -       -       y       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       y       -       -       lmtp
anvil     unix  -       -       y       -       1       anvil
scache    unix  -       -       y       -       1       scache
postlog   unix-dgram n  -       n       -       1       postlogd
