# {{ ansible_managed }}
# Postfix SMTP Relay Configuration

smtpd_banner = $myhostname ESMTP $mail_name (Debian/GNU)
biff = no

# Append .domain is the MUA's job
append_dot_mydomain = no

alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
mydestination = {{ smtp_relay_config.mydestination | default('$myhostname, localhost.$mydomain, localhost') }}
relayhost = {{ smtp_relay_config.relayhost }}
mynetworks = {{ smtp_relay_config.mynetworks }}
inet_interfaces = {{ smtp_relay_config.inet_interfaces }}
recipient_delimiter = +

compatibility_level = 2

myhostname = {{ smtp_relay_config.myhostname }}
myorigin = {{ smtp_relay_config.myorigin }}
inet_protocols = {{ smtp_relay_config.inet_protocols }}
smtpd_relay_restrictions = {{ smtp_relay_config.smtpd_relay_restrictions }}

# TLS for incoming connections
smtpd_tls_cert_file = {{ smtp_relay_config.smtpd_tls_cert_file }}
smtpd_tls_key_file = {{ smtp_relay_config.smtpd_tls_key_file }}
smtpd_tls_security_level = {{ smtp_relay_config.smtpd_tls_security_level }}
smtpd_tls_loglevel = {{ smtp_relay_config.smtpd_tls_loglevel }}
smtpd_tls_received_header = {{ smtp_relay_config.smtpd_tls_received_header }}
smtpd_tls_protocols = {{ smtp_relay_config.smtpd_tls_protocols }}
smtpd_tls_mandatory_protocols = {{ smtp_relay_config.smtpd_tls_mandatory_protocols }}

# TLS for outgoing connections
smtp_tls_security_level = {{ smtp_relay_config.smtp_tls_security_level }}
smtp_tls_CAfile = {{ smtp_relay_config.smtp_tls_CAfile }}
smtp_tls_protocols = {{ smtp_relay_config.smtp_tls_protocols }}

# SASL authentication for Gmail relay
smtp_sasl_auth_enable = {{ smtp_relay_config.smtp_sasl_auth_enable }}
smtp_sasl_password_maps = {{ smtp_relay_config.smtp_sasl_password_maps }}
smtp_sasl_security_options = {{ smtp_relay_config.smtp_sasl_security_options }}
smtp_sasl_tls_security_options = {{ smtp_relay_config.smtp_sasl_tls_security_options }}

# SASL for incoming authentication
smtpd_sasl_type = {{ smtp_relay_config.smtpd_sasl_type }}
smtpd_sasl_path = {{ smtp_relay_config.smtpd_sasl_path }}
smtpd_sasl_security_options = {{ smtp_relay_config.smtpd_sasl_security_options }}
broken_sasl_auth_clients = {{ smtp_relay_config.broken_sasl_auth_clients }}
smtpd_sasl_auth_enable = {{ smtp_relay_config.smtpd_sasl_auth_enable }}
smtpd_tls_auth_only = {{ smtp_relay_config.smtpd_tls_auth_only | default('yes') }}
smtpd_sasl_local_domain = {{ smtp_relay_config.smtpd_sasl_local_domain }}
