# Managed by Ansible smtp_relay role.
# Fires the postfix queue collector every minute — the alert windows are
# tens of minutes, so minute granularity is ample, and OnUnitInactiveSec
# keeps sampling even after a failed oneshot run.
[Unit]
Description=Periodically sample the Postfix queue

[Timer]
OnBootSec=1min
OnUnitInactiveSec=1min
AccuracySec=10s
Unit=postfix-queue-collector.service

[Install]
WantedBy=timers.target
