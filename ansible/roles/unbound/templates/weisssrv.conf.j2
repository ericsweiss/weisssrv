# {{ ansible_managed }}
# Unbound configuration for weisssrv homelab

server:
  # listen only on loopback; AdGuard will be the LAN-facing DNS server
  interface: {{ unbound_interface }}
  port: {{ unbound_port }}
  do-ip4: yes
  do-ip6: yes
  do-udp: yes
  do-tcp: yes

  # performance tuning
  num-threads: {{ unbound_num_threads | default(2) }}
  msg-cache-size: {{ unbound_msg_cache_size | default('16m') }}
  rrset-cache-size: {{ unbound_rrset_cache_size | default('32m') }}
  outgoing-range: {{ unbound_outgoing_range | default(8192) }}
  num-queries-per-thread: {{ unbound_num_queries_per_thread | default(4096) }}
  so-reuseport: {{ 'yes' if (unbound_so_reuseport | default(true)) else 'no' }}

  # advanced features
  serve-expired: {{ 'yes' if (unbound_serve_expired | default(true)) else 'no' }}
  serve-expired-ttl: {{ unbound_serve_expired_ttl | default(86400) }}
  aggressive-nsec: {{ 'yes' if (unbound_aggressive_nsec | default(true)) else 'no' }}
  edns-buffer-size: {{ unbound_edns_buffer_size | default(1232) }}

  tls-cert-bundle: "/etc/ssl/certs/ca-certificates.crt"

  # privacy / hygiene
  hide-identity: yes
  hide-version: yes
  qname-minimisation: yes
  harden-glue: yes
  harden-dnssec-stripped: yes
  use-caps-for-id: yes
  prefetch: yes
  cache-min-ttl: 60
  cache-max-ttl: 86400

  # DNS rebinding protection: a public domain must never resolve to a
  # private/loopback address. Internal *.esweiss.com names are answered by
  # AdGuard rewrites before reaching unbound, so it never legitimately
  # returns these ranges.
  private-address: 10.0.0.0/8
  private-address: 172.16.0.0/12
  private-address: 192.168.0.0/16
  private-address: 127.0.0.0/8
  private-address: ::1
  private-address: fd00::/8
  private-address: fe80::/10

  # allow only local clients (loopback)
{% for acl in unbound_access_control %}
  access-control: {{ acl }}
{% endfor %}

forward-zone:
  name: "."
  forward-tls-upstream: yes
{% for forwarder in unbound_forwarders %}
  # {{ forwarder.name }}
  forward-addr: {{ forwarder.addr }}@{{ forwarder.port }}#{{ forwarder.name }}
{% endfor %}
