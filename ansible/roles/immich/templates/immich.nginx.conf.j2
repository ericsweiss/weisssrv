# {{ ansible_managed }}
# Host nginx: terminates 443 with the acme_certs-distributed *.esweiss.com
# wildcard and reverse-proxies to the immich-server container on loopback.
# Traefik reaches this over the LAN with serversTransport vm-tls-wildcard
# (SNI vm.esweiss.com), so the catch-all server_name is intentional.

map $http_upgrade $immich_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     {{ immich_nginx_ssl_cert }};
    ssl_certificate_key {{ immich_nginx_ssl_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Mobile/web uploads (and single-PUT WebDAV) can be large — no body cap.
    client_max_body_size 0;
    # Long timeouts so large uploads / long-running requests don't get cut.
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    # --- Real client IP resolution -----------------------------------------
    # Trust chain: client -> Traefik pod -> (k3s/flannel SNATs the pod source to
    # the k3s NODE IP, since this is a VM outside the pod network) -> this nginx
    # -> immich-server. Only the k3s node IPs are legitimate proxy sources, so
    # nginx trusts ONLY those (immich_nginx_real_ip_from) and walks Traefik's
    # X-Forwarded-For back to the true client. A directly connected LAN/admin
    # client (the firewall permits :443 for debugging / the bootstrap host) is
    # NOT a trusted source, so its inbound X-Forwarded-For is ignored and
    # $remote_addr stays its real address — a forged header cannot move the IP.
{% for src in immich_nginx_real_ip_from %}
    set_real_ip_from {{ src }};
{% endfor %}
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location / {
        proxy_pass http://127.0.0.1:{{ immich_server_listen_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $immich_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # REPLACE (not append) X-Forwarded-For with the real_ip-resolved client.
        # immich-server trusts only its immediate hop (this nginx, reached via
        # the compose bridge gateway = IMMICH_TRUSTED_PROXIES) and reads this
        # single authoritative value, so a spoofed upstream header can never be
        # walked back past nginx's resolved address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Stream uploads straight through instead of buffering multi-GB bodies.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_redirect off;
    }
}

# Anything hitting plain :80 on the VM directly is redirected to HTTPS.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}
