# {{ ansible_managed }}
[Unit]
Description=Immich nightly database backup (pg_dumpall)
Requires=docker.service
After=docker.service immich-compose.service
# Require the backup landing dir mounted before the dump runs — the app zvol by
# default, or the offsite NFS export (nofail, pulled on demand) when enabled.
RequiresMountsFor={{ immich_backup_dir }}

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/immich-backup-run.sh
