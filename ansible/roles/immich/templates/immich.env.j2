# {{ ansible_managed }}
# Compose environment for the Immich stack. Contains DB_PASSWORD — this file is
# rendered 0640 root:root with no_log. Managed by the immich Ansible role.
# (Image tags are pinned directly in docker-compose.yml — there is no
# ${IMMICH_VERSION} interpolation, so it is intentionally not set here.)

# Storage locations (host paths on the encrypted zvols)
UPLOAD_LOCATION={{ immich_upload_location }}
DB_DATA_LOCATION={{ immich_db_data_location }}

TZ={{ timezone }}

# Database (immich-server reads DB_* directly; the database service maps them to
# POSTGRES_*). DB_HOSTNAME/REDIS_HOSTNAME default to the compose service names
# (database/redis), so they are intentionally left unset.
#
# DB_PASSWORD is double-quoted with backslash, double-quote, and dollar-sign
# escaped so the compose-go dotenv parser treats it as a literal. An unquoted
# value is subject to `$`-interpolation (a generated password containing `$name`
# would be silently truncated/rewritten) and single quotes cannot hold an
# embedded `'`; double-quote + escape round-trips every character, so a
# 1Password-generated password with any special character reaches Postgres
# intact. DB_USERNAME/DB_DATABASE_NAME are fixed literals, left unquoted.
DB_PASSWORD="{{ immich_db_password | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') }}"
DB_USERNAME={{ immich_db_username }}
DB_DATABASE_NAME={{ immich_db_database_name }}
