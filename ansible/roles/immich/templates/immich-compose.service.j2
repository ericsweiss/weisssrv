# {{ ansible_managed }}
[Unit]
Description=Immich (docker compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# Never start the stack before its encrypted zvols are mounted — otherwise
# compose would write into the (unmounted) root filesystem. These map to the
# fstab-generated mount units for the app/postgres/library zvols.
RequiresMountsFor={{ immich_app_dir }} {{ immich_db_data_location }} {{ immich_data_dir }}

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory={{ immich_compose_dir }}
# `up -d` reconciles the running stack to the rendered compose/.env/config,
# recreating only the containers whose definition changed.
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecReload=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
