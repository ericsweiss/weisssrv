# {{ ansible_managed }}
# NFS exports configuration - see exports(5)
#
# Transport-layer encryption via NFSv4 + tlshd (opt-in). Two scopes:
#   - export.xprtsec  : applies to every client line of the export.
#   - client.xprtsec  : per-client override; takes precedence over the
#                       export-level value, including a falsy value to
#                       opt one client OUT.
# Production k3s lines use "tls" (require: reject plaintext). A client line
# with no xprtsec leaves the server at its default policy (none:tls:mtls),
# which accepts plaintext. This per-client granularity lets a shared export
# carry require-TLS k3s clients alongside a plaintext-only client (e.g.
# HAOS .154 on /export/media, which cannot speak xprtsec — see docs/24).
# The wire is encrypted by clients that MOUNT with xprtsec=tls (by
# hostname, so the *.esweiss.com cert verifies); requires the nfs_tls role
# active on the server AND on every client that mounts TLS.

{% for export in nfs_exports %}
{% set export_xprtsec = export.xprtsec | default('') %}
# {{ export.path }}{{ ' (xprtsec=' ~ export_xprtsec ~ ')' if export_xprtsec else '' }}
{{ export.path }} {% for client in export.clients %}{% if not loop.first %} \
        {% endif %}{% set client_xprtsec = client.xprtsec | default(export_xprtsec) %}{{ client.spec }}({{ client.options }}{% if client_xprtsec %},xprtsec={{ client_xprtsec }}{% endif %}){% endfor %}

{% endfor %}
