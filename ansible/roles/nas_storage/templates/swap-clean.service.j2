# {{ ansible_managed }}
[Unit]
Description=Reset accumulated NAS swap (near-capacity host)
After=zfs.target zfs-mount.service

[Service]
Type=oneshot
# Generous: the recovery path may gracefully shut down a heavy guest (GitLab can
# take minutes) before the swapoff. A systemd timeout still lands safely — the
# script traps TERM and its EXIT trap restarts every guest it stopped — but keep
# it well above the sum of the stop-guest timeouts so a legit reclaim is never cut
# short. Default 1200s covers immich(120) + gitlab(300) + swapoff + restarts.
TimeoutStartSec={{ nas_swap_clean_service_timeout | default(1200) }}
# Low priority — memory hygiene, never urgent. Same load-shaping as media-mover.
Nice={{ nas_swap_clean_nice | default(10) }}
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20
# Namespace-free hardening only: the script writes /sys/module/zfs/parameters
# and calls swapoff/swapon, so ProtectSystem/PrivateTmp (private mount ns) would
# break it — same constraint as media-mover.service.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ExecStart=/usr/local/sbin/swap-clean.sh
