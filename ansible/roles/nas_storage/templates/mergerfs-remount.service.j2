# {{ ansible_managed }}
[Unit]
Description=Remount MergerFS filesystems
After=local-fs.target

[Service]
Type=oneshot
# Only mount if not already mounted - prevents duplicate mount entries
ExecStart=/bin/bash -c 'for mnt in $(grep -E "fuse\\.mergerfs" /etc/fstab | awk "{print \\$2}"); do mountpoint -q "$mnt" || mount "$mnt"; done'
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
