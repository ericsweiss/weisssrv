#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Daily NAS swap reset. pve-nas-01 runs near memory capacity, so peak events
# (deploys, backups, ML batches, large uploads) force cold anonymous pages to
# swap that Linux never pages back in on its own. vm.swappiness=1 minimises the
# opportunistic parking but cannot prevent event-driven swap-out on a full box,
# and what lands in swap then only accumulates (it never self-clears). This job
# resets it: shrink ARC for headroom, swapoff -a / swapon -a, restore ARC.
#
# If the ARC-shrink headroom alone cannot safely cover the swap, it ESCALATES:
# it gracefully shuts down heavy guests from a configured candidate list (in
# order, only as many as needed), does the swapoff, and ALWAYS restarts every
# guest it stopped. Guests are only ever stopped GRACEFULLY (qm shutdown, never
# a hard kill); a guest that will not stop within its timeout aborts the reclaim
# rather than being forced, so a Postgres guest is never at risk. A single
# cleanup trap fires on ANY exit (success, error, or signal) and brings back
# every guest it touched, so a crash mid-reclaim can never leave one down. A
# guest it stopped but could not restart demotes the run to failed and is
# surfaced directly via swap_clean_guest_restart_failures. See docs/06.
#
# Two guards keep a reset from ever leaving the box swapless:
#   - PRE-FLIGHT skip: if any fstab swap device is absent (e.g. encrypted_swap
#     deferred to a reboot, where fstab names the not-yet-present cryptswap
#     mapper) OR restic-offsite is mid-run, this exits early as a deliberate
#     healthy no-op WITHOUT cycling swap.
#   - POST-SWAPON guard: after swapon -a, if no swap came back it tries the
#     backing device, and if swap is STILL absent records a FAILED run.
#
# Device-agnostic: swap usage is read from /proc/meminfo and swap is cycled with
# `swapoff -a` / `swapon -a` (never a hardcoded device), so this works unchanged
# against the encrypted-swap mapper (/dev/mapper/cryptswap, encrypted_swap role)
# once that is active after a reboot. The pre-flight skip covers the one-time
# pre-reboot window while activation is still deferred (see encrypted_swap README).
set -euo pipefail

# Jinja values are assigned to shell vars first (kept out of arithmetic contexts)
# so the *.sh.j2 shellcheck lint - which rewrites Jinja expressions to the literal
# token JINJA before shellcheck runs - sees an assigned variable rather than a
# bare undefined token.
min_clear_mb="{{ nas_swap_clean_min_mb | default(512) }}"
margin_mb="{{ nas_swap_clean_margin_mb | default(2048) }}"
arc_shrink_bytes="{{ (nas_swap_clean_arc_shrink_mb | default(2048)) * 1048576 }}"
# Ordered "vmid:name:timeout" candidates to gracefully stop (only as many as
# needed) when ARC-shrink headroom alone cannot cover the swap. Empty => never
# stops a guest (pure abort-and-retry, the pre-escalation behaviour).
stop_guests="{{ nas_swap_clean_stop_guests | default([]) | join(' ') }}"
# Last-resort swap device for the post-swapon guard (the standard Proxmox LVM
# swap LV; under encrypted_swap this is busy as the cryptswap backing device, so
# the fallback swapon is a harmless no-op there).
fallback_swap_dev="/dev/pve/swap"

log() { logger -t swap-clean "$*"; echo "swap-clean: $*"; }
field_kb() { awk -v k="$1:" '$1==k {print $2}' /proc/meminfo; }
# `qm status` failing (e.g. VM absent) must not trip set -e mid-pipe.
vm_state() { { qm status "$1" 2>/dev/null || true; } | awk '{print $2}'; }

# node_exporter textfile metrics (mirrors media-mover.sh). run_success defaults
# to 0 so an unexpected set -e death, signal, or unsafe abort records a FAILED
# run; the success branches below flip it to 1 and set swap_cleared_bytes.
# Emitted on EVERY exit by the cleanup() EXIT trap, so a single unsafe-abort
# night or a guest-stop escalation is directly alertable — not only via the
# indirect 2-day swap-build-up proxy.
PROM_DIR="/var/lib/node_exporter"
PROM_FILE="${PROM_DIR}/swap_clean.prom"
run_success=0
swap_cleared_bytes=0

write_prom_metrics() {
  local success="$1" cleared="$2" stopped="$3" restart_failed="${4:-0}"
  local ts tmp sval
  ts="$(date +%s)"
  tmp="${PROM_FILE}.$$"
  {
    echo "# HELP swap_clean_last_run_success Whether the last run succeeded (1=cleared/nothing-to-do/deliberate-skip, 0=failed or aborted-unsafe)"
    echo "# TYPE swap_clean_last_run_success gauge"
    echo "swap_clean_last_run_success ${success}"
    # Preserve the last-known success timestamp on a failed/aborted run so a
    # staleness alert measures time-since-last-success, not time-since-attempt.
    if [ "$success" -eq 1 ]; then
      sval="$ts"
    else
      sval="$(awk '/^swap_clean_last_success_timestamp_seconds/ {print $2}' "$PROM_FILE" 2>/dev/null || true)"
    fi
    if [ -n "$sval" ]; then
      echo "# HELP swap_clean_last_success_timestamp_seconds Unix timestamp of last successful run"
      echo "# TYPE swap_clean_last_success_timestamp_seconds gauge"
      echo "swap_clean_last_success_timestamp_seconds ${sval}"
    fi
    echo "# HELP swap_clean_swap_cleared_bytes Bytes of swap reclaimed by the last run (0 = nothing to do, skipped, or aborted)"
    echo "# TYPE swap_clean_swap_cleared_bytes gauge"
    echo "swap_clean_swap_cleared_bytes ${cleared}"
    echo "# HELP swap_clean_guests_stopped_count Guests gracefully stopped by the last run's escalation (0 = ARC-shrink headroom sufficed)"
    echo "# TYPE swap_clean_guests_stopped_count gauge"
    echo "swap_clean_guests_stopped_count ${stopped}"
    # Always emitted (0 when all stopped guests came back). >0 means a guest the
    # escalation stopped could not be restarted and needs a manual `qm start`.
    echo "# HELP swap_clean_guest_restart_failures Guests the escalation stopped but could not restart (0 = all recovered)"
    echo "# TYPE swap_clean_guest_restart_failures gauge"
    echo "swap_clean_guest_restart_failures ${restart_failed}"
  } > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  mv "$tmp" "$PROM_FILE" 2>/dev/null || rm -f "$tmp"
}

# Single cleanup trap: ensure every guest we tried to stop ends up RUNNING again
# (however we exit), restore ARC, then write the run's metrics. A guest is
# recorded in guests_to_restore BEFORE it is stopped, so an abort/crash/kill
# mid-reclaim can never strand it. A stopped guest that will not come back demotes
# the run to failed and increments swap_clean_guest_restart_failures. Installed
# (in main) BEFORE the below-threshold early exit so even a "nothing to do" night
# emits fresh metrics.
arc_path=/sys/module/zfs/parameters/zfs_arc_max
arc_orig=""
guests_to_restore=""
cleanup() {
  local v st stopped_count=0 restart_failed=0
  for v in $guests_to_restore; do
    stopped_count=$(( stopped_count + 1 ))
    st=$(vm_state "$v")
    if [ "$st" != "running" ]; then
      log "recovery: restarting VM $v (state=${st:-unknown})"
      if ! qm start "$v" >/dev/null 2>&1; then
        log "recovery: ERROR - qm start $v FAILED, VM $v needs a manual start"
        restart_failed=$(( restart_failed + 1 ))
      fi
    fi
  done
  # A guest we stopped that could not be brought back is a FAILED run.
  if [ "$restart_failed" -gt 0 ]; then run_success=0; fi
  if [ -n "$arc_orig" ]; then echo "$arc_orig" > "$arc_path" 2>/dev/null || true; fi
  write_prom_metrics "$run_success" "$swap_cleared_bytes" "$stopped_count" "$restart_failed"
}

# Pre-flight: is this a deliberate no-op night (skip the swap cycle entirely)?
# Prints a reason to skip, or nothing to proceed. Two skip conditions:
#   1. Any fstab swap device is absent — a swapoff -a / swapon -a would then
#      leave the box with ZERO swap (the encrypted_swap deferred-activation
#      window, where fstab names the not-yet-present /dev/mapper/cryptswap).
#   2. restic-offsite is mid-run (it chains ~07:15 off archive-backup, swap-clean
#      runs 07:00) — do not cycle swap out from under it.
preflight_skip_reason() {
  local dev fstype
  # fstab fields: <device> <mountpoint> <fstype> <options> <dump> <pass>.
  # Only a missing dm-crypt MAPPER is a healthy skip (the known
  # encrypted_swap deferred-activation window, resolved by the next reboot).
  # Any OTHER absent swap device is unexpected breakage: proceed into the
  # normal flow, whose post-swapon zero-swap guard demotes the run — a
  # healthy-forever skip here would mask a genuinely swapless box.
  while read -r dev _ fstype _; do
    case "$dev" in ''|'#'*) continue ;; esac
    [ "$fstype" = swap ] || continue
    case "$dev" in
      /dev/mapper/*)
        [ -e "$dev" ] || { echo "encrypted-swap mapper $dev pending activation reboot"; return 0; } ;;
    esac
  done < /etc/fstab
  # is-active non-zero also covers systemctl/D-Bus errors — deliberately
  # fail-open: scheduling (restic ~07:15+) is the primary separation and the
  # memory safety-gate below prevents harm; failing closed would let a broken
  # systemctl silently disable swap-clean forever.
  if systemctl is-active --quiet restic-offsite.service; then
    echo "restic-offsite.service active"
    return 0
  fi
  return 0
}

main() {
  trap cleanup EXIT
  trap 'exit' INT TERM

  local skip
  skip="$(preflight_skip_reason)"
  if [ -n "$skip" ]; then
    log "pre-flight skip (${skip}) — deliberate no-op, not cycling swap"
    run_success=1  # healthy: a skipped night is a no-op, not a failure
    swap_cleared_bytes=0
    exit 0
  fi

  local swap_used_kb min_clear_kb
  swap_used_kb=$(( $(field_kb SwapTotal) - $(field_kb SwapFree) ))
  min_clear_kb=$(( min_clear_mb * 1024 ))
  if [ "$swap_used_kb" -lt "$min_clear_kb" ]; then
    log "swap ${swap_used_kb}KB below ${min_clear_kb}KB threshold - nothing to do"
    run_success=1  # healthy: little/no swap present, nothing to reclaim
    exit 0
  fi

  # Shrink ARC to free headroom for the swapoff.
  if [ -w "$arc_path" ]; then
    arc_orig=$(cat "$arc_path")
    echo "$arc_shrink_bytes" > "$arc_path"
    sleep 5
  fi

  local avail_kb margin_kb need_kb entry vmid gtimeout _mid gname st
  avail_kb=$(field_kb MemAvailable)
  margin_kb=$(( margin_mb * 1024 ))
  need_kb=$(( swap_used_kb + margin_kb ))

  # If ARC-shrink headroom is not enough, escalate: gracefully stop candidate
  # guests in order until MemAvailable covers the swap. cleanup() restarts them.
  if [ "$avail_kb" -lt "$need_kb" ] && [ -n "$stop_guests" ]; then
    log "ARC-shrink headroom ${avail_kb}KB < needed ${need_kb}KB - escalating to guest stop"
    # shellcheck disable=SC2086  # deliberate word-split of the space-joined list
    for entry in $stop_guests; do
      [ "$avail_kb" -ge "$need_kb" ] && break
      vmid="${entry%%:*}"
      gtimeout="${entry##*:}"
      _mid="${entry#*:}"
      gname="${_mid%:*}"
      st=$(vm_state "$vmid")
      if [ "$st" != "running" ]; then
        log "recovery: VM $vmid ($gname) not running (state=${st:-unknown}) - skipping"
        continue
      fi
      # Mark for restart BEFORE stopping, so any later failure still brings it back.
      guests_to_restore="$guests_to_restore $vmid"
      log "recovery: gracefully stopping VM $vmid ($gname), timeout ${gtimeout}s"
      if qm shutdown "$vmid" --timeout "$gtimeout" >/dev/null 2>&1; then
        sleep 5
        avail_kb=$(field_kb MemAvailable)
        log "recovery: VM $vmid stopped - MemAvailable now ${avail_kb}KB (need ${need_kb}KB)"
      else
        log "recovery: VM $vmid ($gname) did not shut down gracefully within ${gtimeout}s - NOT forcing; aborting reclaim (cleanup restarts it)"
        exit 0  # run_success stays 0 (aborted-unsafe) — surfaces via the metric
      fi
    done
  fi

  # Final safety gate: only swapoff if the freed RAM comfortably covers the swap;
  # otherwise pulling it all back could OOM the guests.
  if [ "$avail_kb" -lt "$need_kb" ]; then
    log "ABORT: MemAvailable ${avail_kb}KB < swap ${swap_used_kb}KB + ${margin_kb}KB margin - unsafe, skipping (cleanup restarts any stopped guests)"
    exit 0  # run_success stays 0 (aborted-unsafe) — surfaces via the metric
  fi

  log "resetting ${swap_used_kb}KB swap (MemAvailable ${avail_kb}KB)"
  # rc-captured: the script runs under set -e, so bare swapoff/swapon calls
  # would exit on failure BEFORE the post-swapon guard below — which is the
  # single arbiter of whether the box ended up with active swap (it attempts
  # the fallback device and records a FAILED run if swap is gone). Capture the
  # rcs so every failure mode flows into that guard instead of bypassing it.
  local swapoff_rc=0 swapon_rc=0
  swapoff -a || swapoff_rc=$?
  swapon -a || swapon_rc=$?
  if [ "$swapoff_rc" -ne 0 ] || [ "$swapon_rc" -ne 0 ]; then
    log "swap cycle returned non-zero (swapoff rc=${swapoff_rc}, swapon rc=${swapon_rc}) - verifying swap before recording the failure"
  fi

  # POST-SWAPON guard: swapon -a must leave swap active. If SwapTotal is 0 (an
  # fstab swap line the pre-flight didn't catch, a mkswap race), fall back to the
  # standard backing device, and if swap is STILL absent record a FAILED run
  # (SwapCleanFailed) rather than silently leaving the box swapless.
  if [ "$(field_kb SwapTotal)" -eq 0 ]; then
    log "post-swapon: SwapTotal=0 after swapon -a - attempting ${fallback_swap_dev} fallback"
    if [ -e "$fallback_swap_dev" ]; then swapon "$fallback_swap_dev" 2>/dev/null || true; fi
    if [ "$(field_kb SwapTotal)" -eq 0 ]; then
      log "post-swapon: swap STILL 0 after fallback - recording FAILED run (box has no swap)"
      exit 1  # run_success stays 0 -> SwapCleanFailed; cleanup restarts guests + writes metrics
    fi
  fi

  # Swap is ACTIVE again, but a non-zero swapoff/swapon means the reclaim did
  # not fully complete (e.g. a busy page set swapoff couldn't move): recording
  # success here would claim swap_cleared_bytes that never cleared. Failed run;
  # cleanup still restarts guests + restores ARC.
  if [ "$swapoff_rc" -ne 0 ] || [ "$swapon_rc" -ne 0 ]; then
    log "swap cycle incomplete (swapoff rc=${swapoff_rc}, swapon rc=${swapon_rc}) - swap active but reclaim did not complete; recording FAILED run"
    exit 1
  fi

  run_success=1
  swap_cleared_bytes=$(( swap_used_kb * 1024 ))
  log "done - swap cleared${guests_to_restore:+; restarting stopped guests}"
  # cleanup (EXIT trap) restarts any stopped guests + restores ARC
}

main "$@"
