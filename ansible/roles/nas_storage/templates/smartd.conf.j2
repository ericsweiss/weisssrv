# {{ ansible_managed }}
# SMART monitoring configuration for {{ ansible_facts['hostname'] }}

# All drives explicitly listed below — no DEVICESCAN.
# DEVICESCAN with -n standby was interfering with long self-tests
# (extended tests aborted at 90% when drives entered standby).
#
# TRADE-OFF: because the disk list is static, a drive added or replaced in a
# pool is UNMONITORED until it is also added to the matching smartd_*_disks
# inventory list (host_vars). Nothing detects the gap. Update smartd_*_disks on
# every drive replacement (drive swaps are a recurring op on the archive pool).

# Long self-tests are staggered per pool (8th/9th/10th/11th at 3am) so 14
# drives don't thrash simultaneously — the archive bay already runs hot.

# Tank pool (raidz2 - 6x 22TB enterprise drives)
{% for disk in smartd_tank_disks | default([]) %}
{{ disk }} -a -o on -S on -s (S/../.././02|L/../08/./03) -m root
{% endfor %}

# SSD pool (raidz1 - 3x 4TB Samsung SSDs)
{% for disk in smartd_ssd_disks | default([]) %}
{{ disk }} -a -o on -S on -s (S/../.././02|L/../09/./03) -m root
{% endfor %}

# NVMe devices (special/cache/fast storage). The ATA-only -o/-S flags do
# not apply to NVMe and make smartd log warnings.
{% for disk in smartd_nvme_disks | default([]) %}
{{ disk }} -a -s (S/../.././02|L/../10/./03) -m root
{% endfor %}

# Archive pool (raidz1 - 4x 6TB drives) - if defined
{% for disk in smartd_archive_disks | default([]) %}
{{ disk }} -a -o on -S on -s (S/../.././02|L/../11/./03) -m root
{% endfor %}

# SMART test schedule:
#   S = Short self-test, daily at 2am
#   L = Long self-test, monthly at 3am on the pool's staggered day
# Flags: -a monitor all attributes; -o/-S ATA offline-collection and
# attribute autosave (ATA drives only); -m root mails alerts via postfix.
