#!/usr/bin/env bash
# {{ ansible_managed }}
# Move completed downloads from fast NVMe tier to archival HDD tier

set -euo pipefail

SRC="{{ media_mover_src }}"
DST="{{ media_mover_dst }}"
LOCK="/run/media-mover.lock"

# examples: 6h, 12h, 1d, 30m
MIN_AGE="${MIN_AGE:-{{ media_mover_min_age | default('12h') }}}"
DRY_RUN="${DRY_RUN:-0}"

PROM_DIR="/var/lib/node_exporter"
PROM_FILE="${PROM_DIR}/media_mover.prom"
_MM_START_TS="$(date +%s)"

write_prom_metrics() {
  local success="$1" duration="$2"
  local ts
  ts="$(date +%s)"
  local tmp="${PROM_FILE}.$$"
  {
    echo "# HELP media_mover_last_run_duration_seconds Duration of last run"
    echo "# TYPE media_mover_last_run_duration_seconds gauge"
    echo "media_mover_last_run_duration_seconds ${duration}"
    echo "# HELP media_mover_last_run_success Whether the last run succeeded (1=success, 0=failure)"
    echo "# TYPE media_mover_last_run_success gauge"
    echo "media_mover_last_run_success ${success}"
    if [ "$success" -eq 1 ]; then
      echo "# HELP media_mover_last_success_timestamp_seconds Unix timestamp of last successful run"
      echo "# TYPE media_mover_last_success_timestamp_seconds gauge"
      echo "media_mover_last_success_timestamp_seconds ${ts}"
    fi
  } > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  mv "$tmp" "$PROM_FILE" 2>/dev/null || rm -f "$tmp"
}

trap_write_failure_metrics() {
  local end_ts
  end_ts="$(date +%s)"
  local duration=$(( end_ts - _MM_START_TS ))
  write_prom_metrics 0 "$duration"
}
trap 'rc=$?; if [ "$rc" -ne 0 ]; then trap_write_failure_metrics; fi' EXIT

parse_age_to_minutes() {
  local s="$1"
  if [[ "$s" =~ ^([0-9]+)([smhd])$ ]]; then
    local n="${BASH_REMATCH[1]}"
    local u="${BASH_REMATCH[2]}"
    case "$u" in
      s) echo $(( (n + 59) / 60 )) ;;   # round seconds up to 1 minute
      m) echo "$n" ;;
      h) echo $(( n * 60 )) ;;
      d) echo $(( n * 24 * 60 )) ;;
    esac
  else
    echo "Bad MIN_AGE format: '$s' (use like 30m, 12h, 1d)" >&2
    exit 2
  fi
}

[[ -d "$SRC" ]] || { echo "SRC missing: $SRC"; exit 1; }
[[ -d "$DST" ]] || { echo "DST missing: $DST"; exit 1; }

exec 9>"$LOCK"
flock -n 9 || { echo "media-mover already running"; exit 0; }

AGE_MINUTES="$(parse_age_to_minutes "$MIN_AGE")"

RSYNC_FLAGS=(-aHAX --numeric-ids --remove-source-files --info=stats2)
if [[ "$DRY_RUN" == "1" ]]; then
  RSYNC_FLAGS+=(--dry-run -v)
fi

# Build a list of files older than MIN_AGE and move only those.
# Use relative paths so directory structure is preserved.
cd "$SRC"
# If there are no eligible files, exit cleanly
if ! find . -type f -mmin +"$AGE_MINUTES" -print0 | \
  rsync "${RSYNC_FLAGS[@]}" --from0 --files-from=- --relative ./ "$DST/"; then
  exit 1
fi

# Clean up empty directories left behind (keep SRC root)
find "$SRC" -mindepth 1 -type d -empty -print -delete

# Write Prometheus textfile metrics on success
_MM_END_TS="$(date +%s)"
_MM_DURATION=$(( _MM_END_TS - _MM_START_TS ))
write_prom_metrics 1 "$_MM_DURATION"
