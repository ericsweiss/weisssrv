#!/usr/bin/env bash
# {{ ansible_managed }}
# Nightly tar of /etc/pve (pmxcfs) into the offsite-eligible logical-dump landing
# zone, so it rides the archsync file walk into restic B2.
#
# WHY: vzdump captures GUESTS, not the cluster filesystem. Ansible codifies the
# firewall (proxmox_firewall), storage.cfg + jobs.cfg (proxmox_backup) and HA
# (proxmox_ha), but NOT user.cfg (PVE users/ACLs/API tokens), corosync.conf, or
# priv/ (the cluster CA pve-root-ca.pem + key, node certs, authkey.pub). Without
# this, a total-cluster loss means rebuilding the PVE cluster IDENTITY from
# scratch — every API token reissued, every node re-added, every ACL retyped.
# pmxcfs is cluster-shared, so taking it from this one node covers the cluster.
#
# The archive holds private key material (priv/), which is why the landing dir
# and every archive are root-only 0700/0600. At rest they are on the aes-256-gcm
# tank/backups dataset and reach B2 only inside the restic repo's own crypto.
{% raw %}
set -Eeuo pipefail
export LC_ALL=C
{% endraw %}
SRC="{{ nas_pve_cluster_backup_src | default('/etc/pve') }}"
DEST_DIR="{{ nas_backup_apps_base }}/pve-cluster"
# The dataset that must be MOUNTED before anything is written under it, and
# whether to enforce that (0 only where the path is not a mount by design —
# molecule; see nas_backup_require_mounted_dataset).
BACKUPS_MOUNT="{{ nas_backup_apps_base | dirname }}"
REQUIRE_MOUNT={{ '1' if (nas_backup_require_mounted_dataset | default(true) | bool) else '0' }}
# Same question on the SOURCE side: /etc/pve is the pmxcfs FUSE mountpoint, and
# whether to require it to be mounted (0 only where SRC is a synthetic tree by
# design — molecule; see nas_pve_cluster_backup_require_src_mount).
REQUIRE_SRC_MOUNT={{ '1' if (nas_pve_cluster_backup_require_src_mount | default(true) | bool) else '0' }}
KEEP="{{ nas_pve_cluster_backup_keep | default(14) }}"
PROM_DIR="{{ nas_backup_artifact_metrics_dir | default(node_exporter_host_textfile_dir | default('/var/lib/node_exporter')) }}"
{% raw %}
PROM_FILE="${PROM_DIR}/pve_cluster_backup.prom"

log() { echo "[$(date -Is)] $*"; }

run_success=0
run_size=0
_START_TS="$(date +%s)"

write_prom_metrics() {
  local ts tmp prev newest
  ts="$(date +%s)"
  tmp="${PROM_FILE}.$$"
  # Size the newest EXISTING archive, not just this run's own output. A
  # transient tar/chmod/mv failure would otherwise report 0 bytes while 14 good
  # archives sit in the landing zone, firing BackupArtifactEmpty (critical),
  # whose runbook describes a wrong-BACKUP_PATH fault this producer cannot
  # have. run_success=0 stays the failure signal; 0 bytes now means what the
  # alert says it means — no artefact exists at all. Same convention as
  # gitlab-backup-run.sh (sizes the newest tarball unconditionally) and the
  # compose_app wrappers (pass their artefact glob to write_prom_metrics).
  if [ "$run_size" -eq 0 ]; then
    # shellcheck disable=SC2012 # ls -t for mtime order; names are generated + safe
    newest="$(ls -1t "${DEST_DIR}"/etc-pve-*.tar.gz 2>/dev/null | head -1 || true)"
    if [ -n "$newest" ] && [ -f "$newest" ]; then
      run_size="$(stat -c %s "$newest" 2>/dev/null || echo 0)"
    fi
  fi
  {
    echo "# HELP pve_cluster_backup_last_run_success Whether the last /etc/pve archive run succeeded (1=success, 0=failure)"
    echo "# TYPE pve_cluster_backup_last_run_success gauge"
    echo "pve_cluster_backup_last_run_success ${run_success}"
    echo "# HELP pve_cluster_backup_last_run_duration_seconds Duration of the last /etc/pve archive run"
    echo "# TYPE pve_cluster_backup_last_run_duration_seconds gauge"
    echo "pve_cluster_backup_last_run_duration_seconds $(( ts - _START_TS ))"
    # Named *_backup_last_size_bytes so it inherits the BackupArtifactEmpty
    # alert: a "successful" run that produced a 0-byte archive is a failure.
    echo "# HELP pve_cluster_backup_last_size_bytes Size of the most recent /etc/pve archive in bytes (0 = none)"
    echo "# TYPE pve_cluster_backup_last_size_bytes gauge"
    echo "pve_cluster_backup_last_size_bytes ${run_size}"
    # Preserve the last-known success timestamp on failure so staleness measures
    # time-since-last-success, not time-since-last-attempt (same contract as the
    # gitlab/immich/nextcloud wrappers).
    if [ "$run_success" -eq 1 ]; then
      echo "# HELP pve_cluster_backup_last_success_timestamp_seconds Unix timestamp of the last successful /etc/pve archive"
      echo "# TYPE pve_cluster_backup_last_success_timestamp_seconds gauge"
      echo "pve_cluster_backup_last_success_timestamp_seconds ${ts}"
    else
      prev="$(awk '/^pve_cluster_backup_last_success_timestamp_seconds/ {print $2}' "$PROM_FILE" 2>/dev/null || true)"
      if [ -n "$prev" ]; then
        echo "# HELP pve_cluster_backup_last_success_timestamp_seconds Unix timestamp of the last successful /etc/pve archive"
        echo "# TYPE pve_cluster_backup_last_success_timestamp_seconds gauge"
        echo "pve_cluster_backup_last_success_timestamp_seconds ${prev}"
      fi
    fi
  } > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  mv "$tmp" "$PROM_FILE" 2>/dev/null || rm -f "$tmp"
}

cleanup() { write_prom_metrics; }
trap cleanup EXIT

mkdir -p "$PROM_DIR"

if [ ! -d "$SRC" ]; then
  log "source ${SRC} is absent — not a PVE cluster member; nothing to archive"
  exit 1
fi

# Fail closed on an unmounted SOURCE, the mirror of the landing-zone guard
# below. /etc/pve is pmxcfs, a FUSE mount: when pve-cluster.service is not
# running (crash, boot race, corosync quorum loss) the path still EXISTS as an
# empty plain directory, and every check downstream passes on it — tar exits 0,
# the archive is non-empty (112 bytes of gzip framing) and `tar -tzf` reads it
# fine. The run would publish that as the night's cluster-identity backup,
# report success=1 with a non-zero size, and refresh the artefact mtime, so
# BackupArtifactEmpty and BackupArtifactStale both stay green — while retention
# retires one real archive per night behind it. The tar must not start.
if [ "$REQUIRE_SRC_MOUNT" = "1" ] && ! mountpoint -q "$SRC"; then
  log "source ${SRC} is not a mounted pmxcfs — refusing to archive an empty mountpoint over the good archives"
  exit 1
fi

# Fail closed on an unmounted landing zone — the SAME runtime guard
# gitlab-backup-run.sh applies to its NFS BACKUP_PATH, and the runtime half of
# the deploy-time `mountpoint -q` in tasks/pve_cluster_backup.yml. `tank` itself
# has mountpoint=none, so /mnt/tank/backups is a plain directory on the root
# filesystem whenever the dataset is not mounted (the documented 2026-06-26
# key-load failure; the unit's `Wants=zfs-mount-encrypted.service` does not
# block, and the timer's Persistent=true fires it on boot). Without this the
# script would mkdir the landing dir there, write /etc/pve — priv/ included —
# onto an unencrypted, unreplicated, never-offsited path, and still report
# success: the artefact-mtime collector reads the same shadowed directory, so
# BackupArtifactStale{app="pve-cluster"} would stay green too. The shadowed
# archives would then be orphaned under the mountpoint once tank/backups
# returns — invisible to the KEEP retention, which only sees the mounted view.
if [ "$REQUIRE_MOUNT" = "1" ] && ! mountpoint -q "$BACKUPS_MOUNT"; then
  log "landing zone ${BACKUPS_MOUNT} is not a mounted dataset — refusing to archive ${SRC} onto the root filesystem"
  exit 1
fi

# The landing dir must NOT be group/world readable: the archive contains
# /etc/pve/priv (cluster CA key, node certs, authkey).
mkdir -p "$DEST_DIR"
chown root:root "$DEST_DIR"
chmod 0700 "$DEST_DIR"

out="${DEST_DIR}/etc-pve-$(date +%Y%m%d-%H%M%S).tar.gz"
tmp="${out}.tmp"

# pmxcfs is a FUSE filesystem: file sizes can change under tar, and tar's
# "file changed as we read it" is exit 1 with a valid archive. Only a hard
# failure (exit >1) is fatal. -C / with a relative path so the archive unpacks
# predictably. --warning=no-file-changed keeps the log clean.
rc=0
tar --warning=no-file-changed -czf "$tmp" -C / "${SRC#/}" || rc=$?
if [ "$rc" -gt 1 ]; then
  log "tar failed (rc=${rc}) archiving ${SRC}"
  rm -f "$tmp"
  exit 1
fi

# A 0-byte or unreadable archive is a failure, not a success.
if [ ! -s "$tmp" ]; then
  log "produced an empty archive — refusing to publish it"
  rm -f "$tmp"
  exit 1
fi
if ! tar -tzf "$tmp" >/dev/null 2>&1; then
  log "produced an unreadable archive — refusing to publish it"
  rm -f "$tmp"
  exit 1
fi

chmod 0600 "$tmp"
mv "$tmp" "$out"
run_size="$(stat -c %s "$out" 2>/dev/null || echo 0)"
log "wrote ${out} (${run_size} bytes)"

# Retention: keep the newest $KEEP archives. Names are timestamped (no spaces),
# so the glob + ls sort is safe.
# shellcheck disable=SC2012 # ls -t for mtime order; names are generated + safe
ls -t "${DEST_DIR}"/etc-pve-*.tar.gz 2>/dev/null | tail -n "+$(( KEEP + 1 ))" | while IFS= read -r old; do
  [ -n "$old" ] || continue
  rm -f -- "$old"
  log "pruned ${old}"
done

run_success=1
{% endraw %}
