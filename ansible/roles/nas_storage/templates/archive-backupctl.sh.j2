#!/usr/bin/env bash
# {{ ansible_managed }}
{% raw %}
set -Eeuo pipefail

POOL_DST="archive"
RESTORE_BASE="/mnt/restore"
SNAP_PREFIX="archsync"
{% endraw %}
# Archive scrub timer. plug/plug-arm enable it and unplug disables it, so scrub
# coverage tracks pool presence instead of storage-deploy timing (the Ansible
# enable in zfs.yml fires only when the pool happens to be imported during a
# deploy). The schedule token must match the zfs-scrub-<schedule>@ units
# zfsutils-linux ships and zfs.yml enables.
SCRUB_TIMER="zfs-scrub-{{ zfs_scrub_schedule | default('monthly') }}@archive.timer"
{% raw %}

# Retention:
# - Keep the newest N snapshots always
# - Plus keep the newest snapshot from the last M months (grandfather)
KEEP_RECENT=3
KEEP_MONTHLY=6

# vzdump-overrun guard (see replicate_one). tank/proxmox is the cluster-wide
# vzdump target: remote PVE nodes write dumps into it over NFS, so a local
# pgrep can't see an in-flight backup and the 05:00 archsync snapshot could
# capture a half-written .vma. Before snapshotting that ONE dataset, wait
# (bounded) for writes under its mountpoint to quiesce — no file modified within
# the last VZDUMP_QUIESCE_MIN minutes — giving up (and skipping it for this run)
# after VZDUMP_MAX_WAIT_MIN. Other datasets are unaffected.
VZDUMP_TARGET="tank/proxmox"
VZDUMP_QUIESCE_MIN=10
VZDUMP_MAX_WAIT_MIN=30

# Datasets to replicate (recursive: includes children). tank/immich-data is the
# (currently empty) store for the planned Immich; it is encrypted at source.
# ssd/pve (the GitLab VM disks) is intentionally NOT here — those disks are
# already captured by the nightly vzdump of every VM into tank/proxmox, which
# this script also replicates, so a direct ssd/pve copy would just double-store
# them.
# INVARIANT: each SRC_LIST ROOT must be a filesystem (zvols are fine as CHILDREN,
# where -R never targets them with -o mountpoint/canmount). A top-level zvol here
# would be rejected by the RECV_SAFE_OPTS receive in the -R/resume paths, not just
# the re-seed loop (which type-splits per dataset and would handle it).
SRC_LIST=(
  "tank/share"
  "tank/backups"
  "tank/nextcloud-data"
  "tank/proxmox"
  "tank/immich-data"
  "ssd/appdata"
  "ssd/databases"
)

# MAP/RMAP are derived, never hand-maintained: every backup lands at
# ${POOL_DST}/<basename of the source>. The lock list and the restore targets
# are derived from the same arrays, so adding a dataset to SRC_LIST is the
# ONLY edit. Duplicate basenames would collide on one archive dataset — fail
# loudly before any zfs command can run.
declare -A MAP=() RMAP=()
for _src in "${SRC_LIST[@]}"; do
  _dst="${POOL_DST}/${_src##*/}"
  if [[ -n "${RMAP[$_dst]:-}" ]]; then
    echo "FATAL: duplicate SRC_LIST basename: ${_src} collides with ${RMAP[$_dst]} on ${_dst}" >&2
    exit 1
  fi
  MAP["$_src"]="$_dst"
  RMAP["$_dst"]="$_src"
done
unset _src _dst

PROM_DIR="/var/lib/node_exporter"
PROM_FILE="${PROM_DIR}/archive_backup.prom"

log() { echo "[$(date -Is)] $*"; }

# Write Prometheus textfile metrics for node_exporter scraping
write_prom_metrics() {
  local success="$1" duration="$2"
  local ts
  ts="$(date +%s)"
  local tmp="${PROM_FILE}.$$"
  {
    echo "# HELP archive_backup_last_run_duration_seconds Duration of last backup run"
    echo "# TYPE archive_backup_last_run_duration_seconds gauge"
    echo "archive_backup_last_run_duration_seconds ${duration}"
    echo "# HELP archive_backup_last_run_success Whether the last run succeeded (1=success, 0=failure)"
    echo "# TYPE archive_backup_last_run_success gauge"
    echo "archive_backup_last_run_success ${success}"
    if [ "$success" -eq 1 ]; then
      echo "# HELP archive_backup_last_success_timestamp_seconds Unix timestamp of last successful backup"
      echo "# TYPE archive_backup_last_success_timestamp_seconds gauge"
      echo "archive_backup_last_success_timestamp_seconds ${ts}"
    else
      # Preserve the last-known success timestamp so the staleness alert
      # measures time-since-last-success, not time-since-last-attempt.
      local prev
      prev="$(awk '/^archive_backup_last_success_timestamp_seconds/ {print $2}' "$PROM_FILE" 2>/dev/null || true)"
      if [ -n "$prev" ]; then
        echo "# HELP archive_backup_last_success_timestamp_seconds Unix timestamp of last successful backup"
        echo "# TYPE archive_backup_last_success_timestamp_seconds gauge"
        echo "archive_backup_last_success_timestamp_seconds ${prev}"
      fi
    fi
  } > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  mv "$tmp" "$PROM_FILE" 2>/dev/null || rm -f "$tmp"
}

# On failure, write metrics with success=0 (preserve last-known timestamp)
trap_write_failure_metrics() {
  [[ "${_BACKUP_METRICS_ACTIVE:-0}" -eq 1 ]] || return 0
  local end_ts
  end_ts="$(date +%s)"
  local duration=$(( end_ts - _BACKUP_START_TS ))
  write_prom_metrics 0 "$duration"
}
_BACKUP_START_TS="$(date +%s)"
_BACKUP_METRICS_ACTIVE=0
trap trap_write_failure_metrics ERR

need_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "Run as root (e.g. sudo -i then archive-backupctl ...)" >&2
    exit 1
  fi
}

pool_present() { zpool list -H -o name "${POOL_DST}" >/dev/null 2>&1; }
dataset_present() { zfs list -H -o name "$1" >/dev/null 2>&1; }

# --- LOCKDOWN / SAFETY -------------------------------------------------------

# Force backup tree into a safe, non-mountable, read-only state.
lock_backup_tree() {
  local root="$1"
  dataset_present "$root" || return 0

  zfs set mountpoint=none "$root" >/dev/null 2>&1 || true
  zfs set canmount=off "$root"   >/dev/null 2>&1 || true
  zfs set readonly=on "$root"    >/dev/null 2>&1 || true

  # `zfs inherit` (there is no `zfs set mountpoint=inherit`) so children track
  # the root's mountpoint=none; `|| true` — zvol children reject mountpoint.
  while IFS= read -r child; do
    zfs inherit mountpoint "$child" >/dev/null 2>&1 || true
    zfs set canmount=off "$child"   >/dev/null 2>&1 || true
    zfs set readonly=on "$child"    >/dev/null 2>&1 || true
  done < <(zfs list -H -o name -r "$root" | tail -n +2)

  zfs unmount -r "$root" >/dev/null 2>&1 || true
}

# Allow receives to write (still never mount anywhere).
unlock_for_receive() {
  local root="$1"
  dataset_present "$root" || return 0

  zfs set mountpoint=none "$root" >/dev/null 2>&1 || true
  zfs set canmount=off "$root"    >/dev/null 2>&1 || true
  zfs set readonly=off "$root"    >/dev/null 2>&1 || true

  while IFS= read -r child; do
    zfs inherit mountpoint "$child" >/dev/null 2>&1 || true
    zfs set canmount=off "$child"   >/dev/null 2>&1 || true
    zfs set readonly=off "$child"   >/dev/null 2>&1 || true
  done < <(zfs list -H -o name -r "$root" | tail -n +2)

  zfs unmount -r "$root" >/dev/null 2>&1 || true
}

# --- ATOMIC RECEIVE SAFETY ---------------------------------------------------
# Forces every received dataset to land with a safe mountpoint so it can never
# temporarily inherit a dangerous one (e.g. capturing a live path) during the
# receive.
RECV_SAFE_OPTS=( -o mountpoint=none -o canmount=off -o readonly=on )

maybe_resume_receive() {
  local dst="$1"
  dataset_present "$dst" || return 0

  # An interrupted recursive (-R) receive leaves the resume token on the
  # dataset that was mid-stream — usually a CHILD, not the root — so enumerate
  # tokens across the whole tree and resume each one into ITS dataset.
  local ds tok dtype found=0
  local -a recv_opts
  while IFS=$'\t' read -r ds tok; do
    [[ -n "$tok" && "$tok" != "-" ]] || continue
    if [[ "$found" -eq 0 ]]; then
      unlock_for_receive "$dst"
      found=1
    fi
    log "Resuming interrupted receive into ${ds}"
    # Same zvol/filesystem split as the re-seed loop: a resume stream targets
    # $ds directly and zfs rejects -o mountpoint/canmount on a volume.
    dtype="$(zfs get -H -o value type "$ds" 2>/dev/null || true)"
    if [[ "$dtype" == "volume" ]]; then
      recv_opts=( -o readonly=on )
    else
      recv_opts=( "${RECV_SAFE_OPTS[@]}" )
    fi
    if ! zfs send -t "$tok" | zfs receive -s -u "${recv_opts[@]}" "$ds"; then
      # A dead token (e.g. the source snapshot was pruned) can never resume;
      # abort the partial receive state so the incremental/full paths — which
      # any receive into $ds would otherwise reject — can proceed this run.
      log "Resume failed for ${ds}; aborting its partial receive state"
      zfs receive -A "$ds" || true
    fi
  done < <(zfs get -H -o name,value -r receive_resume_token "$dst" 2>/dev/null || true)
  if [[ "$found" -eq 1 ]]; then
    lock_backup_tree "$dst"
  fi
}

# --- SNAPSHOT / COMMON BASELINE ---------------------------------------------

latest_common_snapshot() {
  local src="$1" dst="$2"

  local src_snaps dst_snaps common
  src_snaps="$(zfs list -H -t snapshot -o name -s creation -r "$src" \
    | sed -n "s|^${src}@||p" \
    | grep -E "^${SNAP_PREFIX}-" || true)"

  # The incremental base must exist on EVERY dataset in the dst tree, not just
  # its root: an interrupted recursive receive leaves later children one
  # snapshot behind the root, and `zfs send -R -i` into such a tree fails on
  # the child missing the base. Keep only snapshot names carried by all
  # ds_count datasets (max one per dataset, so count==ds_count means all).
  local ds_count
  ds_count="$(zfs list -H -o name -r "$dst" 2>/dev/null | grep -c . || true)"
  [[ "$ds_count" -gt 0 ]] || return 0
  dst_snaps="$(zfs list -H -t snapshot -o name -r "$dst" 2>/dev/null \
    | sed -n "s|^.*@\(${SNAP_PREFIX}-.*\)$|\1|p" \
    | sort | uniq -c \
    | awk -v n="$ds_count" '$1 == n { print $2 }')"

  common="$(comm -12 <(printf "%s\n" "$src_snaps" | sort) <(printf "%s\n" "$dst_snaps" | sort) | tail -n 1 || true)"
  printf "%s" "$common"
}

latest_backup_snapshot_fullname() {
  local bdst="$1"
  zfs list -H -t snapshot -o name -s creation -r "$bdst" 2>/dev/null \
    | grep -E "^${bdst}@${SNAP_PREFIX}-" \
    | tail -n 1 || true
}

# --- RETENTION / PRUNING -----------------------------------------------------

# Prune snapshots for ONE dataset (non-recursive); keeps:
# - newest KEEP_RECENT snapshots
# - plus newest snapshot per month for up to KEEP_MONTHLY months (excluding the newest KEEP_RECENT which are already kept)
prune_snaps_dataset() {
  local ds="$1"

  # List snapshots newest -> oldest (note -S)
  mapfile -t snaps < <(
    zfs list -H -t snapshot -o name -S creation -r "$ds" 2>/dev/null \
      | grep -E "^${ds}@${SNAP_PREFIX}-" || true
  )
  ((${#snaps[@]} == 0)) && return 0

  declare -A keep=()
  local i=0

  # Keep newest KEEP_RECENT
  for s in "${snaps[@]}"; do
    if (( i < KEEP_RECENT )); then
      keep["$s"]=1
    fi
    ((i++))
  done

  # Keep monthly (last snapshot per month), scanning newest -> oldest
  declare -A kept_month=()
  local kept_m=0

  for s in "${snaps[@]}"; do
    [[ -n "${keep[$s]:-}" ]] && continue

    # Snapshot name includes a timestamp like archsync-YYYYMMDD-HHMMSS
    # Extract YYYYMM from it.
    local snap_name="${s#${ds}@}"
    local yyyymm
    yyyymm="$(echo "$snap_name" | sed -n 's/^'"${SNAP_PREFIX}"'-\([0-9]\{6\}\)[0-9]\{2\}-[0-9]\{6\}$/\1/p')"

    # If format ever differs, skip monthly logic for that snapshot.
    [[ -z "$yyyymm" ]] && continue

    if [[ -z "${kept_month[$yyyymm]:-}" ]]; then
      keep["$s"]=1
      kept_month["$yyyymm"]=1
      ((kept_m++))
      ((kept_m >= KEEP_MONTHLY)) && break
    fi
  done

  # Destroy anything not kept (oldest first is slightly safer to read logs; but we're iterating newest->oldest here)
  for s in "${snaps[@]}"; do
    if [[ -z "${keep[$s]:-}" ]]; then
      log "Prune: destroying snapshot $s"
      zfs destroy "$s"
    fi
  done
}

# Prune for dataset tree (root + children datasets)
prune_snaps_tree() {
  local root="$1"
  dataset_present "$root" || return 0

  while IFS= read -r ds; do
    prune_snaps_dataset "$ds"
  done < <(zfs list -H -o name -r "$root")
}

# --- POOL DEFAULTS -----------------------------------------------------------

set_pool_root_props() {
  zfs set mountpoint=none "${POOL_DST}" >/dev/null 2>&1 || true
  zfs set compression=zstd "${POOL_DST}" >/dev/null 2>&1 || true
  zfs set atime=off "${POOL_DST}" >/dev/null 2>&1 || true
  zfs set xattr=sa "${POOL_DST}" >/dev/null 2>&1 || true
  zfs set acltype=posixacl "${POOL_DST}" >/dev/null 2>&1 || true
}

# --- REPLICATION -------------------------------------------------------------

replicate_one() {
  local src="$1" dst="$2"
  # Declare + assign separately so the $(date) exit status isn't masked by
  # `local` (shellcheck SC2155); this script is linted in CI as a *.sh.j2.
  local snap_now
  snap_now="${SNAP_PREFIX}-$(date +%Y%m%d-%H%M%S)"
  local reseed_tmp="${dst}-reseed"

  dataset_present "$src" || { log "SKIP: missing source $src"; return 0; }

  # vzdump-overrun guard: only for the cluster-wide dump target. Wait for the
  # remote-node NFS writes to settle so this run's snapshot never captures a
  # half-written backup; skip the dataset (leaving last night's copy in place,
  # retried next run) if they don't settle within the bound. Snapshot/receive
  # of OTHER datasets is unaffected. Runs before the snapshot below.
  if [[ "$src" == "$VZDUMP_TARGET" ]]; then
    local vz_mp vz_waited=0
    vz_mp="$(zfs get -H -o value mountpoint "$src" 2>/dev/null || true)"
    if [[ -n "$vz_mp" && "$vz_mp" != "-" && -d "$vz_mp" ]]; then
      while find "$vz_mp" -type f -mmin "-${VZDUMP_QUIESCE_MIN}" -print -quit 2>/dev/null | grep -q .; do
        if (( vz_waited >= VZDUMP_MAX_WAIT_MIN )); then
          # Return non-zero so cmd_run marks the run failed and the prior
          # last-success timestamp is preserved: a chronic overrun then
          # surfaces via ArchiveBackupFailed/Stale rather than reporting
          # full success while this dataset silently never replicates.
          log "SKIP ${src}: vzdump still writing under ${vz_mp} after ${vz_waited}m; leaving prior backup, will retry next run"
          return 1
        fi
        log "vzdump appears active under ${vz_mp} (writes < ${VZDUMP_QUIESCE_MIN}m old); waiting ${VZDUMP_QUIESCE_MIN}m for quiesce"
        sleep $(( VZDUMP_QUIESCE_MIN * 60 ))
        vz_waited=$(( vz_waited + VZDUMP_QUIESCE_MIN ))
      done
    fi
  fi

  # Encrypted sources must be sent raw (-w): ZFS refuses to send an encrypted
  # dataset with properties (-R) unless raw. A raw stream carries the wrapped
  # key, so the archive holds encrypted-at-rest blobs and the backup runs with
  # no key loaded. Detect encryption RECURSIVELY: -R aborts the whole send if
  # any descendant is encrypted and -w is absent, so a single encrypted child
  # under a plaintext parent must still force raw. All-plaintext trees (every
  # value off or -) send non-raw.
  local raw_flags=()
  if zfs get -H -o value -r encryption "$src" 2>/dev/null | grep -Eqv '^(off|-)$'; then
    raw_flags=(-w)
  fi

  # Recovery: a re-seed interrupted after its replacement was fully received but
  # before the swap finished leaves a COMPLETE temp sibling. Promote it instead
  # of re-sending, so a crash mid-swap never loses the backup or forces a
  # multi-TB re-send. "Complete" requires BOTH no resume token AND at least one
  # backup snapshot — a token-less temp with no snapshot is a failed/empty
  # receive and must be discarded, never promoted over a good dst. Anything not
  # promotable (partial token, or empty) is discarded so the re-seed rebuilds it.
  if dataset_present "$reseed_tmp"; then
    # Promote only a verifiably-complete temp tree, and FAIL CLOSED: capture the
    # marker + token list explicitly so a failed `zfs get` can't be negated into
    # a false "complete". Complete = the post-loop completion marker is set AND
    # no dataset in the tree still carries a resume token (the marker is written
    # only after every dataset is received, so a token-less-but-incomplete tree —
    # a crash between two receives leaving later children missing — is not
    # complete). Anything else is discarded + rebuilt, never promoted over a good
    # dst.
    local reseed_marker reseed_tokens reseed_snaps
    reseed_marker="$(zfs get -H -o value "${SNAP_PREFIX}:reseed_complete" "$reseed_tmp" 2>/dev/null || echo "?")"
    if reseed_tokens="$(zfs get -H -o value -r receive_resume_token "$reseed_tmp" 2>/dev/null)" \
       && reseed_snaps="$(zfs list -H -t snapshot -o name -r "$reseed_tmp" 2>/dev/null)" \
       && [[ "$reseed_marker" == "1" ]] \
       && [[ -n "$reseed_snaps" ]] \
       && ! printf '%s\n' "$reseed_tokens" | grep -qv '^-$'; then
      log "Finishing interrupted re-seed: promoting ${reseed_tmp} -> ${dst}"
      if dataset_present "$dst"; then
        unlock_for_receive "$dst"
        zfs destroy -r "$dst"
      fi
      zfs rename "$reseed_tmp" "$dst"
      lock_backup_tree "$dst"
      prune_snaps_tree "$src" || true
      prune_snaps_tree "$dst" || true
      return 0
    fi
    log "Discarding incomplete re-seed temp ${reseed_tmp}"
    unlock_for_receive "$reseed_tmp"
    zfs destroy -r "$reseed_tmp"
  fi

  # Resume partial receives first (if any)
  if dataset_present "$dst"; then
    maybe_resume_receive "$dst"
  fi

  log "Snapshot: ${src}@${snap_now}"
  zfs snapshot -r "${src}@${snap_now}"

  # A raw stream cannot continue a base that was received non-raw. When a source
  # has been newly encrypted but its archive copy was seeded non-raw
  # (encryption=off), do a one-time raw re-seed. To never leave the dataset
  # without a backup, build the replacement in a temp sibling and swap only
  # after a COMPLETE receive: the old copy survives a failed/interrupted re-seed
  # because set -e/pipefail aborts before the swap on any send error, and a crash
  # between the destroy and the rename is repaired by the recovery block above.
  # Fires once per dataset (the next run sees an encrypted dst and resumes
  # incrementals). Only an exact encryption=off triggers it, so a transient
  # `zfs get` blip cannot destroy a good encrypted backup.
  if [[ ${#raw_flags[@]} -gt 0 ]] && dataset_present "$dst" \
     && [[ "$(zfs get -H -o value encryption "$dst" 2>/dev/null)" == "off" ]]; then
    log "Re-seed: ${src} is encrypted but ${dst} is non-raw; building raw copy in ${reseed_tmp} (current snapshot only)"
    # Send ONLY the current snapshot of each dataset in the tree (no -R). -R
    # would replicate the source's entire snapshot history — including the
    # zfs-auto-snap churn the archive does not retain — which can dwarf the live
    # data (e.g. proxmox carries 46 source snapshots vs the ~9 archsync the
    # archive keeps, ~7.8T vs ~3.1T) and overflow the pool. Incrementals rebuild
    # the archsync history forward from here. Enumerate parent-before-children so
    # each nested encryptionroot ships raw with its own wrapped key. The recovery
    # block above already cleared any prior temp.
    # Drive the loop from the @snap_now snapshots (not the live dataset tree) so
    # only datasets that actually carry the snapshot are sent — a dataset created
    # after the recursive snapshot can't enter the loop and abort it. zfs lists
    # snapshots parent-dataset-first, so parents are received before children.
    # Enumerate the @snap_now snapshots up front and abort if that fails or comes
    # back empty — otherwise a failed enumeration inside a process substitution
    # would run a partial loop and then still set the completion marker. Sort the
    # list shallowest-dataset-first (by '/' depth) so every dataset's parent is
    # received before it, EXPLICITLY rather than relying on zfs list's grouping:
    # snapshot names can't be lexically sorted for this (a child's '/' sorts
    # before a parent's '@'), so an explicit depth sort is the safe ordering.
    local snap ds sub recv_opts dtype snap_list
    if ! snap_list="$(zfs list -H -o name -t snapshot -r "$src" \
        | awk -F@ -v s="$snap_now" '$2 == s { d = $1; print gsub(/\//, "/", d) "\t" $0 }' \
        | sort -k1,1n -k2,2 | cut -f2-)"; then
      log "Re-seed aborted: failed to enumerate ${snap_now} snapshots under ${src}"
      return 1
    fi
    [[ -n "$snap_list" ]] || { log "Re-seed aborted: no ${snap_now} snapshots under ${src}"; return 1; }
    while IFS= read -r snap; do
      ds="${snap%@${snap_now}}"
      sub="${reseed_tmp}${ds#"${src}"}"
      # A PER-DATASET '-o mountpoint=/canmount' override on a zvol receive is
      # rejected by zfs, so volumes receive read-only only; filesystems get the
      # full non-mountable set. (The -R initial/incremental paths below send the
      # same mixed tree with RECV_SAFE_OPTS and are fine: -o applies ONLY to the
      # stream's top-level dataset — a filesystem (see the SRC_LIST invariant) —
      # so the zvol descendants are never targeted by the rejected override; they
      # do not "inherit" mountpoint/canmount (volumes can't hold those at all).
      # Only this per-dataset, non-R loop applies -o to each dataset, so only it
      # needs the type split. Detection is
      # generic: ANY source tree may hold zvol children (today only ssd/appdata's
      # app DB/data volumes do), and each is type-detected on its own.) $ds was just
      # enumerated from the snapshot list so it exists; '|| true' lets a
      # transient/racy get error fall through (empty dtype) to the else, so an
      # errored OR unexpected type aborts LOUDLY with a $ds-specific log — rather
      # than set -e killing the bare assignment with a generic message, or
      # silently routing a zvol through the filesystem branch (the very
      # "property 'mountpoint' does not apply" rejection this guards against).
      dtype="$(zfs get -H -o value type "$ds" 2>/dev/null || true)"
      if [[ "$dtype" == "volume" ]]; then
        recv_opts=( -o readonly=on )
      elif [[ "$dtype" == "filesystem" ]]; then
        recv_opts=( "${RECV_SAFE_OPTS[@]}" )
      else
        log "Re-seed aborted: cannot determine type of ${ds} (got '${dtype}')"
        return 1
      fi
      zfs send "${raw_flags[@]}" "${snap}" \
        | zfs receive -s -u "${recv_opts[@]}" "$sub" \
        || { log "Re-seed failed sending ${snap} -> ${sub}"; return 1; }
    done <<< "$snap_list"
    # Mark the temp tree complete ONLY after every dataset received. The recovery
    # block requires this marker before promoting, so a crash mid-loop (no
    # marker) or a partial child (resume token) is never promoted over a good dst.
    zfs set "${SNAP_PREFIX}:reseed_complete=1" "$reseed_tmp"
    # Receive completed (a send/receive failure would have aborted above) ->
    # swap the verified raw copy into place: drop the old, rename temp in.
    unlock_for_receive "$dst"
    zfs destroy -r "$dst"
    zfs rename "$reseed_tmp" "$dst"
    lock_backup_tree "$dst"
    prune_snaps_tree "$src" || true
    prune_snaps_tree "$dst" || true
    return 0
  fi

  if ! dataset_present "$dst"; then
    log "Initial replicate -> ${dst} (raw=${raw_flags[*]:-no})"
    zfs send -R "${raw_flags[@]}" "${src}@${snap_now}" \
      | zfs receive -s -u "${RECV_SAFE_OPTS[@]}" "${dst}"
    lock_backup_tree "$dst"
  else
    unlock_for_receive "$dst"

    local prev
    prev="$(latest_common_snapshot "$src" "$dst")"

    if [[ -z "$prev" ]]; then
      log "No common ${SNAP_PREFIX}-* snapshots; full replicate to ${dst} (receive -F, raw=${raw_flags[*]:-no})"
      zfs send -R "${raw_flags[@]}" "${src}@${snap_now}" \
        | zfs receive -s -u -F "${RECV_SAFE_OPTS[@]}" "${dst}"
    else
      log "Incremental: ${src}@${prev} -> ${src}@${snap_now} into ${dst} (receive -F, raw=${raw_flags[*]:-no})"
      zfs send -R "${raw_flags[@]}" -i "${src}@${prev}" "${src}@${snap_now}" \
        | zfs receive -s -u -F "${RECV_SAFE_OPTS[@]}" "${dst}"
    fi

    lock_backup_tree "$dst"
  fi

  # Prune both sides (keeps common set small and the comm faster)
  prune_snaps_tree "$src" || true
  prune_snaps_tree "$dst" || true
}

# --- COMMANDS ----------------------------------------------------------------

cmd_run() {
  # Single-instance guard: a timer run colliding with a manual run would
  # interleave sends to the same target datasets.
  exec 9>/run/archive-backup.lock
  if ! flock -n 9; then
    log "archive-backup already running; exiting"
    exit 0
  fi
  _BACKUP_METRICS_ACTIVE=1
  if ! pool_present; then
    log "Pool '${POOL_DST}' not present (exported/unplugged). Nothing to do."
    exit 0
  fi

  set_pool_root_props

  log "Starting replication to '${POOL_DST}'"
  local failed=0
  for src in "${SRC_LIST[@]}"; do
    # Isolate each dataset in a fresh process so one persistently failing
    # dataset cannot starve the later ones of backups. A plain
    # `if ! replicate_one ...` would NOT do: bash disables errexit and the ERR
    # trap for a function called inside a condition, turning unguarded
    # send|receive failures into silent false successes. The child keeps full
    # set -Eeuo pipefail semantics; it inherits fd 9 (lock stays held) and its
    # _BACKUP_METRICS_ACTIVE stays 0, so only this parent writes metrics.
    if ! "$0" __run-one "$src"; then
      log "Replication FAILED for ${src}; continuing with remaining datasets"
      failed=1
    fi
  done

  if [[ "$failed" -eq 1 ]]; then
    log "Replication finished WITH FAILURES (see per-dataset errors above)."
  else
    log "Replication complete."
  fi
  zfs list -o name,used,avail,refer,mountpoint -r "${POOL_DST}" | sed 's/^/  /'

  # Write Prometheus textfile metrics. success=0 preserves the last-success
  # timestamp, so ArchiveBackupFailed fires while the staleness alert still
  # measures time since the last fully good run.
  local end_ts
  end_ts="$(date +%s)"
  local duration=$(( end_ts - _BACKUP_START_TS ))
  if [[ "$failed" -eq 1 ]]; then
    write_prom_metrics 0 "$duration"
    exit 1
  fi
  write_prom_metrics 1 "$duration"
}

# Internal subcommand used only by cmd_run: replicate exactly one SRC_LIST
# dataset in this fresh process, where errexit + the ERR trap are fully
# active. The parent holds the run lock.
cmd_run_one() {
  local src="$1"
  [[ -n "${MAP[$src]:-}" ]] || { log "__run-one: '${src}' is not in SRC_LIST"; exit 2; }
  replicate_one "$src" "${MAP[$src]}"
}

cmd_enable() {
  systemctl enable --now archive-backup.timer
  log "Enabled+started archive-backup.timer"
}

cmd_disable() {
  systemctl disable --now archive-backup.timer >/dev/null 2>&1 || true
  log "Disabled+stopped archive-backup.timer"
}

cmd_status() {
  systemctl status archive-backup.timer --no-pager || true
  systemctl status archive-backup.service --no-pager || true
  zpool list "${POOL_DST}" 2>/dev/null || true
  zfs list -r "${POOL_DST}" 2>/dev/null || true
}

# Single-instance lock shared with cmd_run (which takes it with its own
# exit-0 "already running" semantics). plug/plug-arm/unplug and the restores
# must never interleave with a mid-send replication: plug re-locks datasets an
# active receive needs writable, unplug would die on a busy `zpool export`
# after already disabling the timer, and a restore would race the pruner.
# Fail fast rather than block: a held lock means replication is mid-send.
_take_run_lock_or_die() {
  exec 9>/run/archive-backup.lock
  if ! flock -n 9; then
    log "replication in progress (lock held); retry after the nightly window"
    exit 1
  fi
}

cmd_unplug() {
  _take_run_lock_or_die
  cmd_disable
  # Scrub coverage tracks pool presence — a monthly scrub against an exported
  # pool would just fail. `|| true`: the timer may not exist/be enabled on a
  # host that never ran plug or a storage deploy with the pool imported.
  systemctl disable --now "${SCRUB_TIMER}" >/dev/null 2>&1 || true
  if ! pool_present; then
    log "Pool '${POOL_DST}' already not present."
    exit 0
  fi
  log "Unmounting datasets under '${POOL_DST}'"
  zfs unmount -r "${POOL_DST}" 2>/dev/null || true
  log "Exporting pool '${POOL_DST}' (safe to unplug after this)"
  zpool export "${POOL_DST}"
  log "Done."
}

_lock_existing_backup_datasets() {
  set_pool_root_props
  local dst
  for dst in "${!RMAP[@]}"; do
    if dataset_present "$dst"; then
      lock_backup_tree "$dst"
    fi
  done
}

cmd_plug() {
  _take_run_lock_or_die
  if pool_present; then
    log "Pool '${POOL_DST}' already imported."
  else
    log "Importing pool '${POOL_DST}'"
    zpool import -f "${POOL_DST}"
  fi
  _lock_existing_backup_datasets
  cmd_enable
  systemctl enable --now "${SCRUB_TIMER}" || log "WARNING: could not enable ${SCRUB_TIMER}"
  # cmd_run re-opens fd 9, briefly releasing this lock before re-taking it.
  # If the timer wins that race, cmd_run exits 0 ("already running") — which
  # is equivalent: a replication run is underway either way.
  cmd_run
}

cmd_plug_arm() {
  _take_run_lock_or_die
  if pool_present; then
    log "Pool '${POOL_DST}' already imported."
  else
    log "Importing pool '${POOL_DST}'"
    zpool import -f "${POOL_DST}"
  fi
  _lock_existing_backup_datasets
  cmd_enable
  systemctl enable --now "${SCRUB_TIMER}" || log "WARNING: could not enable ${SCRUB_TIMER}"
  log "Plug-arm complete (timer enabled; no immediate replication run)."
}

# --- RESTORE -----------------------------------------------------------------

_restore_mount_tree() {
  local restore_root="$1" label="$2" ts="$3"
  local mp="${RESTORE_BASE}/${label}/${ts}"

  mkdir -p "$mp"

  zfs set canmount=on "$restore_root"
  zfs set mountpoint="$mp" "$restore_root"
  # The stream carries the archive's local readonly=on as a RECEIVED value on
  # every dataset (received beats inherited); inherit -r masks it tree-wide so
  # the restore is writable (root + children fall back to the pool default).
  zfs inherit -r readonly "$restore_root" >/dev/null 2>&1 || true

  # `zfs inherit` (not the invalid `zfs set mountpoint=inherit`) also masks a
  # RECEIVED mountpoint=none a re-seeded child carries, so children mount
  # under $mp instead of silently staying unmounted.
  while IFS= read -r child; do
    zfs set canmount=on "$child" >/dev/null 2>&1 || true
    zfs inherit mountpoint "$child" >/dev/null 2>&1 || true
  done < <(zfs list -H -o name -r "$restore_root" | tail -n +2)

  zfs mount -r "$restore_root" >/dev/null 2>&1 || true
  # A restored encrypted dataset is raw and key-less (keystatus=unavailable), so
  # the mount above is a silent no-op. Don't claim it mounted — tell the operator
  # how to unlock it instead, so a real restore isn't trusted as readable when
  # the directory is empty.
  if zfs get -H -o value -r keystatus "$restore_root" 2>/dev/null | grep -q '^unavailable$'; then
    log "Restore tree ${restore_root} contains encrypted key-less datasets — mount is incomplete."
    log "  Unlock + mount: zfs load-key -r -L prompt ${restore_root} && zfs mount -r ${restore_root}  (mounts under ${mp})"
  else
    log "Mounted restore tree at: $mp"
  fi
}

# A force-restored stream carries the archive's local lockdown props
# (mountpoint=none, canmount=off, readonly=on) as received values — and the
# fresh/recreated dst has no local props masking them, so left alone the
# restored data sits unmounted and read-only while `zfs mount -a` silently
# no-ops. Reset the tree. The original mountpoint is NOT in the stream:
# restore the /mnt/<pool>/<dataset> production convention and let the next
# storage deploy re-assert the host_vars properties. (`zfs receive -x/-o`
# can't do this: with -R they apply only to the stream's top-level dataset,
# so children would stay locked.)
_force_restore_reset_props() {
  local root="$1"
  local child dtype
  # received readonly=on beats inheritance; inherit -r masks it tree-wide.
  zfs inherit -r readonly "$root" >/dev/null 2>&1 || true
  zfs set canmount=on "$root"
  zfs set mountpoint="/mnt/${root}" "$root"
  # canmount is not inheritable — set it per filesystem child; volumes hold
  # neither mountpoint nor canmount, so skip them (readonly already cleared).
  while IFS= read -r child; do
    dtype="$(zfs get -H -o value type "$child" 2>/dev/null || true)"
    [[ "$dtype" == "volume" ]] && continue
    zfs set canmount=on "$child" >/dev/null 2>&1 || true
    zfs inherit mountpoint "$child" >/dev/null 2>&1 || true
  done < <(zfs list -H -o name -r "$root" | tail -n +2)
  zfs mount -r "$root" >/dev/null 2>&1 || true
  # A raw-restored encrypted dataset is key-less, so the mount above is a
  # silent no-op — tell the operator how to unlock instead of claiming success.
  if zfs get -H -o value -r keystatus "$root" 2>/dev/null | grep -q '^unavailable$'; then
    log "Restored tree ${root} contains encrypted key-less datasets — mount is incomplete."
    log "  Unlock + mount: zfs load-key -r -L prompt ${root} && zfs mount -r ${root}"
  else
    log "Restored ${root}, mounted at /mnt/${root} (re-run the storage deploy to re-assert host_vars properties)"
  fi
}

_restore_one() {
  local bdst="$1" mode="$2"   # safe|force
  local dst="${RMAP[$bdst]}"
  local label
  label="$(basename "$bdst")"

  dataset_present "$bdst" || { log "SKIP restore: missing backup dataset $bdst"; return 0; }

  local snap_full
  snap_full="$(latest_backup_snapshot_fullname "$bdst")"
  [[ -n "$snap_full" ]] || { log "SKIP restore: no ${SNAP_PREFIX}- snapshots on $bdst"; return 0; }

  # Encrypted backups can only be sent raw (the archive never has keys loaded),
  # so the restored dataset is itself encrypted and needs `zfs load-key` (with
  # the original source's key) before it can be mounted. Detect recursively: a
  # `zfs send -R` over a tree with any encrypted descendant requires -w.
  local raw_flags=()
  if zfs get -H -o value -r encryption "$bdst" 2>/dev/null | grep -Eqv '^(off|-)$'; then
    raw_flags=(-w)
    log "Note: ${bdst} contains encrypted datasets; restoring raw (run 'zfs load-key' on the restored dataset before mounting)"
  fi

  local ts
  ts="$(date +%Y%m%d-%H%M%S)"

  if [[ "$mode" == "safe" ]]; then
    local restore_dst="${dst}-restore-${ts}"
    log "SAFE restore: ${snap_full} -> ${restore_dst} (non-destructive)"
    zfs send -R "${raw_flags[@]}" "${snap_full}" | zfs receive -u "${restore_dst}"
    mkdir -p "${RESTORE_BASE}"
    _restore_mount_tree "${restore_dst}" "${label}" "${ts}"
    return 0
  fi

  if ! dataset_present "$dst"; then
    log "FORCE restore target missing; creating: ${snap_full} -> ${dst}"
    zfs send -R "${raw_flags[@]}" "${snap_full}" | zfs receive -u "${dst}"
    _force_restore_reset_props "$dst"
    return 0
  fi

  # receive -F of a full replication stream destroys and recreates $dst, so
  # its local props are lost too — both force branches need the reset.
  log "FORCE restore (destructive): ${snap_full} -> ${dst} (receive -F)"
  zfs send -R "${raw_flags[@]}" "${snap_full}" | zfs receive -u -F "${dst}"
  _force_restore_reset_props "$dst"
}

# Valid restore targets, derived from SRC_LIST basenames (for usage strings).
_restore_usage_targets() {
  local out="" src
  for src in "${SRC_LIST[@]}"; do
    out+="${src##*/}|"
  done
  printf '%s' "${out}all"
}

# A restore READS the archive but WRITES into the source pool: safe mode
# receives ${dst}-restore-<ts> trees onto tank/ssd (the space cost lands on
# the SOURCE pool, not the archive), force receives in place over the live
# dataset. It must never interleave with the nightly replication reading and
# pruning the same datasets, so take the SAME single-instance lock cmd_run
# uses (fail-fast — see _take_run_lock_or_die).
_cmd_restore_impl() {
  local mode="$1" what="$2" cmd_name="$3"

  _take_run_lock_or_die

  pool_present || { log "Pool '${POOL_DST}' not present. Run: archive-backupctl plug or plug-arm first."; exit 1; }

  [[ -n "$what" ]] || { echo "Usage: archive-backupctl ${cmd_name} <$(_restore_usage_targets)>" >&2; exit 2; }

  local -a targets=()
  local src bdst
  if [[ "$what" == "all" ]]; then
    for src in "${SRC_LIST[@]}"; do
      targets+=( "${MAP[$src]}" )
    done
  else
    bdst="${POOL_DST}/${what}"
    if [[ -z "${RMAP[$bdst]:-}" ]]; then
      echo "Unknown restore target: $what" >&2
      exit 2
    fi
    targets=( "$bdst" )
  fi

  for bdst in "${targets[@]}"; do
    _restore_one "$bdst" "$mode"
  done
}

cmd_restore() {
  _cmd_restore_impl safe "${1:-}" restore
  log "Restore (safe) complete. Restores are under: ${RESTORE_BASE}/<target>/<timestamp>/ (space consumed on the source pool)"
}

cmd_restore_force() {
  _cmd_restore_impl force "${1:-}" restore-force
  log "Restore (FORCE) complete."
}

usage() {
  cat <<USAGE
Usage: archive-backupctl <command> [args]   (run as root)

Commands:
  run                 Run replication now (safe if archive is exported/unplugged; exits 0)
  enable              Enable + start the systemd timer
  disable             Disable + stop the systemd timer
  status              Show timer/service/pool status
  unplug              Disable timer, unmount archive datasets, export pool (safe to unplug)
  plug                Import pool, enable timer, and run replication now
  plug-arm            Import pool, lock/unmountable, enable timer (NO immediate run)

  restore <target>        SAFE restore into new *-restore-YYYYMMDD-HHMMSS datasets
                          ON THE SOURCE POOL (space cost lands there), mounted
                          under /mnt/restore/<target>/<timestamp>/
  restore-force <target>  DESTRUCTIVE restore in place (zfs receive -F)
                          targets: $(_restore_usage_targets)
USAGE
}

main() {
  need_root
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    run) cmd_run ;;
    __run-one) cmd_run_one "${1:?dataset required}" ;;
    enable) cmd_enable ;;
    disable) cmd_disable ;;
    status) cmd_status ;;
    unplug) cmd_unplug ;;
    plug) cmd_plug ;;
    plug-arm) cmd_plug_arm ;;
    restore) cmd_restore "${1:-}" ;;
    restore-force) cmd_restore_force "${1:-}" ;;
    ""|help|-h|--help) usage ;;
    *) echo "Unknown command: $cmd" >&2; usage; exit 2 ;;
  esac
}

main "$@"
