#!/bin/sh
# {{ ansible_managed }}
# NAS-side backup-artifact freshness collector. Stats the newest file under each
# tank/backups/apps/<app> subdir and emits its mtime, so a broken mount / wrong
# path (the "green wrapper metric, no file on the NAS" failure mode) is caught
# independently of the VM/k8s wrappers' own metrics. Companion alert
# BackupArtifactStale lives in kube-prometheus-stack/release.yaml.
#
#   backup_artifact_last_mtime_seconds{app}      unix mtime of the newest file (0 = none)
#   backup_artifact_collector_last_success_seconds  collector sentinel (meta-failure)
#
# Atomic write (.tmp + rename) so node_exporter never reads a half-written file.
set -eu
export LC_ALL=C

OUT_DIR="${1:-/var/lib/node_exporter}"
OUT="$OUT_DIR/backup_artifact_mtime.prom"
TMP="$OUT.tmp"
BASE="{{ nas_backup_apps_base }}"
mkdir -p "$OUT_DIR"

{
  printf '# HELP backup_artifact_last_mtime_seconds Unix mtime of the newest file under tank/backups/apps/<app> (0 = no artifact present).\n'
  printf '# TYPE backup_artifact_last_mtime_seconds gauge\n'
  if [ -d "$BASE" ]; then
    for dir in "$BASE"/*/; do
      [ -d "$dir" ] || continue
      app="$(basename "$dir")"
      # Newest file mtime under the app dir (GNU find %T@ = epoch.frac). 0 when
      # the dir is empty. `set +e` per app so a vanished dir can't kill the run.
      set +e
      # Partial/temp files are NOT restorable artifacts: the pg-dump jobs write
      # "$out.tmp" then rename, so a failed dump leaves a fresh .tmp that would
      # otherwise mask BackupArtifactStale.
      mtime="$(find "$dir" -type f ! -name '*.tmp' ! -name '*.partial' ! -name '*.part' -printf '%T@\n' 2>/dev/null | sort -n | tail -1)"
      set -e
      mtime="${mtime%%.*}"
      case "$mtime" in ''|*[!0-9]*) mtime=0 ;; esac
      printf 'backup_artifact_last_mtime_seconds{app="%s"} %s\n' "$app" "$mtime"
    done
  fi
  printf '# HELP backup_artifact_collector_last_success_seconds Unix time the backup-artifact collector last completed (staleness = collector broken).\n'
  printf '# TYPE backup_artifact_collector_last_success_seconds gauge\n'
  printf 'backup_artifact_collector_last_success_seconds %s\n' "$(date +%s)"
} > "$TMP"

mv "$TMP" "$OUT"
