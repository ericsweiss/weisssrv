#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Distribute the renewed wildcard cert to every host listed in
# `cert_distribution_targets` (`host_vars/dns-01.yml`). Runs as root on
# dns-01 after every acme.sh renewal hook. Each target's per-entry
# fields control SSH access, file placement, and reload semantics:
# see the comment block at the top of cert_distribution_targets in
# `host_vars/dns-01.yml` for the per-target schema.

set -euo pipefail

_CERT_START_TS="$(date +%s)"

PROM_DIR="{{ node_exporter_host_textfile_dir | default('/var/lib/node_exporter') }}"
# node_exporter's textfile collector dir is normally created by the
# node_exporter_host role, but cert-reload can race that on a fresh host
# (cron-driven reload firing before the role's first deploy completes).
# mkdir -p is a no-op on the steady state.
mkdir -p "$PROM_DIR"
PROM_FILE="${PROM_DIR}/cert_renewal.prom"
PROM_TARGET_FILE="${PROM_DIR}/cert_distribution_targets.prom"

write_prom_metrics() {
  local success="$1" duration="$2"
  local ts notafter_epoch=""
  ts="$(date +%s)"
  # Compute the cert's real notAfter BEFORE the redirected block below, so a parse
  # warning reaches real stderr (the block sends stderr to /dev/null). Compute it
  # on BOTH success and failure: expiry is a property of the on-disk cert, not of
  # this run, so a FAILED distribution run must still emit it — otherwise the
  # metric drops from the file and CertExpiringSoon's absent(cert_local_expiry...)
  # clause false-fires even though the cert itself is fine. It's omitted only when
  # the local cert is genuinely missing/unparseable (which SHOULD alert). Alerting
  # tracks actual expiry, not time-since-renewal (acme.sh renews ~60d apart, so a
  # staleness proxy on the renewal timestamp false-fires for most of a cycle).
  notafter_epoch="$(date -d "$(openssl x509 -enddate -noout -in "$FULLCHAIN_SRC" 2>/dev/null | cut -d= -f2)" +%s 2>/dev/null || true)"
  [ -n "$notafter_epoch" ] || echo "warning: could not parse cert notAfter; cert_local_expiry_timestamp_seconds omitted" >&2
  local tmp="${PROM_FILE}.$$"
  {
    echo "# HELP cert_renewal_last_run_duration_seconds Duration of last cert renewal run"
    echo "# TYPE cert_renewal_last_run_duration_seconds gauge"
    echo "cert_renewal_last_run_duration_seconds ${duration}"
    echo "# HELP cert_renewal_last_run_success Whether the last cert renewal succeeded (1=success, 0=failure)"
    echo "# TYPE cert_renewal_last_run_success gauge"
    echo "cert_renewal_last_run_success ${success}"
    # Expiry: emitted on success AND failure (see the notAfter comment above) so a
    # failed run doesn't drop it and false-fire CertExpiringSoon's absent() clause.
    if [ -n "$notafter_epoch" ]; then
      echo "# HELP cert_local_expiry_timestamp_seconds Unix timestamp of the distributed wildcard cert's notAfter"
      echo "# TYPE cert_local_expiry_timestamp_seconds gauge"
      echo "cert_local_expiry_timestamp_seconds ${notafter_epoch}"
    fi
    if [ "$success" -eq 1 ]; then
      echo "# HELP cert_renewal_last_success_timestamp_seconds Unix timestamp of last successful cert renewal"
      echo "# TYPE cert_renewal_last_success_timestamp_seconds gauge"
      echo "cert_renewal_last_success_timestamp_seconds ${ts}"
    fi
  } > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  mv "$tmp" "$PROM_FILE" 2>/dev/null || rm -f "$tmp"
}

# Per-target metrics so a partial failure (one target down) is visible
# in Prometheus instead of being collapsed into the run-level success
# bit. Caller appends one entry per target as they finish.
_TARGET_METRICS_TMP="$(mktemp)"
_TARGET_METRICS_FLUSHED=0
write_target_metric() {
    local host="$1" success="$2"
    printf 'cert_distribution_target_last_run_success{host="%s"} %d\n' \
        "$host" "$success" >> "$_TARGET_METRICS_TMP"
}
flush_target_metrics() {
    # Idempotent: the inline call at end-of-script and the EXIT trap
    # both call this. If we let it run twice the second pass would cat
    # the already-deleted tmp file and clobber $PROM_TARGET_FILE with
    # just the HELP/TYPE headers (no host lines).
    if [[ "$_TARGET_METRICS_FLUSHED" -eq 1 ]]; then
        return
    fi
    {
        echo "# HELP cert_distribution_target_last_run_success Per-target cert distribution success (1=ok, 0=failed)"
        echo "# TYPE cert_distribution_target_last_run_success gauge"
        cat "$_TARGET_METRICS_TMP"
    } > "$PROM_TARGET_FILE" 2>/dev/null || true
    rm -f "$_TARGET_METRICS_TMP"
    _TARGET_METRICS_FLUSHED=1
}

trap_write_failure_metrics() {
  local end_ts
  end_ts="$(date +%s)"
  local duration=$(( end_ts - _CERT_START_TS ))
  write_prom_metrics 0 "$duration"
  flush_target_metrics
}
# shellcheck disable=SC2154 # `rc` is assigned via $? at trap fire time
trap 'rc=$?; if [ "$rc" -ne 0 ]; then trap_write_failure_metrics; fi; rm -f "$_TARGET_METRICS_TMP"' EXIT

FULLCHAIN_SRC="{{ local_cert_dir }}/fullchain.pem"
PRIVKEY_SRC="{{ local_cert_dir }}/privkey.pem"
IDENTITY_FILE="/home/eric/.ssh/id_ed25519_certs"

# Bail early if the cert files don't exist locally.
[[ -r "$FULLCHAIN_SRC" && -r "$PRIVKEY_SRC" ]] || {
    echo "missing $FULLCHAIN_SRC or $PRIVKEY_SRC; nothing to distribute" >&2
    exit 1
}

{% for target in cert_distribution_targets %}
{{ target.host | upper | replace('-', '_') }}_IP="{{ target.ip }}"
{% if target.ssh_no_sudo | default(false) %}
{# cert_dir is baked into the receiver on sudo targets; only the legacy
   (ssh_no_sudo) push path still needs it client-side. #}
{{ target.host | upper | replace('-', '_') }}_CERT_DIR="{{ target.cert_dir }}"
{% endif %}
{% endfor %}

# Helper: non-interactive ssh/scp with dedicated identity file.
# StrictHostKeyChecking=yes (not accept-new): host keys for every
# target are pinned in host_vars/dns-01.yml under
# cert_distribution_targets[*].host_key and pre-loaded into
# /root/.ssh/known_hosts by the acme_certs role. A fingerprint
# mismatch — host rebuild without inventory update, or MITM —
# fails the cert push loudly instead of silently trusting.
SSH_OPTS=(-i "$IDENTITY_FILE" -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/root/.ssh/known_hosts -o ConnectTimeout=10)
SCP_OPTS=(-q -i "$IDENTITY_FILE" -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/root/.ssh/known_hosts -o ConnectTimeout=10)

# Per-target push. We capture failure per-host so a single dead target
# doesn't abort distribution to the others; ANY_FAIL is set if any
# target fails, and the script exits non-zero at the end (which the
# trap catches and writes the failure metric).
ANY_FAIL=0

# Boundary between the two PEM parts in the bundle streamed to the receiver.
# Not valid PEM/base64, so it can never collide with cert or key content.
DELIM="===CERT-RECEIVE-BUNDLE-BOUNDARY==="

# Sudo targets: one SSH round-trip. The key is pinned to
# command="sudo /usr/local/sbin/cert-receive",restrict, so we just stream the
# bundle to stdin; the receiver validates, installs, reloads, and decides
# unchanged-vs-apply itself, printing OK / unchanged / FAIL. No scp, no remote
# mktemp/chown/chmod, no pre-check probes — the forced command shrinks a leaked
# key from a root shell to "install a validated cert + run one baked-in reload".
push_target_receiver() {
    local host="$1" ip="$2" ssh_user="$3" ssh_port="$4"
    local out rc
    if out=$( { cat "$FULLCHAIN_SRC"; printf '\n%s\n' "$DELIM"; cat "$PRIVKEY_SRC"; } \
                | ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" 2>&1 ); then
        rc=0
    else
        rc=$?
    fi
    if [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -qx 'OK'; then
        write_target_metric "$host" 1
        echo "OK: ${host}"
    elif [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -qx 'unchanged'; then
        write_target_metric "$host" 1
        echo "unchanged: ${host}"
    else
        echo "FAIL: ${host}: ${out:-ssh exited ${rc}}" >&2
        write_target_metric "$host" 0
        ANY_FAIL=1
    fi
}

# Legacy scp+sudo push, retained ONLY for ssh_no_sudo appliance targets (HAOS)
# whose authorized_keys is operator-managed and cannot host the forced-command
# receiver. See docs/09-certs.md for the operator runbook to migrate HAOS too.
push_target_legacy() {
    local host="$1" ip="$2" cert_dir="$3" \
          ssh_user="$4" ssh_port="$5" sudo_prefix="$6" \
          owner="$7" group="$8" cert_mode="$9" key_mode="${10}" \
          reload_cmd="${11}"

    # Skip the push+reload only when this exact cert was ALREADY SUCCESSFULLY
    # APPLIED — tracked by a per-target marker written after the reload succeeds
    # (see end of this function), NOT by the on-disk fullchain.pem. Gating on the
    # cert file alone would skip a target that received the cert but whose reload
    # FAILED: the cert is copied before the reload runs, so the file would already
    # match and the failed reload would never retry. The proactive Ansible path
    # runs every deploy; this guard stops re-firing the reload commands (HAOS
    # `ha core restart`, Plex/AdGuard/postfix/tlshd restarts) when nothing
    # changed. acme.sh's own --reloadcmd path differs on renewal and pushes as
    # before; a missing/stale marker or unreachable target falls through to the
    # full push below.
    # Skip only when the applied marker matches AND both remote cert files still
    # exist and hash-match the local source. A stale .applied-fullchain.sha256 — or
    # a deleted/corrupted/manually-replaced fullchain.pem OR privkey.pem — must NOT
    # be treated as unchanged and suppress the self-healing re-push. Read the marker
    # plus the live remote fullchain AND privkey hashes (a missing/mismatched file
    # leaves its hash empty/different and falls through to the push below).
    local local_hash local_key_hash applied_hash remote_hash remote_key_hash
    local_hash=$(sha256sum "$FULLCHAIN_SRC" | cut -d' ' -f1)
    local_key_hash=$(sha256sum "$PRIVKEY_SRC" | cut -d' ' -f1)
    if ! applied_hash=$(ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
            "${sudo_prefix}cat \"${cert_dir}/.applied-fullchain.sha256\" 2>/dev/null"); then
        applied_hash=""
    fi
    applied_hash=$(printf '%s' "$applied_hash" | tr -d '[:space:]')
    if ! remote_hash=$(ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
            "${sudo_prefix}sha256sum \"${cert_dir}/fullchain.pem\" 2>/dev/null | cut -d' ' -f1"); then
        remote_hash=""
    fi
    remote_hash=$(printf '%s' "$remote_hash" | tr -d '[:space:]')
    if ! remote_key_hash=$(ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
            "${sudo_prefix}sha256sum \"${cert_dir}/privkey.pem\" 2>/dev/null | cut -d' ' -f1"); then
        remote_key_hash=""
    fi
    remote_key_hash=$(printf '%s' "$remote_key_hash" | tr -d '[:space:]')
    if [[ -n "$applied_hash" && "$applied_hash" == "$local_hash" \
          && "$remote_hash" == "$local_hash" && "$remote_key_hash" == "$local_key_hash" ]]; then
        write_target_metric "$host" 1
        echo "unchanged: ${host}"
        return
    fi

    # Stage into a per-run, 0700 mktemp dir under /tmp on the target
    # instead of scp-ing privkey.pem into world-readable /tmp directly —
    # avoids a window where the unencrypted wildcard key is readable by
    # every local user (TOCTOU + symlink-preplacement risk on multi-user
    # VMs).
    #
    # The dir is created+chmodded in a single ssh round-trip and
    # chowned to ${ssh_user} so the subsequent scp can write into it
    # without sudo. On ssh_no_sudo hosts (HAOS) ssh_user is already
    # root, so the chown is effectively a no-op. The final rm -rf
    # inside the install chain cleans up the stage dir under sudo so
    # neither files nor dir linger after the run.
    # Use `if ! stage=$(ssh ...); then ...` rather than a bare
    # assignment + post-check: under `set -euo pipefail` a non-zero exit
    # from the ssh (target down, key mismatch, etc.) would otherwise
    # kill the whole script BEFORE we reach the empty-string check,
    # aborting distribution to every later target instead of failing
    # this one and continuing.
    local stage
    if ! stage=$(ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
            "set -e; \
             d=\$(${sudo_prefix}mktemp -d /tmp/cert-stage.XXXXXX); \
             ${sudo_prefix}chmod 0700 \"\$d\"; \
             ${sudo_prefix}chown ${ssh_user}: \"\$d\"; \
             printf '%s' \"\$d\"") || [ -z "$stage" ]; then
        echo "FAIL: could not create staging dir on ${host}" >&2
        write_target_metric "$host" 0
        ANY_FAIL=1
        return
    fi

    if ! scp -P "$ssh_port" "${SCP_OPTS[@]}" \
            "$FULLCHAIN_SRC" "$PRIVKEY_SRC" \
            "${ssh_user}@${ip}:${stage}/"; then
        echo "FAIL: scp to ${host} failed" >&2
        # Best-effort cleanup; ignore rc since the dir may not exist.
        ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
            "${sudo_prefix}rm -rf \"${stage}\"" 2>/dev/null || true
        write_target_metric "$host" 0
        ANY_FAIL=1
        return
    fi

    # Chain mv + chown + chmod + reload with && so any step failure
    # short-circuits the remote shell and surfaces a non-zero exit
    # (a `;` chain would let the reload run against a broken cert pair
    # after a partial mv).
    #
    # The reload step does NOT prepend sudo_prefix. Some restart_command
    # values are compound shell constructs (e.g. an `if … then … else …
    # fi` for the conditional tlshd reload), and `sudo if …` is invalid
    # — sudo expects an executable, not a shell keyword. Each target's
    # restart_command in cert_distribution_targets is responsible for
    # invoking sudo itself where the underlying command needs root.
    # Quote path expansions in the remote command so a future inventory
    # value with a space (or shell-special char) doesn't word-split the
    # mv/chown/chmod/rm arguments.
    if ! ssh -p "$ssh_port" "${SSH_OPTS[@]}" \
            "${ssh_user}@${ip}" \
            "${sudo_prefix}mv \"${stage}/fullchain.pem\" \"${stage}/privkey.pem\" \"${cert_dir}/\" \
             && ${sudo_prefix}chown \"${owner}:${group}\" \"${cert_dir}/fullchain.pem\" \"${cert_dir}/privkey.pem\" \
             && ${sudo_prefix}chmod \"${cert_mode}\" \"${cert_dir}/fullchain.pem\" \
             && ${sudo_prefix}chmod \"${key_mode}\" \"${cert_dir}/privkey.pem\" \
             && ${sudo_prefix}rm -rf \"${stage}\" \
             && ${reload_cmd} \
             && printf '%s' '${local_hash}' | ${sudo_prefix}tee \"${cert_dir}/.applied-fullchain.sha256\" >/dev/null"; then
        echo "FAIL: remote install/reload on ${host} failed" >&2
        # Best-effort cleanup if the mv failed mid-step.
        ssh -p "$ssh_port" "${SSH_OPTS[@]}" "${ssh_user}@${ip}" \
            "${sudo_prefix}rm -rf \"${stage}\"" 2>/dev/null || true
        write_target_metric "$host" 0
        ANY_FAIL=1
        return
    fi

    write_target_metric "$host" 1
    echo "OK: ${host}"
}

{% for target in cert_distribution_targets %}
{# Per-target overrides documented in host_vars/dns-01.yml. Defaults
   apply when the field is unset.

   _reload: when restart_command is provided, it is rendered verbatim
   (the script no longer prepends sudo because compound shell forms
   like `if … then … fi` reject `sudo if`). When restart_service is
   used instead, the shorthand expansion injects sudo automatically
   for sudo-capable hosts. #}
{% set _sudo = '' if (target.ssh_no_sudo | default(false)) else 'sudo ' %}
{% set _reload = target.restart_command | default(_sudo ~ 'systemctl restart ' ~ (target.restart_service | default(''))) %}
{% set _ssh_port = target.ssh_port | default(22) %}
{% set _ssh_user = target.ssh_user | default('eric') %}
{% if target.ssh_no_sudo | default(false) %}
push_target_legacy \
    "{{ target.host }}" \
    "${{"{"}}{{ target.host | upper | replace('-', '_') }}_IP{{"}"}}" \
    "${{"{"}}{{ target.host | upper | replace('-', '_') }}_CERT_DIR{{"}"}}" \
    "{{ _ssh_user }}" \
    "{{ _ssh_port }}" \
    "{{ _sudo }}" \
    "{{ target.owner }}" \
    "{{ target.group }}" \
    "{{ target.cert_mode }}" \
    "{{ target.key_mode }}" \
    "{{ _reload }}"
{% else %}
push_target_receiver \
    "{{ target.host }}" \
    "${{"{"}}{{ target.host | upper | replace('-', '_') }}_IP{{"}"}}" \
    "{{ _ssh_user }}" \
    "{{ _ssh_port }}"
{% endif %}

{% endfor %}

# Local: restart AdGuard on dns-01 last, so a local AdGuard config
# regression doesn't abort distribution to remote hosts. Skip the restart
# when the local cert is unchanged from the one AdGuard last loaded — the
# proactive Ansible path runs this script on every deploy. Verify the installed
# fullchain AND privkey are present (and the hash non-empty) before skipping,
# mirroring the remote-target guard: a deleted/unreadable local cert or key must
# restart AdGuard to self-heal, not be silently treated as unchanged.
LOCAL_APPLIED_HASH_FILE="{{ local_cert_dir }}/.applied-fullchain.sha256"
_local_hash=$(sha256sum "$FULLCHAIN_SRC" 2>/dev/null | cut -d' ' -f1)
if [[ -r "$LOCAL_APPLIED_HASH_FILE" && -r "$FULLCHAIN_SRC" && -r "$PRIVKEY_SRC" && -n "$_local_hash" \
      && "$(cat "$LOCAL_APPLIED_HASH_FILE")" == "$_local_hash" ]]; then
    echo "unchanged: dns-01 (local AdGuard)"
    write_target_metric "dns-01" 1
elif systemctl restart AdGuardHome; then
    printf '%s\n' "$_local_hash" > "$LOCAL_APPLIED_HASH_FILE" 2>/dev/null || true
    write_target_metric "dns-01" 1
else
    echo "FAIL: local AdGuardHome restart failed" >&2
    write_target_metric "dns-01" 0
    ANY_FAIL=1
fi

flush_target_metrics

if [ "$ANY_FAIL" -ne 0 ]; then
    echo "Certificate distribution finished with one or more failed targets." >&2
    # Distinct exit code so callers can tell partial-target failure (this
    # path) from a hard local error (exit 1, e.g. cert files unreadable).
    # Per-target metrics in $PROM_TARGET_FILE name the offending host(s).
    exit 2
fi

echo "Certificate distribution complete."

# Write run-level success metric.
_CERT_END_TS="$(date +%s)"
_CERT_DURATION=$(( _CERT_END_TS - _CERT_START_TS ))
write_prom_metrics 1 "$_CERT_DURATION"
