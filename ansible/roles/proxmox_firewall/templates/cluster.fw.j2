# {{ ansible_managed }}
# Proxmox VE Cluster Firewall Configuration

[OPTIONS]

enable: 1
policy_in: DROP
policy_out: ACCEPT

[ALIASES]

{% for alias in pve_firewall_aliases | default([]) %}
{{ alias.name }} {{ alias.cidr }}{% if alias.comment is defined %} # {{ alias.comment }}{% endif %}

{% endfor %}

[IPSET admin_lan]

# Admin LAN network
192.168.0.0/24

[IPSET admin_ts]

# Admin Tailscale network
100.64.0.0/10

{% include 'ipsets.j2' %}

[IPSET smb_clients]

# Hosts allowed SMB access (entire LAN)
192.168.0.0/24

[group sg-dns]

# DoT (DNS over TLS)
IN ACCEPT -source +dc/admin_ts -p udp -dport 853 -log nolog
IN ACCEPT -source +dc/admin_lan -p udp -dport 853 -log nolog
IN ACCEPT -source +dc/admin_ts -p tcp -dport 853 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 853 -log nolog
# AdGuard Home Web UI
IN ACCEPT -source +dc/admin_ts -p tcp -dport 3000 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 3000 -log nolog
# Standard DNS
IN ACCEPT -source +dc/admin_ts -p tcp -dport 53 -log nolog
IN ACCEPT -source +dc/admin_ts -p udp -dport 53 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 53 -log nolog
IN ACCEPT -source +dc/admin_lan -p udp -dport 53 -log nolog

[group sg-gitlab]

# GitLab Web — Traefik now connects to nginx on 443 with the
# distributed wildcard cert (gitlab role: gitlab_nginx_listen_https=true).
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 443 -log nolog
IN ACCEPT -source +dc/admin_ts -p tcp -dport 443 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 443 -log nolog
# Port 80 — Omnibus nginx still listens on it for HTTP->HTTPS redirect
# of clients that arrive on the plain port. Allow only from admin
# sources (LAN/Tailscale); k3s_nodes no longer uses port 80 since
# Traefik connects directly to 443.
IN ACCEPT -source +dc/admin_ts -p tcp -dport 80 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 80 -log nolog
# GitLab Container Registry (port 5050, routed via Traefik)
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 5050 -log nolog
# GitLab Pages (pages_nginx TLS on 8443, routed via Traefik)
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 8443 -log nolog
# GitLab SSH (Git protocol on port 2222) - INTENTIONALLY open to WAN for external Git access
# Security: Protected by fail2ban (gitlab-ssh jail) with aggressive sshd filter
# Monitoring: SSH auth failures logged to systemd journal, banned after 5 failures for 1 hour
IN ACCEPT -p tcp -dport 2222 -log nolog
# GitLab SSH (Git protocol on port 22 for internal LAN access)
IN ACCEPT -source +dc/admin_ts -p tcp -dport 22 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 22 -log nolog

[group sg-haos]

IN ACCEPT -source +dc/admin_lan -p udp -dport 1900 -log nolog
IN ACCEPT -source +dc/admin_lan -p udp -dport 5353 -log nolog
IN ACCEPT -source +dc/admin_ts -p tcp -dport 8123 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 8123 -log nolog
# SSH add-on (port 22222)
IN ACCEPT -source +dc/admin_ts -p tcp -dport 22222 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 22222 -log nolog
# ICMP from admin sources for ping/traceroute during triage; see
# docs/11-firewall.md (2026-06-10 conntrack incident).
IN ACCEPT -source +dc/admin_ts -p icmp -log nolog
IN ACCEPT -source +dc/admin_lan -p icmp -log nolog

[group sg-host-admin]

IN ACCEPT -source +dc/admin_ts -p tcp -dport 8006 -log nolog # Proxmox
IN ACCEPT -source +dc/admin_lan -p tcp -dport 8006 -log nolog # Proxmox
IN ACCEPT -source +dc/admin_ts -p tcp -dport 22 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 22 -log nolog
IN ACCEPT -source +dc/admin_ts -p icmp -log nolog
IN ACCEPT -source +dc/admin_lan -p icmp -log nolog

[group sg-vm-admin]

IN ACCEPT -source +dc/admin_ts -p tcp -dport 22 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 22 -log nolog
IN ACCEPT -source +dc/admin_ts -p icmp -log nolog
IN ACCEPT -source +dc/admin_lan -p icmp -log nolog

[group sg-k3s-core]

IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 2379:2380 -log nolog
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 10250 -log nolog
# Flannel wireguard-native backend (pod-to-pod encrypted). Migrated
# 2026-06-11; the VXLAN/8472 rollback rule was removed once every node
# carried flannel-wg and stale vxlan routes were cleaned.
IN ACCEPT -source +dc/k3s_nodes -p udp -dport 51820 -log nolog
# MetalLB speaker memberlist (L2 leader election between speakers)
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 7946 -log nolog
IN ACCEPT -source +dc/k3s_nodes -p udp -dport 7946 -log nolog
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 9345 -log nolog
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 6443 -log nolog
IN ACCEPT -source +dc/admin_ts -p tcp -dport 6443 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 6443 -log nolog

[group sg-k3s-ingress-int]

IN ACCEPT -source +dc/admin_ts -p tcp -dport 443 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 443 -log nolog
IN ACCEPT -source +dc/admin_ts -p tcp -dport 80 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 80 -log nolog

[group sg-k3s-ingress-pub]

IN ACCEPT -p tcp -dport 443 -log nolog
IN ACCEPT -p tcp -dport 80 -log nolog

[group sg-nfs-server]

IN ACCEPT -source +dc/nfs_clients -p udp -dport 111 -log nolog
IN ACCEPT -source +dc/nfs_clients -p tcp -dport 111 -log nolog
IN ACCEPT -source +dc/nfs_clients -p tcp -dport 2049 -log nolog

[group sg-plex]

# DLNA/GDM discovery + companion ports stay LAN-only (no remote use case).
IN ACCEPT -source +dc/admin_lan -p tcp -dport 32469 -log nolog
IN ACCEPT -source +dc/admin_lan -p udp -dport 32410:32414 -log nolog
IN ACCEPT -source +dc/admin_lan -p udp -dport 1900 -log nolog
# Plex media port 32400 - INTENTIONALLY open to WAN for direct remote streaming.
# Accepted risk: the router forwards 32400/tcp -> 192.168.0.152 (docs/20 §4) so
# remote clients stream directly instead of via the bandwidth-limited plex.tv
# relay. Plex authenticates every remote session against plex.tv before serving
# media, so this is an authenticated endpoint, not an open share. Restricting the
# source here would force all remote playback through the relay (degraded quality)
# or require a per-client VPN. Revisit if direct remote access is dropped.
IN ACCEPT -p tcp -dport 32400 -log nolog

[group sg-metrics]

# Prometheus scraping from k3s cluster (k3s SNATs pod traffic to node IPs)
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 9100 -log nolog  # node-exporter
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 9101 -log nolog  # node-exporter-host (bare metal)
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 9134 -log nolog  # zfs-exporter
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 9167 -log nolog  # unbound-exporter
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 8123 -log nolog  # home-assistant
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 32400 -log nolog # plex
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 3000 -log nolog  # adguard API
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 7472 -log nolog  # metallb speaker
IN ACCEPT -source +dc/k3s_nodes -p tcp -dport 7473 -log nolog  # metallb controller
IN ACCEPT -source +dc/core-cluster -p tcp -dport 31100 -log nolog  # loki push (NodePort, host→k8s)

[group sg-pve-cluster]

# Proxmox auto-permits intra-cluster traffic via a built-in macro, so this
# group is belt-and-suspenders.
IN ACCEPT -source +dc/pve_hosts -p tcp -dport 8006 -log nolog
IN ACCEPT -source +dc/pve_hosts -p tcp -dport 60000:60050 -log nolog
IN ACCEPT -source +dc/pve_hosts -p tcp -dport 22 -log nolog
# corosync totem ring UDP ports: 5405 = ring0 (single-ring default), 5406 =
# ring1 (reserved for a future second knet link). If the knet ring layout
# changes (confirm with `corosync-cmapctl | grep mcastport`), update to match.
IN ACCEPT -source +dc/pve_hosts -p udp -dport 5406 -log nolog
IN ACCEPT -source +dc/pve_hosts -p udp -dport 5405 -log nolog

[group sg-smb-server]

IN ACCEPT -source +dc/smb_clients -p tcp -dport 445 -log nolog

[group sg-smtp-relay]

# SMTP submission from core cluster
IN ACCEPT -source +dc/core-cluster -p tcp -dport 587 -log nolog
# SMTP relay from core cluster
IN ACCEPT -source +dc/core-cluster -p tcp -dport 25 -log nolog
# Outbound DNS and SMTP (for upstream relay to Gmail)
OUT ACCEPT -p udp -dport 853 -log nolog
OUT ACCEPT -p tcp -dport 853 -log nolog
OUT ACCEPT -p udp -dport 53 -log nolog
OUT ACCEPT -p tcp -dport 53 -log nolog
OUT ACCEPT -p tcp -dport 587 -log nolog

[group sg-windows]

IN ACCEPT -source +dc/admin_ts -p tcp -dport 3389 -log nolog
IN ACCEPT -source +dc/admin_lan -p tcp -dport 3389 -log nolog

[RULES]

{% for rule in pve_firewall_cluster_rules | default([]) %}
{{ rule }}
{% endfor %}
