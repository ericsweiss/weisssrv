# {{ ansible_managed }}
# Proxmox VE Node Firewall Configuration for {{ inventory_hostname }}

[OPTIONS]

enable: 1
log_level_in: nolog
log_level_out: nolog

[RULES]

{% for rule in pve_firewall_host_rules | default([]) %}
{{ rule }}
{% endfor %}

# All Proxmox hosts need cluster communication and admin access
GROUP sg-pve-cluster
GROUP sg-host-admin
GROUP sg-metrics

{# Exact match (not substring): only proxmox_role == 'nas' inherits the NFS/SMB
   server groups, so a future role string that merely contains 'nas' (e.g.
   'nas-backup') does not erroneously expose those server ports. #}
{% if (proxmox_role | default('')) == 'nas' %}
# NAS-specific rules
GROUP sg-nfs-server
GROUP sg-smb-server
{% endif %}
