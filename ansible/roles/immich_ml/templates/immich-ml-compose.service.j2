# {{ ansible_managed }}
[Unit]
Description=Immich machine learning (docker compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory={{ immich_ml_compose_dir }}
# `up -d` reconciles the running stack to the rendered compose, recreating
# only the containers whose definition changed.
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecReload=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
