#!/usr/bin/env bash
# {{ ansible_managed }}
# One-time post-reboot finalization of a DEFERRED encrypted-swap activation,
# INCLUDING recovery from the boot race: the retained plaintext fstab fallback
# and systemd-cryptsetup@ both want the same backing LV at boot, and either can
# win. Run after swap.target (both contenders have been attempted):
#   - mapper ACTIVE as swap  -> drop the plaintext fallback (finalize).
#   - mapper NOT active      -> the plaintext line won the race (cryptsetup
#     open failed on the busy LV). Boot-time is the SAFE moment to fix that:
#     memory is empty, so swapoff of the plaintext device cannot OOM anything.
#     Complete the switch here (swapoff dev -> open mapper -> swapon mapper),
#     verify, THEN finalize. Any failure keeps the plaintext fallback and
#     exits green — the host must never end up swapless; NASSwapGone /
#     deploy-verification surface a persistently unactivated mapper.
# Idempotent: a no-op once the plaintext line is already commented.
set -uo pipefail

dev="{{ encrypted_swap_source_device }}"
mapper_name="{{ encrypted_swap_mapper_name }}"
mapper="/dev/mapper/${mapper_name}"

# /proc/swaps lists a dm device by its RESOLVED kernel name (/dev/dm-N), NOT the
# /dev/mapper/<name> symlink — so match on both the symlink and its readlink -f
# target. Matching only the /dev/mapper path silently never sees an active mapper
# (it always reads as "not active"), which would make this script wrongly enter
# its boot-race recovery arm on every boot. If the mapper node does not exist yet,
# readlink yields nothing and the mapper is (correctly) reported inactive.
mapper_active() {
  local real
  real="$(readlink -f "$mapper" 2>/dev/null)"
  awk -v m="$mapper" -v r="$real" \
    '$1 == m || (r != "" && $1 == r) { found=1 } END { exit !found }' /proc/swaps
}

if ! mapper_active; then
  # Recovery arm — only meaningful while the deferred plaintext line still
  # exists uncommented (otherwise there is nothing to race against).
  if ! grep -Eq "^${dev}[[:space:]]+[^[:space:]]+[[:space:]]+swap[[:space:]]" /etc/fstab; then
    echo "encrypted-swap-finalize: ${mapper} not active and no plaintext fallback line — nothing to do" >&2
    exit 0
  fi
  echo "encrypted-swap-finalize: ${mapper} not active (plaintext won the boot race) — attempting boot-time switch" >&2
  if ! swapoff "$dev" 2>/dev/null; then
    echo "encrypted-swap-finalize: swapoff ${dev} failed; keeping plaintext fallback" >&2
    exit 0
  fi
  if ! systemctl start "systemd-cryptsetup@${mapper_name}.service"; then
    echo "encrypted-swap-finalize: cryptsetup open failed; restoring plaintext fallback" >&2
    swapon -a || true
    exit 0
  fi
  if ! swapon "$mapper"; then
    echo "encrypted-swap-finalize: swapon ${mapper} failed; restoring plaintext fallback" >&2
    swapoff "$mapper" >/dev/null 2>&1 || true
    systemctl stop "systemd-cryptsetup@${mapper_name}.service" >/dev/null 2>&1 || true
    swapon -a || true
    exit 0
  fi
  if ! mapper_active; then
    echo "encrypted-swap-finalize: ${mapper} still not active after switch; restoring plaintext fallback" >&2
    swapoff "$mapper" >/dev/null 2>&1 || true
    systemctl stop "systemd-cryptsetup@${mapper_name}.service" >/dev/null 2>&1 || true
    swapon -a || true
    exit 0
  fi
  echo "encrypted-swap-finalize: boot-time switch complete (${mapper} active)" >&2
fi

# Mapper is ACTIVE as swap: safe to drop the plaintext fallback.
# Best-effort: the backing device is normally busy (held by the mapper) so this
# swapoff is a no-op; it only matters in exotic double-active states.
swapoff "$dev" 2>/dev/null || true

# Comment the plaintext swap fstab line exactly once. Matches only an UNcommented
# "<dev> <mnt> swap ..." line (the commented form no longer starts with the
# device), so re-runs are no-ops. The device path is a fixed LVM path with no
# regex metacharacters, and '#' is the sed delimiter (so its slashes are literal).
sed -ri "s#^(${dev}[[:space:]]+[^[:space:]]+[[:space:]]+swap[[:space:]].*)#\# \1#" /etc/fstab
