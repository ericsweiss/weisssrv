# {{ ansible_managed }}
[Unit]
Description=Finalize deferred encrypted-swap activation (drop plaintext backing swap)
# After swap.target so both boot-race contenders (the plaintext fstab line and
# systemd-cryptsetup@) have been attempted before we act. NO mapper-exists
# condition: the script's recovery arm must run precisely when cryptsetup LOST
# the race (mapper absent) to complete the switch at boot; it gates itself on
# the crypttab entry below and always keeps a working swap on any failure.
ConditionPathExists=/etc/crypttab
After=swap.target systemd-cryptsetup@{{ encrypted_swap_mapper_name }}.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/encrypted-swap-finalize.sh

[Install]
WantedBy=multi-user.target
