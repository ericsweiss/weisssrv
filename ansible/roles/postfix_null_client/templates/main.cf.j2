# {{ ansible_managed }}
# Postfix null client configuration - forwards all mail to relay

smtpd_banner = $myhostname ESMTP $mail_name (Debian/GNU)
biff = no

# Append .domain is the MUA's job
append_dot_mydomain = no

myhostname = {{ postfix_config.myhostname }}
myorigin = {{ postfix_config.myorigin }}
mydestination = {{ postfix_config.mydestination }}
relayhost = {{ postfix_config.relayhost }}
mynetworks = {{ postfix_config.mynetworks }}
inet_interfaces = {{ postfix_config.inet_interfaces }}
recipient_delimiter = +

# TLS parameters
smtp_tls_security_level = {{ postfix_config.smtp_tls_security_level }}
smtp_tls_CAfile = {{ postfix_config.smtp_tls_CAfile }}

# SASL authentication
smtp_sasl_auth_enable = {{ postfix_config.smtp_sasl_auth_enable }}
smtp_sasl_security_options = {{ postfix_config.smtp_sasl_security_options }}
smtp_sasl_password_maps = {{ postfix_config.smtp_sasl_password_maps }}

# Aliases and virtual mappings
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
{% if postfix_virtual_aliases is defined %}
virtual_alias_maps = hash:/etc/postfix/virtual
{% endif %}

compatibility_level = 3.6
