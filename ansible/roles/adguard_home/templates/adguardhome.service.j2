# {{ ansible_managed }}
[Unit]
Description=AdGuard Home: Network-level blocker
ConditionFileIsExecutable={{ adguard_install_path }}/AdGuardHome
After=syslog.target network-online.target

[Service]
User={{ adguard_user }}
Group={{ adguard_group }}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

StartLimitInterval=5
StartLimitBurst=10

ExecStart={{ adguard_install_path }}/AdGuardHome "-s" "run"

NoNewPrivileges=true
{% if adguard_use_private_tmp | default(true) %}
PrivateTmp=true
{% else %}
# PrivateTmp disabled for Docker container compatibility
PrivateTmp=false
{% endif %}
ProtectHome=true
{% if adguard_use_protect_system | default(true) %}
ProtectSystem=strict
{% else %}
# ProtectSystem disabled for Docker container compatibility
ProtectSystem=false
{% endif %}
ReadWritePaths={{ adguard_install_path }}

WorkingDirectory={{ adguard_install_path }}

StandardOutput=journal
StandardError=journal

Restart=always
RestartSec=10
EnvironmentFile=-/etc/sysconfig/AdGuardHome

[Install]
WantedBy=multi-user.target
