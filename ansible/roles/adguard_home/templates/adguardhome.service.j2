# {{ ansible_managed }}
[Unit]
Description=AdGuard Home: Network-level blocker
ConditionFileIsExecutable={{ adguard_install_path }}/AdGuardHome
# unbound is the sole upstream (127.0.0.1:5335); order after it so AdGuard
# doesn't SERVFAIL during boot. Wants= tolerates hosts without the unit.
After=network-online.target unbound.service
Wants=network-online.target unbound.service

# systemd honors the start-rate limit only in [Unit]; in [Service] it is
# ignored (logged as a warning). With RestartSec=10 below, allow up to 5
# restarts in a 5-minute window before systemd gives up (crash-loop guard).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User={{ adguard_user }}
Group={{ adguard_group }}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

ExecStart={{ adguard_install_path }}/AdGuardHome "-s" "run"

NoNewPrivileges=true
{% if adguard_use_private_tmp | default(true) %}
PrivateTmp=true
{% else %}
# PrivateTmp disabled for Docker container compatibility
PrivateTmp=false
{% endif %}
ProtectHome=true
{% if adguard_use_protect_system | default(true) %}
ProtectSystem=strict
{% else %}
# ProtectSystem disabled for Docker container compatibility
ProtectSystem=false
{% endif %}
ReadWritePaths={{ adguard_install_path }}

WorkingDirectory={{ adguard_install_path }}

StandardOutput=journal
StandardError=journal

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
