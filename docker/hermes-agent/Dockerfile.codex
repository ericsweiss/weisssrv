# Thin wrapper over the upstream-built Hermes Agent image, baking in the three
# CLIs Hermes shells out to. Why each is here: README.md.
#
# The base already ships Node 22 + npm and ends on `USER root`, so `npm i -g`
# lands in /usr/local without a permission dance; ENTRYPOINT/CMD/ENV/WORKDIR/USER
# are all inherited.
ARG HERMES_IMAGE
FROM ${HERMES_IMAGE}

# Pinned in ansible/inventories/prod/group_vars/all.yml as hermes_codex_version /
# hermes_claude_version / hermes_op_version; passed through by the
# build-hermes-agent CI job.
ARG HERMES_CODEX_VERSION
ARG HERMES_CLAUDE_VERSION
ARG HERMES_OP_VERSION

# Fail loudly if a future base drops Node/npm; verify each CLI resolves on PATH.
RUN command -v node >/dev/null 2>&1 || { echo "node not found in base image"; exit 1; } \
    && command -v npm  >/dev/null 2>&1 || { echo "npm not found in base image";  exit 1; } \
    && npm install -g --no-audit --no-fund \
         "@openai/codex@${HERMES_CODEX_VERSION}" \
         "@anthropic-ai/claude-code@${HERMES_CLAUDE_VERSION}" \
    && npm cache clean --force \
    && codex --version \
    && claude --version

# `op` is invoked through Hermes' TERMINAL tool, which preserves
# OP_SERVICE_ACCOUNT_TOKEN in the subprocess env — the code_execution tool
# strips any *TOKEN* var by substring. docs/37 §1Password.
#
# SUPPLY-CHAIN PIN: TLS does not prove the signing key is authentic, so the
# fingerprint is checked before the key is trusted — same constant as
# weisssrv-lib's `.install-1password` fragment, which documents re-deriving it.
# EVERY primary (pub) fingerprint is collected, because `gpg --dearmor` trusts
# every key in the file and `--with-colons` also emits fpr: records for subkeys.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    arch="$(dpkg --print-architecture)"; \
    op_key_fpr="3FEF9748469ADBE15DA7CA80AC2D62742012EA22"; \
    op_key="$(mktemp)"; \
    curl -fsSL https://downloads.1password.com/linux/keys/1password.asc -o "$op_key"; \
    got_fprs="$(gpg --show-keys --with-fingerprint --with-colons "$op_key" \
      | awk -F: '/^pub:/ {p=1; next} /^fpr:/ && p {print $10; p=0}')"; \
    if [ "$got_fprs" != "$op_key_fpr" ]; then \
      echo "ERROR: 1Password apt key material did not verify. Expected exactly:" >&2; \
      echo "  $op_key_fpr" >&2; \
      echo "Got:" >&2; \
      echo "$got_fprs" | sed 's/^/  /' >&2; \
      rm -f "$op_key"; \
      exit 1; \
    fi; \
    gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg < "$op_key"; \
    rm -f "$op_key"; \
    printf 'deb [arch=%s signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/%s stable main\n' "$arch" "$arch" \
      > /etc/apt/sources.list.d/1password.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends "1password-cli=${HERMES_OP_VERSION}"; \
    rm -rf /var/lib/apt/lists/*; \
    op --version
