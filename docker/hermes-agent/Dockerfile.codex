# Thin wrapper over the upstream-built Hermes Agent image that bakes in the two
# subscription-billed coding CLIs Hermes relies on:
#   * OpenAI Codex CLI — Hermes' Codex runtime delegates OpenAI/Codex turns to
#     the `codex` CLI (ChatGPT-subscription OAuth via `codex login` — no API
#     billing), and `codex mcp-server` doubles as a coding-task delegate.
#   * Claude Code CLI — Hermes delegates coding tasks to headless `claude -p`
#     runs via its terminal tool / bundled claude-code skill (Claude Max
#     subscription via a `claude setup-token` OAuth token in
#     CLAUDE_CODE_OAUTH_TOKEN — the CLI holds the credential; no API billing).
# Upstream ships neither CLI, so build-hermes-agent (.gitlab-ci.yml) builds the
# upstream Dockerfile first, then this wrapper as the FINAL published image
# (tagged :<hermes_version> / :<sha> / :latest exactly as before).
#
# The base already bundles Node 22 LTS + npm at /usr/local/bin (its multi-stage
# build copies them from node:22-bookworm-slim), so we only add the pinned CLI.
# It also ends on `USER root` (s6-overlay's /init needs root to remap the hermes
# user to HERMES_UID/GID, then drops privileges), so `npm i -g` here installs to
# /usr/local (on PATH) without a permission dance and the runtime user model is
# unchanged — ENTRYPOINT/CMD/ENV/WORKDIR/USER are all inherited from the base.
ARG HERMES_IMAGE
FROM ${HERMES_IMAGE}

# Pinned in ansible/inventories/prod/group_vars/all.yml as hermes_codex_version /
# hermes_claude_version / hermes_op_version; passed through by the
# build-hermes-agent CI job.
ARG HERMES_CODEX_VERSION
ARG HERMES_CLAUDE_VERSION
ARG HERMES_OP_VERSION

# Fail loudly if Node/npm somehow isn't present (a future upstream base change),
# install both pinned CLIs globally, and verify each binary resolves on PATH.
RUN command -v node >/dev/null 2>&1 || { echo "node not found in base image"; exit 1; } \
    && command -v npm  >/dev/null 2>&1 || { echo "npm not found in base image";  exit 1; } \
    && npm install -g --no-audit --no-fund \
         "@openai/codex@${HERMES_CODEX_VERSION}" \
         "@anthropic-ai/claude-code@${HERMES_CLAUDE_VERSION}" \
    && npm cache clean --force \
    && codex --version \
    && claude --version

# Official 1Password CLI (op), pinned. Baked in so Hermes' first-party 1Password
# skill (upstream optional-skills/security/1password) can drive `op` against the
# ISOLATED Agent vault via a service-account token (OP_SERVICE_ACCOUNT_TOKEN,
# wired into the gateway container by kubernetes/apps/hermes/deployment.yaml).
# The base runs as root, so apt needs no sudo. Installed from 1Password's signed
# apt repo — the `signed-by` keyring verifies the repo Release signature — pinned
# to hermes_op_version (the full deb version string). `op` is a static Go binary;
# the agent invokes it through the TERMINAL tool, which preserves
# OP_SERVICE_ACCOUNT_TOKEN in the subprocess env (the code_execution tool strips
# any *TOKEN* var by substring, so the 1Password skill uses the terminal tool by
# design — see docs/37 §1Password).
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    arch="$(dpkg --print-architecture)"; \
    curl -fsSL https://downloads.1password.com/linux/keys/1password.asc \
      | gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg; \
    printf 'deb [arch=%s signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/%s stable main\n' "$arch" "$arch" \
      > /etc/apt/sources.list.d/1password.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends "1password-cli=${HERMES_OP_VERSION}"; \
    rm -rf /var/lib/apt/lists/*; \
    op --version
