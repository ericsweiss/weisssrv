---
# ansible-lint configuration for weisssrv homelab
# https://ansible.readthedocs.io/projects/lint/configuring/

# Must stay at the repo root: ansible-lint discovers this file by walking UP
# from its working directory, and both callers (CI and `task ansible:lint`) run
# from here over `ansible/`.

# Production profile: this is production infrastructure. The profile also
# selects WHICH rules run - without one, opt-in rules such as run-once[task]
# fire on every deliberate `run_once:`.
profile: production

# Exclude paths (for third-party code, generated files, etc.), relative to the
# repository root.
exclude_paths:
  - .cache/
  - .github/
  - venv/
  - .venv/
  # ansible-galaxy install targets for weisssrv.infra - the library lints itself
  # upstream.
  - .ansible-home/
  - ansible_collections/
  - ansible/ansible_collections/

# No skip_list: var-naming[no-role-prefix] fires only from inside a role, and
# this repository owns none. Add the skip if an `ansible/roles/` tree appears.

offline: false
