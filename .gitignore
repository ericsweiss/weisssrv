# OS
.DS_Store
Thumbs.db

# IDEs / AI tooling
.idea/
.vscode/
.claude/
.remember/
*.swp
*.swo
*~

# Secrets - NEVER COMMIT
*.key
*.pem
**/secrets/
**/*secret*
**/*password*
.env
.env.*
sasl_passwd
sasl_passwd.db
# Exception: External Secrets Operator manifests reference secrets but are not
# themselves secret values. Flux/kustomize structural files with "secret" in
# their path or name are safe to commit. Actual secret VALUES go through ESO
# (ExternalSecret CRs reference 1Password) and never appear in git.
!kubernetes/infrastructure/sources/external-secrets.yaml
!kubernetes/infrastructure/controllers/external-secrets
!kubernetes/infrastructure/controllers/external-secrets/**
!kubernetes/infrastructure/configs/cluster-secret-store.yaml
# Planned: Flux Receiver manifest for webhook-triggered reconciliation
!kubernetes/infrastructure/configs/flux-webhook-secret.yaml
!kubernetes/infrastructure/configs/shared-cloudflare-secrets
!kubernetes/infrastructure/configs/shared-cloudflare-secrets/**
!kubernetes/apps/**/externalsecret*.yaml
!kubernetes/apps/**/externalsecrets.yaml
!kubernetes/infrastructure/**/externalsecret*.yaml
!kubernetes/clusters/weisssrv/tenants/**/cluster-secret-store.yaml
!kubernetes/clusters/weisssrv/tenants/**/secret-store.yaml
# Jinja2 template with op:// refs, not actual secrets
!ansible/roles/home_assistant/templates/secrets.yaml.j2

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Ansible
*.retry
ansible/inventories/*/host_vars/*/vault.yml
ansible/inventories/*/group_vars/*/vault.yml
.ansible/

# Python
__pycache__/
.pycache/
*.py[cod]
*$py.class
.Python
venv/
.venv/
.review-venv/
.tmp-ci-venv/
.tmp-lint-venv/
.pytest_cache/

# State collection outputs (generated by task collect-state, not tracked)
cluster-state-*.txt
CLUSTER_STATUS.txt

# Version check cache
.version-cache/

# Temporary files
*.tmp
*.temp
*.log
tmp/
temp/
.tmp/

# Kubernetes
kubeconfig
*.kubeconfig
