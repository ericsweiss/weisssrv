# OS
.DS_Store
Thumbs.db

# IDEs / AI tooling
.idea/
.vscode/
# Ignore everything under .claude/ (personal overrides, caches, worktrees the
# tooling may create) EXCEPT the shared, committed guardrails: settings.json and
# the checked-in skills/ (the weisssrv-development agent skill).
# `.claude/*` (not `.claude/`) so the negations can re-include specific paths.
.claude/*
!.claude/settings.json
!.claude/skills/
.remember/
*.swp
*.swo
*~

# Git worktrees (multi-branch local working dirs)
.worktrees/

# Secrets - NEVER COMMIT
# Ignore secret VALUE artifacts by type / known filename only. We deliberately
# do NOT ignore every path containing "secret"/"password": that pattern
# silently dropped GitOps manifests (ExternalSecret CRs, onepassword-connect-*
# files) from `git add` and forced a hand-maintained un-ignore list. Actual
# secret VALUES never live in git — ESO produces them in-cluster from 1Password
# — so only their generated artifacts are listed here. The gitleaks
# secret_detection job (.gitleaks.toml) is the content-level backstop.
*.key
*.pem
**/secrets/
.env
.env.*
sasl_passwd
sasl_passwd.db
# 1Password Connect bootstrap credentials (`op connect server create` output)
1password-credentials.json

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Ansible
*.retry
ansible/inventories/*/host_vars/*/vault.yml
ansible/inventories/*/group_vars/*/vault.yml
.ansible/
# ANSIBLE_HOME for the CI ansible-lint job and `task ansible:lint` — the
# weisssrv.infra collection installs under .ansible-home/collections.
.ansible-home/

# Python
__pycache__/
.pycache/
*.py[cod]
*$py.class
.Python
venv/
.venv/
.review-venv/
.tmp-ci-venv/
.tmp-lint-venv/
.pytest_cache/

# State collection outputs (generated by task collect-state, not tracked)
cluster-state-*.txt
CLUSTER_STATUS.txt

# Cursor pre-PR audit artifacts (operator-local, not durable repo docs)
docs/[3-9][0-9]-professional-repo-audit-*.md

# Version check cache
.version-cache/

# CI dependency/tool cache dirs (PIP_CACHE_DIR, collections, lint toolchains)
.cache/

# Temporary files
*.tmp
*.temp
*.log
tmp/
temp/
.tmp/

# Kubernetes
kubeconfig
*.kubeconfig

# Helm chart pull scratch (created by flux/helm validation runs)
.helm-tmp/
