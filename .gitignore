# OS
.DS_Store
Thumbs.db

# IDEs / AI tooling
.idea/
.vscode/
# Everything under .claude/ except the committed guardrails below.
# `.claude/*`, NOT `.claude/` — a directory pattern cannot be negated.
.claude/*
!.claude/settings.json
!.claude/skills/
.remember/
*.swp
*.swo
*~

# Git worktrees (multi-branch local working dirs)
.worktrees/

# Secrets - NEVER COMMIT
# List by artefact type or known filename, never a `*secret*` glob - that glob also
# hides ExternalSecret manifests. Real values live in-cluster (ESO); gitleaks backstops.
*.key
*.pem
**/secrets/
.env
.env.*
sasl_passwd
sasl_passwd.db
# 1Password Connect bootstrap credentials (`op connect server create` output)
1password-credentials.json

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
# A plan embeds every resolved variable, incl. OIDC client secrets. Both shapes:
# `-out=tfplan` writes a bare name `*.tfplan` misses. Gated by
# scripts/test_repo_hygiene.py.
*.tfplan
*.tfplan.json
tfplan
tfplan.json
plan.out
# Root-level so a .tfvars written outside terraform/ is ignored too.
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Ansible
*.retry
ansible/inventories/*/host_vars/*/vault.yml
ansible/inventories/*/group_vars/*/vault.yml
.ansible/
# ANSIBLE_HOME for the CI ansible-lint job and `task ansible:lint` — the
# weisssrv.infra collection installs under .ansible-home/collections.
.ansible-home/
# The other two galaxy install targets: ansible-lint auto-installs
# weisssrv.infra to whichever of these its caller's CWD resolves to.
ansible_collections/
ansible/ansible_collections/

# Python
__pycache__/
.pycache/
*.py[cod]
*$py.class
.Python
venv/
.venv/
.review-venv/
.tmp-ci-venv/
.tmp-lint-venv/
.pytest_cache/
.ruff_cache/
# coverage.py: local `coverage run` / pytest --cov output.
.coverage
.coverage.*
coverage.xml
htmlcov/

# State collection outputs (generated by task collect-state, not tracked)
cluster-state-*.txt
CLUSTER_STATUS.txt

# Cursor pre-PR audit artifacts (operator-local, not durable repo docs)
docs/[3-9][0-9]-professional-repo-audit-*.md

# Version check cache
.version-cache/

# weisssrv-lib checkout at the pinned ref (created by `task lib:sync`)
.weisssrv-lib/

# CI dependency/tool cache dirs (PIP_CACHE_DIR, collections, lint toolchains)
.cache/

# Temporary files
*.tmp
*.temp
*.log
tmp/
temp/
.tmp/

# Kubernetes
kubeconfig
*.kubeconfig
.kube/

# Helm chart pull scratch (created by flux/helm validation runs)
.helm-tmp/
