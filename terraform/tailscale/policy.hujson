// Tailnet policy for the weisssrv homelab — managed by terraform/tailscale.
// Rule-by-rule rationale, port table and the supervised apply runbook live in
// README.md. APPLY IS SUPERVISED: a wrong policy severs tailnet SSH.
{
  // Every acls/ssh rule sources from this group rather than autogroup:member, so
  // a non-owner device that joins the tailnet inherits zero access until it is
  // deliberately added here.
  "groups": {
    "group:admins": ["ericsweiss1@gmail.com"],
  },

  // Owners permitted to APPLY each tag. tag:k8s-operator is `[]` (tailnet
  // admins) so the owner can mint the operator OAuth client; tag:k8s must be
  // ownable by tag:k8s-operator or the operator cannot register its proxies.
  "tagOwners": {
    "tag:subnet-router": ["ericsweiss1@gmail.com"],
    "tag:k8s-operator": [],
    "tag:k8s": ["tag:k8s-operator"],
  },

  "acls": [
    // Rule 1 — owner devices -> the subnet-router hosts' own services on their
    // 100.x IP. 80/443/6443 are defensive; the host firewall gates them.
    {
      "action": "accept",
      "src": ["group:admins"],
      "dst": ["tag:subnet-router:22,80,443,6443,8006"],
    },

    // Rule 2 — owner devices -> the LAN via subnet routing. Ports are proto-agnostic
    // (tcp+udp, which DNS needs); ICMP is auto-allowed. Port-to-service list: README.md.
    {
      "action": "accept",
      "src": ["group:admins"],
      "dst": ["10.0.10.0/24:22,53,80,111,443,445,853,2049,2222,3000,3389,6443,8006,8123,22222,32400,32469"],
    },

    // Rule 3 — owner devices -> the owner's own UNTAGGED devices on SSH. This is
    // the network gate backing the ssh rule below (Tailscale requires both).
    {
      "action": "accept",
      "src": ["group:admins"],
      "dst": ["autogroup:self:22"],
    },

    // Rule 4 — owner devices -> the operator-exposed proxy devices: :443 the
    // traefik-tailnet ingress (mesh path to the internal web apps), :53 the
    // ts-dns split-horizon resolver Split-DNS forwards esweiss.com to.
    {
      "action": "accept",
      "src": ["group:admins"],
      "dst": ["tag:k8s:53,443"],
    },
  ],

  // Auto-approve the LAN route so subnet-router failover across the six hosts is
  // real. Tag-only: only devices carrying tag:subnet-router may self-approve it.
  "autoApprovers": {
    "routes": {
      "10.0.10.0/24": ["tag:subnet-router"],
    },
  },

  // Tailscale SSH. action "check" = periodic reauth. autogroup:self covers the
  // owner's untagged devices, tag:subnet-router the tagged Proxmox hosts. root is
  // dropped — connect as `eric`.
  "ssh": [
    {
      "action": "check",
      "src": ["group:admins"],
      "dst": ["autogroup:self", "tag:subnet-router"],
      "users": ["autogroup:nonroot"],
    },

    // Break-glass root SSH (if sudo breaks fleet-wide): README.md § Break-glass.
  ],
}
